          <string name="Name">GameClient</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX000078">
          <Properties>
            <string name="Name">AgentLab</string>
            <ProtectedString name="Source">--!nonstrict
local Theme=require(script.Parent.DeskTheme)
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Craft=require(Shared.AgentCrafting)
local Visual=require(script.Parent.CollectionStyle)
local Lab={};Lab.__index=Lab
local c=Theme.colors
local function contains(frame,point)
    local p,s=frame.AbsolutePosition,frame.AbsoluteSize
    return point.X&gt;=p.X and point.X&lt;p.X+s.X and point.Y&gt;=p.Y and point.Y&lt;p.Y+s.Y
end
function Lab.new(parent,balance,onCraft)
    local self=setmetatable({balance=balance,onCraft=onCraft,target=1,cards={},recipes={},seenReply=0},Lab)
    self.frame=Theme.create("Frame",parent,{Name="AgentLabPage",BackgroundColor3=Theme.pixelColors.base,
        BorderSizePixel=0,Active=true,Visible=false})
    Theme.pixelPanel(self.frame,"LabPanel",UDim2.fromOffset(0,0),UDim2.fromScale(1,1))
    self.backdrop=Theme.create("Frame",self.frame,{Name="LabBackdrop",BackgroundColor3=Color3.fromRGB(25,22,30),
        BorderSizePixel=0,Active=false,Selectable=false,ClipsDescendants=true,Size=UDim2.fromScale(1,1)})
    self.stripes={}
    for _=1,256 do
        local part=Visual.rect(self.backdrop,"StripePixel",0,0,1,1,Color3.fromRGB(32,26,37));part.BackgroundTransparency=.35
        self.stripes[#self.stripes+1]=part
    end
    self.titleBadge=Theme.pixelPanel(self.frame,"LabTab",UDim2.new(1,-180,0,8),UDim2.fromOffset(168,32),c.accent)
    self.titleBadge.ZIndex=3
    self.title,self.titleShadow=Visual.caption(self.frame,"AGENT LAB",14,c.terminal,UDim2.new(1,-180,0,8),UDim2.fromOffset(168,32))
    self.openCards,self.openCardsArt=Theme.pixelButton(self.frame,"CARDS &gt;",UDim2.fromOffset(12,8),UDim2.fromOffset(140,40),function(input)
        if self:canInteract(input,self.openCards) and self.onOpenCards then self.onOpenCards() end
    end)
    self.wallet=Theme.text(self.frame,"Connecting...",14,c.mint,UDim2.fromOffset(12,48),UDim2.new(1,-24,0,56))
    self.wallet.ZIndex=3;self.wallet.TextXAlignment=Enum.TextXAlignment.Center
    self.list=Theme.create("ScrollingFrame",self.frame,{Name="CraftingList",BackgroundTransparency=1,BorderSizePixel=0,
        ClipsDescendants=true,Position=UDim2.fromOffset(12,112),Size=UDim2.new(1,-24,1,-200),
        CanvasSize=UDim2.fromOffset(0,0),ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=5,ScrollBarImageColor3=Theme.pixelColors.edge,ZIndex=2})
    self.intro=Visual.caption(self.list,"COLLECT VISITORS.\nCRAFT YOUR NEXT AGENT CARD.",14,c.ink,UDim2.fromOffset(0,0),UDim2.new(1,-8,0,64))
    self.familyPanel=Visual.panel(self.list,"FamilyPanel",UDim2.fromOffset(0,76),UDim2.new(1,-8,0,368))
    self.familyHeading=Visual.caption(self.familyPanel,"AGENT FAMILIES",14,c.ink,UDim2.fromOffset(8,10),UDim2.new(1,-16,0,28))
    self.familyList=Theme.create("ScrollingFrame",self.list,{Name="Families",BackgroundTransparency=1,BorderSizePixel=0,
        ClipsDescendants=true,Position=UDim2.fromOffset(12,116),Size=UDim2.new(1,-32,0,320),
        CanvasSize=UDim2.fromOffset(9*208+8,0),ScrollingDirection=Enum.ScrollingDirection.X,ScrollBarThickness=5,
        ScrollBarImageColor3=c.accent,ZIndex=2})
    for index,family in ipairs(balance.AGENT_FAMILIES) do
        local entry=Visual.cardView(self.familyList,family.id,family.id);local card=entry.frame
        card.Position=UDim2.fromOffset(8+(index-1)*208,4)
        entry.id=family.id;entry.name.Text=family.name
        card.Activated:Connect(function(input)
            if not self:canInteract(input,card) then return end
            self.target=index;self:render();if self.onMove then self.onMove() end
        end)
        self.cards[index]=entry
    end
    self.recipePanel=Visual.panel(self.list,"RecipePanel",UDim2.fromOffset(0,464),UDim2.new(1,-8,0,656))
    self.familyTitle,self.familyTitleShadow=Visual.caption(self.list,"EMBER / RECIPES",16,c.ink,UDim2.fromOffset(8,476),UDim2.new(1,-24,0,44))
    for rank,tier in ipairs(balance.CRAFT_TIERS) do
        local entry=Visual.cardView(self.list,tier.id,"ember"..(rank==1 and "" or "_"..tier.id));local frame=entry.frame
        frame.Active=false;frame.Selectable=false;frame.Size=UDim2.fromOffset(288,560)
        entry.name.Position=UDim2.fromOffset(8,12);entry.name.Size=UDim2.new(1,-16,0,28);entry.name.TextSize=16
        entry.nameShadow.Position=UDim2.fromOffset(10,14);entry.nameShadow.Size=entry.name.Size;entry.nameShadow.TextSize=16
        entry.aura.frame.Position=UDim2.new(.5,-96,0,44);entry.aura.frame.Size=UDim2.fromOffset(192,192)
        for _,parts in ipairs({entry.aura.rim,entry.aura.fill,entry.aura.glints}) do for _,part in ipairs(parts) do
            local p,s=part.Position,part.Size
            part.Position=UDim2.fromOffset(p.X.Offset*4/3,p.Y.Offset*4/3);part.Size=UDim2.fromOffset(s.X.Offset*4/3,s.Y.Offset*4/3)
        end end
        entry.preview.frame.Position=UDim2.new(.5,-80,0,88);entry.preview.frame.Size=UDim2.fromOffset(160,100)
        entry.rarity.Position=UDim2.fromOffset(8,244);entry.rarity.Size=UDim2.new(1,-16,0,28);entry.rarity.TextSize=14
        local plaque=frame.BuffPlaque;plaque.Position=UDim2.fromOffset(12,280);plaque.Size=UDim2.new(1,-24,0,56)
        for _,label in ipairs({entry.buff,entry.buffShadow,entry.speed,entry.speedShadow}) do label.Size=UDim2.new(1,-12,0,20) end
        entry.buff.TextSize,entry.buffShadow.TextSize=16,16
        entry.speed.Position=UDim2.fromOffset(6,30);entry.speedShadow.Position=UDim2.fromOffset(8,32)
        entry.status.Position=UDim2.fromOffset(8,344);entry.status.Size=UDim2.new(1,-16,0,40)
        entry.statusShadow.Position=UDim2.fromOffset(10,346);entry.statusShadow.Size=entry.status.Size
        local cost,costShadow=Visual.caption(frame,"",16,c.text,UDim2.fromOffset(12,392),UDim2.new(1,-24,0,88))
        entry.cost,entry.costShadow=cost,costShadow
        local buy,art=Theme.pixelButton(frame,"CRAFT",UDim2.new(0.5,-92,1,-50),UDim2.fromOffset(184,40),function(input)
            if not self:canInteract(input,self.recipes[rank].buy) or not self.data then return end
            local id=self:cardId(rank)
            if Craft.affordable(self.data,Craft.quote(self.data,id,self.balance)) and self.onCraft then self.onCraft(id) end
        end)
        entry.buy,entry.art=buy,art;buy.ZIndex=4
        self.recipes[rank]=entry
    end
    self.message=Theme.text(self.frame,"Collect fragments in Main CLI. Equip crafted cards in Cards.",14,c.muted,UDim2.new(0,12,1,-80),UDim2.new(1,-24,0,72));self.message.ZIndex=4
    self:render();return self
end
function Lab:cardId(rank)
    local tier=self.balance.CRAFT_TIERS[rank]
    return self.balance.AGENT_FAMILIES[self.target].id..(rank==1 and "" or "_"..tier.id)
end
function Lab:canInteract(input,control)
    if self.destroyed or not self.frame.Visible or self.pending or not self.data or self.data.blocked
        or (self.allowPointer and not self.allowPointer(input)) then return false end
    if input and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
        if not contains(control,input.Position) or not contains(self.frame,input.Position) then return false end
        if control:IsDescendantOf(self.list) and not contains(self.list,input.Position) then return false end
        if control:IsDescendantOf(self.familyList) and not contains(self.familyList,input.Position) then return false end
    end
    return true
end
function Lab:update(data,pending,message)
    if self.destroyed then return end
    if data then self.data=data end
    self.pending=pending or false
    local reply=self.data and self.data.progressionReply
    if reply and reply.action=="craft_card" and reply.requestId&gt;self.seenReply then
        self.seenReply=reply.requestId;self.message.Text=reply.message
    end
    if self.pending then self.message.Text=message or "Waiting for server confirmation..."
    elseif self.data and self.data.progressionSyncId and self.data.progressionSyncId&gt;self.seenReply then
        self.seenReply=self.data.progressionSyncId;self.message.Text="Change checked. Choose a recipe."
    end
    self:render()
end
function Lab:setPending(value,message)
    local pendingText=value and message or nil
    if self.pending==value and self.pendingText==pendingText then return end
    self.pendingText=pendingText;self:update(nil,value,message)
end
function Lab:render()
    local family=self.balance.AGENT_FAMILIES[self.target]
    self.wallet.Text=self.data and (Theme.money(self.data.credits).." / "..Theme.number(self.data.chips).." Chips") or "Connecting..."
    self.familyTitle.Text=string.upper(family.name).." / RECIPES"
    self.familyTitleShadow.Text=self.familyTitle.Text
    for index,entry in ipairs(self.cards) do
        local amount=self.data and self.data.fragments[entry.id] or 0
        entry.status.Text=index==self.target and "SELECTED" or "SELECT"
        Visual.styleCard(entry,Craft.definition(entry.id,self.balance),true)
        entry.buff.Text=Theme.number(amount);entry.buffShadow.Text=entry.buff.Text
        entry.speed.Text="FRAGMENTS";entry.speedShadow.Text=entry.speed.Text;entry.rarity.Text="FAMILY"
        for _,edge in ipairs(entry.edges) do edge.BackgroundColor3=index==self.target and c.mint or Color3.fromRGB(189,104,138) end
        entry.frame.Active,entry.frame.Selectable=not self.pending,not self.pending
    end
    for rank,entry in ipairs(self.recipes) do
        local id=self:cardId(rank);local card=Craft.definition(id,self.balance);local tier=self.balance.CRAFT_TIERS[rank]
        entry.preview:setMascot(id);entry.name.Text=card.name
        entry.cost.Text=string.format("%d fragments\n%s\n%d Chips",tier.fragments,Theme.money(tier.money),tier.chips)
        entry.costShadow.Text=entry.cost.Text
        local owned=self.data and self.data.cardOwned[id]
        local ready=self.data and not self.pending and Craft.affordable(self.data,Craft.quote(self.data,id,self.balance))
        entry.status.Text=owned and "IN COLLECTION" or ready and "READY TO CRAFT" or "RECIPE"
        Visual.styleCard(entry,card,true)
        entry.buy.Text=owned and "OWNED" or self.pending and "WAIT..." or "CRAFT";entry.art.label.Text=entry.buy.Text
        entry.art.label.TextColor3=owned and c.mint or ready and c.accent or c.muted
        entry.buy.Active,entry.buy.Selectable=ready and true or false,ready and true or false
        entry.frame:SetAttribute("CardId",id);entry.frame:SetAttribute("Owned",owned or false)
    end
end
function Lab:layout()
    self.title.TextSize=14;self.titleShadow.TextSize=14
    local available=math.max(224,self.list.AbsoluteSize.X-24);local gap=16
    local columns=math.max(1,math.min(4,math.floor((available+gap)/304)))
    local width=math.min(352,math.floor((available-gap*(columns-1))/columns))
    for rank,entry in ipairs(self.recipes) do
        local row=math.floor((rank-1)/columns);local inRow=math.min(columns,4-row*columns)
        local left=12+math.max(0,math.floor((available-(inRow*width+(inRow-1)*gap))/2))
        entry.frame.Position=UDim2.fromOffset(left+((rank-1)%columns)*(width+gap),532+row*576)
        entry.frame.Size=UDim2.fromOffset(width,560)
    end
    local rows=math.ceil(4/columns);self.recipePanel.Size=UDim2.new(1,-8,0,80+rows*576)
    self.list.CanvasSize=UDim2.fromOffset(0,556+rows*576)
    local w,h=self.frame.AbsoluteSize.X,self.frame.AbsoluteSize.Y
    local unit=math.max(8,math.ceil(math.max(h/32,w/32)/4)*4)
    for index,part in ipairs(self.stripes) do
        local row,column=math.floor((index-1)/8),(index-1)%8
        part.Position=UDim2.fromOffset((column*unit*4+row*unit)%(unit*32)-unit,row*unit);part.Size=UDim2.fromOffset(unit,unit)
    end
end
function Lab:destroy()
    if self.destroyed then return end
    self.destroyed=true;self.onMove=nil;self.onCraft=nil;self.onOpenCards=nil
    for _,entry in ipairs(self.cards) do entry.preview:destroy() end
    for _,entry in ipairs(self.recipes) do entry.preview:destroy() end
    self.frame:Destroy()
end
return Lab
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000079">
          <Properties>
            <string name="Name">AgentMascot</string>
            <ProtectedString name="Source">--!nonstrict
-- Decorative object; motion is driven by the desk's existing loop, never rewards.
local Theme=require(script.Parent.DeskTheme)
local Catalog=require(script.Parent.MascotCatalog)
local Dance=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").MascotDance)
local Mascot={}
Mascot.__index=Mascot

function Mascot.new(parent,id)
    local self=setmetatable({parts={},streak=0,phase=0,blend=0,phaseOffset=0,
        danceParameters=Dance.parameters(0)},Mascot)
    self.frame=Theme.create("Frame",parent,{Name="AgentMascot",BackgroundTransparency=1,
        BorderSizePixel=0,Active=false,Selectable=false,ClipsDescendants=true,Size=UDim2.fromOffset(64,40)})
    self.aspect=Theme.create("UIAspectRatioConstraint",self.frame,{AspectRatio=1.6,
        DominantAxis=Enum.DominantAxis.Width})
    -- Fixed CLI slot; a different mascot fits inside it instead of pushing text.
    self.motion=Theme.create("Frame",self.frame,{Name="Dance",BackgroundTransparency=1,
        BorderSizePixel=0,Active=false,Selectable=false,AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1,1),Rotation=0})
    self.canvas=Theme.create("Frame",self.motion,{Name="Artwork",BackgroundTransparency=1,
        BorderSizePixel=0,Active=false,Selectable=false,AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1,1)})
    if not self:setMascot(id or Catalog.DEFAULT) then self:setMascot(Catalog.DEFAULT) end
    return self
end

function Mascot:rest()
    self.blend=0
    self.motion.Position=UDim2.fromScale(0.5,0.5)
    self.motion.Size=UDim2.fromScale(1,1);self.motion.Rotation=0
end
function Mascot:setStreak(count)
    if self.destroyed then return end
    count=type(count)=="number" and count==count and math.max(0,math.min(9999,math.floor(count))) or 0
    if self.streak==count then return end
    self.streak=count;self.danceParameters=Dance.parameters(count)
    if count==0 then self.phase=0;self:rest() end
end
function Mascot:tickDance(dt,enabled)
    if self.destroyed then return end
    if not enabled or self.streak==0 then
        if self.blend~=0 then self:rest() end
        return
    end
    self.phase=Dance.advance(self.phase,dt,self.danceParameters.rate)
    self.blend=math.min(1,self.blend+math.max(0,math.min(dt,0.1))*6)
    local x,y,angle,sx,sy=Dance.pose(self.danceParameters,self.phase+self.phaseOffset,self.blend)
    self.motion.Position=UDim2.fromScale(0.5+x,0.5+y)
    self.motion.Size=UDim2.fromScale(sx,sy);self.motion.Rotation=angle
end

function Mascot:setMascot(id)
    local definition=Catalog[id]
    if self.destroyed or type(definition)~="table" or not definition.parts then return false end
    if self.id==id then return true end
    for index,rect in ipairs(definition.parts) do
        local part=self.parts[index]
        if not part then
            part=Theme.create("Frame",self.canvas,{Name="PixelPart"..index,BorderSizePixel=0,
                Active=false,Selectable=false})
            self.parts[index]=part
        end
        local color=rect[5] or definition.color
        part.Visible=true;part.BackgroundColor3=Color3.fromRGB(color[1],color[2],color[3])
        part.Position=UDim2.fromScale(rect[1]/definition.width,rect[2]/definition.height)
        part.Size=UDim2.fromScale(rect[3]/definition.width,rect[4]/definition.height)
    end
    for index=#definition.parts+1,#self.parts do self.parts[index].Visible=false end
    local ratio=definition.width/definition.height
    self.canvas.Size=UDim2.fromScale(math.min(1,ratio/1.6),math.min(1,1.6/ratio))
    self.id=id
    self.frame:SetAttribute("MascotId",id)
    self.frame:SetAttribute("DisplayName",definition.name)
    return true
end

function Mascot:destroy()
    if self.destroyed then return end
    self.destroyed=true;self.parts={};self.frame:Destroy()
end
return Mascot
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000080">
          <Properties>
            <string name="Name">AudioController</string>
            <ProtectedString name="Source">--!nonstrict
local SoundService=game:GetService("SoundService")
local GuiService=game:GetService("GuiService")
local ContentProvider=game:GetService("ContentProvider")
local Music=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Soundtrack)
local Motion=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").PrestigeMotion)
local Audio={}
Audio.__index=Audio
local function create(kind,parent,properties)
    local item=Instance.new(kind)
    for key,value in pairs(properties) do item[key]=value end
    item.Parent=parent;return item
end
function Audio.new(terminal)
    local self=setmetatable({terminal=terminal,musicVolume=0.5,effectsVolume=0.5,muted=false,
        musicVoices={},effectVoices={},clock=Music.transport(),musicTier=0,},Audio)
    self.folder=create("Folder",SoundService,{Name="VibeIdleAudio"})
    local ok,reason=pcall(function()
        self.musicGroup=create("SoundGroup",self.folder,{Name="Music",Volume=self.musicVolume})
        self.effectsGroup=create("SoundGroup",self.folder,{Name="Effects",Volume=self.effectsVolume})
        create("EqualizerSoundEffect",self.musicGroup,{LowGain=0,MidGain=-3,HighGain=-9})
        self.distortion=create("DistortionSoundEffect",self.musicGroup,{Level=0})
        create("ReverbSoundEffect",self.musicGroup,{DecayTime=1.4,Density=0.7,Diffusion=0.85,DryLevel=-3,WetLevel=-20})
        for index=1,16 do
            self.musicVoices[index]={sound=create("Sound",self.folder,{Name="MusicVoice"..index,
                SoundId=Music.TONE,Volume=0,Looped=false,SoundGroup=self.musicGroup})}
        end
        create("ReverbSoundEffect",self.effectsGroup,{DecayTime=1.1,Density=0.8,Diffusion=0.9,DryLevel=0,WetLevel=-20})
        for index=1,6 do
            self.effectVoices[index]={sound=create("Sound",self.folder,{Name="EffectVoice"..index,
                SoundId=Music.TAP,Volume=0,Looped=false,SoundGroup=self.effectsGroup})}
        end
    end)
    if not ok then self:fail(reason);return self end
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync({Music.TONE,Music.TAP,Music.VORTEX}) end)
    end)
    return self
end
function Audio:fail(reason)
    if self.disabled then return end
    self.disabled=true
    self.folder:Destroy()
    warn("[VibeIdle] Local audio unavailable; gameplay continues: "..tostring(reason))
end
function Audio:active()
    return not self.destroyed and not self.disabled and not self.muted and not self.terminal.blocked
        and self.terminal.windowFocused and not GuiService.MenuIsOpen
end
function Audio:stopVoices(pool)
    for _,voice in ipairs(pool) do
        if voice.note then voice.sound:Stop();voice.sound.Volume=0;voice.note=nil end
    end
end
function Audio:play(pool,note)
    if not self:active() then return end
    local voice=pool[1]
    for _,candidate in ipairs(pool) do
        if not candidate.note then voice=candidate;break end
        if (candidate.age or 0)&gt;(voice.age or 0) then voice=candidate end
    end
    local ok,reason=pcall(function()
        voice.sound:Stop()
        voice.sound.SoundId=note.asset;voice.sound.PlaybackSpeed=note.pitch;voice.sound.TimePosition=0
        voice.sound.Looped=note.sustain==true
        voice.sound.Volume=0.001
        voice.sound:Play()
    end)
    if not ok then self:fail(reason);return end
    voice.note,voice.age=note,0
end
function Audio:click(kind)
    if not self:active() or self.effectsVolume==0 then return end
    self.clickSequence=(self.clickSequence or 0)%4+1
    for _,note in ipairs(Music.uiCue(kind,self.clickSequence)) do self:play(self.effectVoices,note) end
end
function Audio:confirmed(result)
    -- Called only by the existing matching-result watermark. Never by sync alone.
    if not self:active() or self.effectsVolume==0 or self.terminal.suspended or result.reused then return end
    for _,note in ipairs(Music.cue(result.grade,result.streak)) do self:play(self.effectVoices,note) end
end
function Audio:coin(event)
    if event.receiptId&lt;(self.coinReceipt or 0) or (event.receiptId==(self.coinReceipt or 0)
        and event.tokenIndex&lt;=(self.coinIndex or 0)) then return end
    self.coinReceipt,self.coinIndex=event.receiptId,event.tokenIndex
    if not self:active() or self.effectsVolume==0 or self.terminal.suspended then return end
    for _,note in ipairs(Music.coinCue(event.rank)) do self:play(self.effectVoices,note) end
end
function Audio:startVortex(id,reduced)
    if id&lt;=(self.lastVortexId or 0) then return false end
    self.lastVortexId=id
    if not self:active() or self.effectsVolume==0 then return false end
    self.vortexActive=true;self.vortexAge=0;self.vortexReduced=reduced
    for _,note in ipairs(Music.vortexCue(reduced)) do self:play(self.effectVoices,note) end
    return not self.disabled
end
function Audio:stopVortex()
    self.vortexActive=false
    if self.disabled or self.destroyed then return end
    for _,voice in ipairs(self.effectVoices) do if voice.note and voice.note.vortex then
        voice.sound:Stop();voice.sound.Volume=0;voice.note=nil
    end end
end
function Audio:vortexFrame(age,reduced,active,paused)
    if not active or paused then self:stopVortex();return end
    self.vortexAge,self.vortexReduced=age,reduced
end
function Audio:setVolume(channel,value)
    value=math.max(0,math.min(1,value))
    if channel=="music" then self.musicVolume=value
    elseif channel=="effects" then self.effectsVolume=value else return end
    if not self.disabled and not self.destroyed then
        self.musicGroup.Volume=self.muted and 0 or self.musicVolume
        self.effectsGroup.Volume=self.muted and 0 or self.effectsVolume
        if value==0 then
            self:stopVoices(channel=="music" and self.musicVoices or self.effectVoices)
            if channel=="music" then self.clock=Music.transport() end
        end
    end
end
function Audio:setMuted(value)
    self.muted=value
    if self.disabled or self.destroyed then return end
    self.musicGroup.Volume=value and 0 or self.musicVolume
    self.effectsGroup.Volume=value and 0 or self.effectsVolume
    if value then self:stopVoices(self.musicVoices);self:stopVoices(self.effectVoices);self.clock=Music.transport() end
end
function Audio:tick(dt,streak,c)
    if self.disabled or self.destroyed then return end
    if not self:active() then
        self:stopVoices(self.musicVoices);self:stopVoices(self.effectVoices)
        self.clock=Music.transport();return
    end
    dt=math.max(0,math.min(0.1,dt))
    self.musicTier=Music.tier(streak or 0,c)
    self.distortion.Level=self.distortion.Level+(self.musicTier*0.09-self.distortion.Level)*math.min(1,dt*4)
    for _,pool in ipairs({self.musicVoices,self.effectVoices}) do
        for _,voice in ipairs(pool) do
            if voice.note then
                if voice.note.vortex then
                    local close=self.vortexReduced and Motion.REDUCED_CLOSE or Motion.CLOSE
                    local hold=self.vortexReduced and 0 or Motion.HOLD
                    local open=self.vortexReduced and Motion.REDUCED_OPEN or Motion.OPEN
                    local gain,pitch=Music.vortexMix(self.vortexAge or 0,close,hold,open,voice.note.vortex)
                    voice.sound.Volume=voice.note.gain*gain;voice.sound.PlaybackSpeed=pitch
                else
                    voice.age=math.min(voice.age+dt,voice.note.sustain and voice.note.attack or math.huge)
                    local envelope=voice.note.sustain and math.min(1,voice.age/voice.note.attack)
                        or Music.envelope(voice.age,voice.note.duration,voice.note.attack)
                    voice.sound.Volume=voice.note.gain*envelope
                    if voice.note.risePitch then
                        voice.sound.PlaybackSpeed=voice.age&gt;=voice.note.riseAt and voice.note.risePitch or voice.note.pitch
                    end
                    if not voice.note.sustain and voice.age&gt;=voice.note.duration then voice.sound:Stop();voice.note=nil end
                end
            end
        end
    end
    if self.musicVolume&gt;0 then
        for _,step in ipairs(Music.advance(self.clock,dt,self.musicTier,self.terminal.tuning and self.terminal.tuning.musicScale)) do
            for _,note in ipairs(Music.events(step,self.musicTier)) do
                self:play(self.musicVoices,note)
                if self.disabled then return end
            end
        end
    end
end
function Audio:destroy()
    if self.destroyed then return end
    self.destroyed=true;self.folder:Destroy();self.musicVoices={};self.effectVoices={}
end
return Audio
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000081">
          <Properties>
            <string name="Name">BackdropDancers</string>
            <ProtectedString name="Source">--!nonstrict
-- Streak celebration coordinator. Each pooled actor owns its visual lifecycle.
local Theme=require(script.Parent.DeskTheme)
local Avatar=require(script.Parent.StreakAvatar)
local UserInputService=game:GetService("UserInputService")
local Definitions=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").StreakCollectibles)
local Music=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Soundtrack)
local Dancers={};Dancers.__index=Dancers
Dancers.CAPACITY=Definitions.CAPACITY
Dancers.POPUP_SECONDS=.9
function Dancers.new(parent,terminal,desk)
    local self=setmetatable({terminal=terminal,desk=desk,pool={},cursor=0,spawnCount=0,random=Random.new()},Dancers)
    self.layer=Theme.create("Frame",parent,{Name="StreakAvatars",BackgroundTransparency=1,
        BorderSizePixel=0,Active=false,Selectable=false,ClipsDescendants=true,ZIndex=2,Size=UDim2.fromScale(1,1)})
    self.popups={};self.popupCursor=0;self.popupCount=0
    for index=1,Dancers.CAPACITY do
        local label=Theme.text(self.layer,"",18,Theme.colors.mint,UDim2.fromOffset(0,0),UDim2.fromOffset(240,32))
        label.Name="FragmentPopup"..index;label.ZIndex=8;label.Active=false;label.Selectable=false;label.Visible=false
        label.TextWrapped=false;label.TextXAlignment=Enum.TextXAlignment.Center
        local stroke=Theme.create("UIStroke",label,{Color=Color3.fromRGB(0,0,0),Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
        self.popups[index]={label=label,stroke=stroke,active=false}
    end
    for index=1,Dancers.CAPACITY do
        local avatar=Avatar.new(self.layer,index)
        avatar.onCollect=function(actor,input)
            if input and input.UserInputType~=self.pointerGestureType then self:collect(actor,input) end
        end
        self.pool[index]=avatar
    end
    self.pointerConnection=UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        self.pointerGestureType=input.UserInputType
        if self.allowPointer and not self.allowPointer(input) then return end
        local avatar=self:avatarAt(input)
        if avatar then self:collect(avatar,input) end
    end)
    return self
end
function Dancers:showFragments(avatar,receipt)
    if not avatar.resource or avatar.collectionShown or receipt.id~=avatar.collectibleId or type(receipt.fragments)~="number"
        or receipt.fragments~=receipt.fragments or receipt.fragments%1~=0 or receipt.fragments&lt;0 or receipt.fragments&gt;1000000 then return end
    avatar.collectionShown=true
    self.popupCursor=self.popupCursor%Dancers.CAPACITY+1
    local slot=self.popups[self.popupCursor];local p,s=avatar.frame.AbsolutePosition,avatar.frame.AbsoluteSize
    local origin,size=self.layer.AbsolutePosition,self.layer.AbsoluteSize
    slot.x=(p.X+s.X/2-origin.X)/math.max(1,size.X);slot.y=(p.Y+s.Y/2-origin.Y)/math.max(1,size.Y)
    slot.age=0;slot.active=true;slot.id=receipt.id;slot.amount=receipt.fragments
    slot.label.Text=string.format("+%d fragments",receipt.fragments)
    self.popupCount=self.popupCount+1;self:placePopup(slot)
end
function Dancers:placePopup(slot)
    local size=self.layer.AbsoluteSize;local width=math.max(1,math.min(240,size.X-16));local height=32
    local fontSize=18
    while fontSize&gt;12 and Theme.textWidth(slot.label.Text,fontSize)&gt;width-8 do fontSize=fontSize-1 end
    slot.label.TextSize=fontSize
    local t=math.min(1,slot.age/Dancers.POPUP_SECONDS)
    local x=math.max(0,math.min(size.X-width,slot.x*size.X-width/2))
    local base=math.max(0,math.min(size.Y-height,slot.y*size.Y-height/2))
    local rise=self.reduced and 0 or math.min(40,base)*(1-(1-t)^2)
    slot.label.Position=UDim2.fromOffset(x,base-rise);slot.label.Size=UDim2.fromOffset(width,height)
    slot.label.TextTransparency=math.max(0,(t-.4)/.6)
    slot.stroke.Transparency=slot.label.TextTransparency
    slot.label.Visible=slot.active and self.terminal:canEdit()
end
function Dancers:choosePosition(avatar)
    avatar:setPosition(self.random:NextInteger(0,1000)/1000,self.random:NextInteger(0,1000)/1000)
end
function Dancers:loseStreak()
    for _,avatar in ipairs(self.pool) do if not avatar.resource then avatar:fadeOut() end end
end
function Dancers:confirmed(result)
    if result.streakBroken or result.streak==0 then self:loseStreak() end
end
function Dancers:avatarAt(input)
    if self.destroyed or not input or not input.Position or not self.terminal:canEdit() then return nil end
    for index=#self.pool,1,-1 do
        local avatar=self.pool[index];local p,size=avatar.frame.AbsolutePosition,avatar.frame.AbsoluteSize
        if avatar.active and avatar.frame.Visible and (avatar.alpha or 1)&lt;0.98 and input.Position.X&gt;=p.X and input.Position.X&lt;p.X+size.X
            and input.Position.Y&gt;=p.Y and input.Position.Y&lt;p.Y+size.Y then return avatar end
    end
    return nil
end
function Dancers:blocksPointer(input) return self:avatarAt(input)~=nil end
function Dancers:collect(avatar,input)
    if self.destroyed or not input or (input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch)
        or not self.terminal:canEdit() or self.terminal.skillPending or not self.onCollect
        or not avatar.active or avatar.fading or avatar.pending or not avatar.collectibleId
        or (self.allowPointer and not self.allowPointer(input)) then return false end
    if self:avatarAt(input)~=avatar then return false end
    avatar.pending=true;avatar.pendingAge=0;avatar.syncAttempts=0;avatar.badge.Text="Checking..."
    self.onCollect({id=avatar.collectibleId});return true
end
function Dancers:update(data)
    if self.destroyed or not data.streakAvatars then return end
    self.pollSequence=math.max(self.pollSequence or 0,data.streakAvatars.pollSequence or 0)
    local checkId=data.skillCheck and data.skillCheck.id or 0
    if checkId&lt;(self.lastCheckId or 0) then return end
    self.lastCheckId=checkId
    self.seen=self.seen or {}
    local live={}
    for _,item in ipairs(data.streakAvatars.items) do
        live[item.id]=true
        if item.id&gt;(self.watermark or 0) and not self.seen[item.id] then
            self.seen[item.id]=true
            if item.familyId or self.terminal:canEdit() then
                local avatar
                for index,candidate in ipairs(self.pool) do
                    if not candidate.destroyed and not candidate.active then self.cursor=index;avatar=candidate;break end
                end
                if not avatar then for index,candidate in ipairs(self.pool) do
                    if candidate.fading then self.cursor=index;avatar=candidate;break end
                end end
                if avatar then
                    local source=not item.familyId and self.desk.agents[item.sourceAgent].mascot
                    avatar:activate({mascotId=item.mascotId or source.id,sourceAgent=item.sourceAgent,collectibleId=item.id,rank=item.rank,streak=item.streak,reward=item.reward,
                        familyId=item.familyId,familyName=item.familyName,rarity=item.rarity,fragments=item.fragments,
                        phaseOffset=self.random:NextInteger(0,1000)/1000*math.pi*2,width=self.random:NextInteger(12,20)*8,
                        x=item.x or self.random:NextInteger(0,1000)/1000,y=item.y or self.random:NextInteger(0,1000)/1000},self.reduced)
                    self.spawnCount=self.spawnCount+1
                end
            end
        end
    end
    -- Keep only live IDs in replay bookkeeping; monotonic watermark handles old snapshots.
    self.watermark=math.max(self.watermark or 0,data.streakAvatars.sequence)
    for id in pairs(self.seen) do if not live[id] then self.seen[id]=nil end end
    for _,avatar in ipairs(self.pool) do
        if avatar.active and avatar.collectibleId then
            if not live[avatar.collectibleId] then
                if data.lastAvatarCollect and data.lastAvatarCollect.id==avatar.collectibleId then
                    local receipt=data.lastAvatarCollect
                    if receipt.fragments then
                        self:showFragments(avatar,receipt);avatar.badge.Text=""
                    else avatar.badge.Text="+"..receipt.added.." STREAK" end
                end
                avatar.pending=false;avatar:fadeOut()
            elseif avatar.pending and (data.avatarRejected==avatar.collectibleId or data.avatarSyncId==avatar.collectibleId) then
                avatar.pending=false
                avatar.badge.Text=avatar.caption
            end
        end
    end
end
function Dancers:clear()
    for _,avatar in ipairs(self.pool) do avatar:hide() end
    for _,slot in ipairs(self.popups) do slot.active=false;slot.label.Visible=false end
end
function Dancers:setReducedMotion(value)
    self.reduced=value
    for _,avatar in ipairs(self.pool) do avatar:setReducedMotion(value) end
    for _,slot in ipairs(self.popups) do if slot.active then self:placePopup(slot) end end
end
function Dancers:tick(dt)
    if self.destroyed then return end
    local eligible=self.terminal:canEdit()
    for _,slot in ipairs(self.popups) do if slot.active then
        if eligible then slot.age=slot.age+math.max(0,math.min(.1,dt)) end
        if slot.age&gt;=Dancers.POPUP_SECONDS then slot.active=false;slot.label.Visible=false else self:placePopup(slot) end
    end end
    if self.terminal:canEdit() and self.onPoll then
        self.pollAge=(self.pollAge or 0)+math.max(0,math.min(dt,1))
        if self.pollAge&gt;=1 then
            self.pollAge=0;self.pollSequence=(self.pollSequence or 0)+1
            self.onPoll({requestId=self.pollSequence})
        end
    else self.pollAge=0 end
    local streak=self.desk.data and self.desk.data.stats and self.desk.data.stats.streak or self.lastStreak or 0
    if (self.lastStreak or 0)&gt;0 and streak==0 then self:loseStreak() end
    self.lastStreak=streak
    local tuning=self.terminal.tuning or {}
    local bpm=Music.tempo(Music.tier(streak,self.terminal.streakDivisor))*(tuning.musicScale or 1)*(tuning.danceScale or 1)
    local animate=self.terminal:canEdit() and not self.reduced
    for _,avatar in ipairs(self.pool) do
        avatar.fadeInSeconds,avatar.fadeOutSeconds=tuning.avatarFadeIn,tuning.avatarFadeOut
        if avatar.pending then
            avatar.pendingAge=avatar.pendingAge+math.max(0,dt)
            if avatar.pendingAge&gt;=(tuning.grantTimeout or 12) then
                avatar.pending=false
                avatar.badge.Text=avatar.caption
            elseif avatar.syncAttempts&lt;3 and avatar.pendingAge&gt;=(tuning.syncDelay or 3)*(avatar.syncAttempts+1) and self.onSync then
                avatar.syncAttempts=avatar.syncAttempts+1;self.onSync({id=avatar.collectibleId})
            end
        end
        avatar.frame.Visible=avatar.active and not self.terminal.suspended
        avatar:tick(dt,avatar.resource and 5 or streak,avatar.resource and 88 or bpm,animate,self.reduced)
        avatar.button.Active=avatar.active and (avatar.alpha or 1)&lt;0.98 and self.terminal:canEdit()
    end
end
function Dancers:destroy()
    if self.destroyed then return end
    self.destroyed=true;self.pointerConnection:Disconnect()
    for _,avatar in ipairs(self.pool) do avatar:destroy() end
    self.layer:Destroy()
end
return Dancers
