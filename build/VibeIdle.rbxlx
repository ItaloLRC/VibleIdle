      <Item class="ModuleScript" referent="RBX000031">
        <Properties>
          <string name="Name">AgentAutomation</string>
          <ProtectedString name="Source">--!nonstrict
-- Agent-only speed budget and streak reward. No automatic skill successes.
local Auto={}
local neutral={speed=1,value=1}
function Auto.advance(session,profile,now,balance,rules,skill,cards)
    if type(now)~="number" or now~=now or math.abs(now)==math.huge then return false end
    local rate=balance.TYPING_BASE_RATE+(profile.typingLevel or 0)*balance.TYPING_RATE_PER_LEVEL
    if session.skillSettings and (session.skillSettings.agentRate or 0)&gt;0 then rate=session.skillSettings.agentRate end
    local interval=session.skillSettings and session.skillSettings.agentInterval or balance.AGENT_INTERVAL
    local words=rules and skill and skill.wordsPerClick(session.streak or 0,1+profile.clickLevel,rules.streakDivisor(profile,balance))
        or session.agentWordsPerClick or 1
    session.agentWordsPerClick=words
    local productionRate=math.min(rate,words/interval)
    local pace=session.agentPace
    if not pace then
        pace={time=now,budget=0,rate=rate,agents={}}
        session.agentPace=pace
    end
    if now&lt;pace.time then return false end
    -- Each agent owns one second of capacity. New agents start accruing now,
    -- without consuming another agent's budget or inheriting earlier idle time.
    pace.budget=0
    pace.totalRate,pace.totalProductionRate=0,0
    local treeSpeed=balance.progression(profile).speed
    for index=1,#profile.layerSizes-2 do
        local effect=cards and cards.effect(profile,index,balance) or neutral
        local speed=effect.speed*treeSpeed
        local agentRate=math.min(balance.MAX_CARD_TYPING_RATE,rate*speed)
        local agentProductionRate=math.min(agentRate,words/interval*speed)
        local agentPeriod=agentProductionRate&gt;0 and 1/agentProductionRate or math.huge
        local agent=pace.agents[index]
        if not agent then
            local phase=((index-1)*0.61803398875)%1
            agent={time=now,budget=0,rate=agentRate,nextAt=now+agentPeriod*(1+phase*0.75),period=agentPeriod,ordinal=0,phase=phase}
            pace.agents[index]=agent
        else
            agent.budget=math.min(balance.PROMPT_MAX_TOKENS,agent.rate,agent.budget+(now-agent.time)*agent.rate)
            if agent.period~=agentPeriod then
                local remaining=agent.period&lt;math.huge and math.max(0,agent.nextAt-now)/agent.period or 1
                agent.nextAt=agentPeriod&lt;math.huge and now+remaining*agentPeriod or math.huge
                agent.period=agentPeriod
            end
            agent.time,agent.rate=now,agentRate
        end
        agent.budget=math.min(agent.budget,agentRate)
        agent.productionRate,agent.cardValue=agentProductionRate,effect.value
        pace.budget=pace.budget+agent.budget
        pace.totalRate=pace.totalRate+agentRate
        pace.totalProductionRate=pace.totalProductionRate+agentProductionRate
    end
    for index=#pace.agents,#profile.layerSizes-1,-1 do pace.agents[index]=nil end
    pace.time,pace.rate,pace.productionRate=now,rate,productionRate
    return true
end
function Auto.delay(session,now,balance)
    local delay=session.skillSettings and session.skillSettings.agentInterval or balance.AGENT_INTERVAL
    for _,agent in ipairs(session.agentPace and session.agentPace.agents or {}) do
        delay=math.min(delay,math.max(0,agent.nextAt-now,(1-agent.budget)/agent.rate))
    end
    return delay
end
function Auto.grant(session,profile,payload,now,balance,rules,skill,cards)
    if type(now)~="number" or now~=now or math.abs(now)==math.huge then return false end
    if type(payload)~="table" then return false end
    local fields=0
    for key,value in pairs(payload) do
        local maximum=key=="tokenIndex" and balance.PROMPT_MAX_TOKENS or balance.MAX_CREDITS
        if (key~="requestId" and key~="draftId" and key~="tokenIndex") or type(value)~="number"
            or value~=value or value%1~=0 or value&lt;1 or value&gt;maximum then return false end
        fields=fields+1
    end
    if fields~=3 then return false end
    local draft=session.draft
    if not draft or payload.draftId~=draft.id or payload.tokenIndex&gt;#draft.offers then return false end
    if payload.requestId&lt;=(session.autoSequence or 0) then return false end
    if not Auto.advance(session,profile,now,balance,rules,skill,cards) then return false end
    local count,costs,sources,deadlines,ordinals=0,{},{},{},{}
    local jitter=session.skillSettings and session.skillSettings.agentJitter or balance.AGENT_TIMING_JITTER
    for agentIndex,agent in ipairs(session.agentPace.agents) do
        local window=math.min(balance.AGENT_COALESCE_WINDOW,math.max(balance.AGENT_POLL_INTERVAL,now-(agent.lastGrantAt or now)))
        local maximum=math.max(1,math.ceil(agent.productionRate*window))
        local fresh,start=0,count
        local nextAt,ordinal=agent.nextAt,agent.ordinal
        if now-nextAt&gt;agent.period*maximum then nextAt=now-(agent.phase or 0)*agent.period*0.75 end
        for _=1,maximum do
            if now+0.000001&lt;nextAt then break end
            local index=payload.tokenIndex+count
            if index&gt;#draft.offers then break end
            if not (session.skillAwards and session.skillAwards[index]) then
                if fresh&gt;=math.floor(agent.budget+0.000001) then break end
                fresh=fresh+1
            end
            count=count+1
            ordinal=ordinal+1
            nextAt=nextAt+agent.period*(1+((ordinal+agentIndex)%2==0 and jitter or -jitter))
        end
        costs[agentIndex]=fresh
        deadlines[agentIndex],ordinals[agentIndex]=nextAt,ordinal
        if count&gt;start then sources[#sources+1]={agentIndex=agentIndex,wordCount=count-start} end
    end
    if count&lt;1 then return false end
    local factor=1+(session.streak or 0)*0.1
    session.skillAwards=session.skillAwards or {}
    local cursor=payload.tokenIndex
    for _,source in ipairs(sources) do
        local cardValue=session.agentPace.agents[source.agentIndex].cardValue
        for index=cursor,cursor+source.wordCount-1 do
            if not session.skillAwards[index] then
                session.skillAwards[index]={tokenIndex=index,grade="Agent",multiplier=factor*cardValue,
                    precisionMultiplier=1,streakMultiplier=factor,streak=session.streak or 0,cardMultiplier=cardValue}
            end
        end
        cursor=cursor+source.wordCount
    end
    session.agentPace.budget=0
    for index,agent in ipairs(session.agentPace.agents) do
        agent.budget=math.max(0,agent.budget-costs[index])
        session.agentPace.budget=session.agentPace.budget+agent.budget
    end
    for _,source in ipairs(sources) do
        local agent=session.agentPace.agents[source.agentIndex]
        agent.nextAt,agent.ordinal=deadlines[source.agentIndex],ordinals[source.agentIndex]
        agent.lastGrantAt=now
    end
    session.autoTime,session.autoSequence=now,payload.requestId
    session.autoReceipt={requestId=payload.requestId,draftId=draft.id,tokenIndex=payload.tokenIndex,wordCount=count,sources=sources}
    return true
end
return Auto
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000032">
        <Properties>
          <string name="Name">AgentCards</string>
          <ProtectedString name="Source">--!nonstrict
-- One permanent copy of each starter card; agent count unlocks deck positions.
local Cards={}
local neutral={value=1,speed=1}
function Cards.definition(id,balance)
    for _,card in ipairs(balance.AGENT_CARDS) do if card.id==id then return card end end
end
function Cards.effect(state,index,balance)
    if not Cards.validSlot(state,index,balance) then return neutral end
    return Cards.definition(state.cardDeck and state.cardDeck[index],balance) or neutral
end
function Cards.location(state,id,balance)
    for index=1,balance.MAX_HIDDEN_LAYERS do if state.cardDeck[index]==id then return index end end
end
function Cards.validSlot(state,index,balance)
    return type(index)=="number" and index==index and index%1==0 and index&gt;=1
        and index&lt;=balance.MAX_HIDDEN_LAYERS and index&lt;=#state.layerSizes-2
end
function Cards.equip(state,index,id,balance)
    if not Cards.validSlot(state,index,balance) then return false,"Slot is locked." end
    if not Cards.definition(id,balance) or not state.cardOwned[id] then return false,"Card not owned." end
    if state.cardDeck[index] then return false,"Position occupied." end
    if Cards.location(state,id,balance) then return false,"Card already equipped." end
    state.cardDeck[index]=id
    return true,"Card equipped."
end
function Cards.unequip(state,index,balance)
    if not Cards.validSlot(state,index,balance) then return false,"Slot is locked." end
    if not state.cardDeck[index] then return false,"Empty position." end
    state.cardDeck[index]=false
    return true,"Card returned."
end
function Cards.key(deck,balance)
    local values={}
    for index=1,balance.MAX_HIDDEN_LAYERS do values[index]=deck and deck[index] or "" end
    return table.concat(values,"|")
end
function Cards.buffText(card)
    return string.format("$ %+g%%\nSPD %+g%%",(card.value-1)*100,(card.speed-1)*100)
end
return Cards
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000033">
        <Properties>
          <string name="Name">AgentCrafting</string>
          <ProtectedString name="Source">--!nonstrict
-- Deterministic one-time recipes. No client prices/rewards or random purchases.
local Craft={}
function Craft.definition(id,balance)
    for _,card in ipairs(balance.AGENT_CARDS) do if card.id==id then return card end end
end
function Craft.quote(state,id,balance)
    local card=Craft.definition(id,balance)
    if not card then return nil,"Unknown card." end
    if state.cardOwned[id] then return nil,"Card already owned." end
    local tier=balance.CRAFT_TIERS[card.rank]
    return {cardId=id,familyId=card.familyId,fragments=tier.fragments,money=tier.money,chips=tier.chips}
end
function Craft.affordable(state,quote)
    return quote and (state.fragments[quote.familyId] or 0)&gt;=quote.fragments
        and state.credits&gt;=quote.money and state.chips&gt;=quote.chips
end
function Craft.purchase(state,id,balance)
    local quote,reason=Craft.quote(state,id,balance)
    if not quote then return false,reason end
    if not Craft.affordable(state,quote) then return false,"Need more fragments, money or Chips." end
    -- Prepare/validate first, then debit/grant atomically without yielding.
    state.fragments[quote.familyId]=state.fragments[quote.familyId]-quote.fragments
    state.credits=state.credits-quote.money;state.chips=state.chips-quote.chips
    state.cardOwned[id]=true;state.cardCrafted[id]=true
    return true,"Card crafted. Equip it in Cards."
end
return Craft
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000034">
        <Properties>
          <string name="Name">AgentSession</string>
          <ProtectedString name="Source">--!nonstrict
-- Pure, bounded presentation of confirmed receipts. Never calculates/grants money.
local Agent = { MAX_LINES = 72, MAX_PENDING = 4, DURATION = 1.4 }
local stages = { 0.4, 0.9, 1.4 }
local files = { "src/app.tsx", "src/styles.css", "src/agent.ts", "tests/app.spec.ts" }

function Agent.new()
    return { lines = {}, pending = {}, lastReceipt = 0, revision = 0, completed = 0, coalesced = 0 }
end

function Agent.append(state, text, kind)
    state.lines[#state.lines + 1] = { text = string.sub(text, 1, 220), kind = kind or "muted" }
    if #state.lines &gt; Agent.MAX_LINES then table.remove(state.lines, 1) end
    state.revision = state.revision + 1
end

local function begin(state, job)
    state.active, state.elapsed, state.step = job, 0, 1
    Agent.append(state, string.format("dev@vibe:~$ agent run --job %03d", job.id), "accent")
    Agent.append(state, "&gt; " .. job.command, "text")
    Agent.append(state, "[plan] Inspecting workspace and choosing an implementation.", "muted")
end

function Agent.accept(state, receipt, baseline, prompt, balance)
    if type(receipt) ~= "table" or type(receipt.id) ~= "number" or receipt.id ~= receipt.id
        or receipt.id % 1 ~= 0 or receipt.id &lt;= state.lastReceipt or receipt.id == math.huge then return false end
    if baseline then state.lastReceipt = receipt.id;return false end
    if type(receipt.tokens) ~= "number" or receipt.tokens % 1 ~= 0 or receipt.tokens &lt; 1
        or receipt.tokens &gt; balance.PROMPT_MAX_TOKENS or type(receipt.reward) ~= "number"
        or receipt.reward ~= receipt.reward or receipt.reward &lt; 0 or receipt.reward &gt; balance.MAX_CREDITS then return false end
    local command = prompt.text(receipt.tokens, balance, (receipt.startToken or 1) - 1)
    if not command then return false end
    state.lastReceipt = receipt.id
    -- Copy only the confirmed summary; later snapshots cannot relabel an active job.
    local job = { id = receipt.id, tokens = receipt.tokens, reward = receipt.reward,
        word = receipt.outputToken or "FIX", rarity = receipt.outputRarity or "Common",
        rank = receipt.featured and receipt.featured.rank or 1,
        command = string.sub(command, 1, 170), file = files[(receipt.id - 1) % #files + 1] }
    if not state.active then begin(state, job)
    elseif #state.pending &lt; Agent.MAX_PENDING then state.pending[#state.pending + 1] = job
    else
        -- Collapse only unstarted previews. Every receipt was already paid by the server.
        local last = state.pending[#state.pending]
        if job.rank &gt;= last.rank then state.pending[#state.pending] = job end
        state.coalesced = state.coalesced + 1
    end
    return true
end

function Agent.tick(state, dt, reduced, duration)
    if type(dt) ~= "number" or dt ~= dt or dt &lt; 0 or dt == math.huge then return end
    local remaining = reduced and math.huge or dt -- At most one active + four queued jobs.
    while state.active do
        local stage=stages[state.step]*(duration or Agent.DURATION)/Agent.DURATION
        local untilStage = math.max(0,stage - state.elapsed)
        if remaining &lt; untilStage then state.elapsed = state.elapsed + remaining;break end
        remaining, state.elapsed = remaining - untilStage, stage
        local job = state.active
        if state.step == 1 then
            Agent.append(state, "[edit] " .. job.file .. "  +" .. job.tokens .. " generated tokens", "accent")
            Agent.append(state, "+ export const build = () =&gt; ship(feature);", "success")
        elseif state.step == 2 then
            Agent.append(state, "[test] Type check passed. All checks green.", "success")
        else
            Agent.append(state, string.format("[ship #%03d] %s / %s  +$%.2f", job.id, job.word, job.rarity, job.reward), job.rarity)
            state.completed, state.lastResult = state.completed + 1, job
            state.active = nil
            if #state.pending &gt; 0 then begin(state, table.remove(state.pending, 1)) end
        end
        if state.active == job then state.step = state.step + 1 end
    end
end

function Agent.reset(state)
    state.active, state.elapsed, state.lastResult = nil, nil, nil
    state.pending, state.lines, state.completed, state.coalesced = {}, {}, 0, 0
    state.revision = state.revision + 1 -- Receipt watermark intentionally survives reset.
end

-- Pure desktop geometry shared by placement, dragging and portable layout checks.
function Agent.clampWindow(x, y, width, height, desktopWidth, desktopHeight)
    return math.max(0, math.min(x, desktopWidth - width)),
        math.max(0, math.min(y, desktopHeight - height))
end

-- Historical multi-window geometry remains for portable fixtures. Live
-- workstationLayout below always requests only the Main CLI.
function Agent.windowLayout(width, height, count)
    count = math.max(1, math.min(8, math.floor(count or 1)))
    local windows = {}
    if width &lt; 760 or height &lt; 340 then
        local stack = math.min((count - 1) * 14, 84, math.max(0, height - 220))
        local inset = count &gt; 1 and math.min(6, math.floor(width / 40)) or 0
        windows[1] = { x = inset, y = stack, width = width - inset * 2, height = height - stack }
        for index = 2, count do
            windows[index] = { x = ((index - 2) % 3) * inset, y = math.min((index - 2) * 14, stack),
                width = width - inset * 2, height = math.min(300, height - stack) }
        end
    else
        local mainWidth = math.min(1020, math.floor(width * (count == 1 and 0.84 or 0.74)))
        local mainHeight = math.min(680, math.floor(height * 0.86))
        windows[1] = { x = count == 1 and math.floor((width - mainWidth) / 2) or math.floor(width * 0.045),
            y = count == 1 and math.floor((height - mainHeight) / 2) or height - mainHeight - 8,
            width = mainWidth, height = mainHeight }
        local anchors = { {1, 0}, {0.04, 0.03}, {0.88, 0.8}, {0.18, 0.7},
            {0.72, 0.18}, {0.4, 0.02}, {0.97, 0.5} }
        local secondaryWidth, secondaryHeight = math.min(540, math.floor(width * 0.56)), math.min(330, math.floor(height * 0.72))
        for index = 2, count do
            windows[index] = { x = math.floor((width - secondaryWidth) * anchors[index - 1][1]),
                y = math.floor((height - secondaryHeight) * anchors[index - 1][2]),
                width = secondaryWidth, height = secondaryHeight }
        end
    end
    return windows
end

-- Fixed readable typography; no sidebar or permanently reserved shop column.
function Agent.layout(width, height, count)
    local narrow, short = width &lt; 960, height &lt; 470
    local top, footer, gap = 8, 44, 8
    local desktopWidth, desktopHeight = math.max(1, width - 16), math.max(1, height - top - footer - gap)
    return { narrow = narrow, short = short, explorer = 0, shop = 0,
        top = top, footer = footer, gap = gap, x = gap,
        width = desktopWidth, height = desktopHeight,
        windows = Agent.windowLayout(desktopWidth, desktopHeight, count) }
end

-- Fixed right shop; preserve a readable virtual CLI on physically narrow screens.
function Agent.workstationLayout(width,height,_count)
    local shopWidth=width&gt;=960 and 288 or width&gt;=680 and 224 or 176
    local viewportWidth=math.max(1,width-shopWidth-24)
    local canvasWidth=math.max(320,viewportWidth)
    local reserve=height&lt;500 and 112 or 148
    local spec=Agent.layout(canvasWidth+16,height-reserve,1)
    spec.x,spec.top,spec.width,spec.height=0,0,canvasWidth,height
    spec.viewportWidth=viewportWidth
    -- Initial composition keeps space for the shop; dragging uses the full root.
    spec.dragWidth=math.max(320,width)
    spec.windows[1].width=math.min(canvasWidth,math.max(320,math.min(1040,math.floor(canvasWidth*0.88))))
    spec.windows[1].x=math.floor((canvasWidth-spec.windows[1].width)/2)
    spec.store={x=math.max(0,width-shopWidth-8),y=8,width=shopWidth,height=math.max(1,height-60)}
    return spec
end

return Agent
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000035">
        <Properties>
          <string name="Name">Balance</string>
          <ProtectedString name="Source">--!nonstrict
-- Game economy, not a scientific model of neural-network performance.
local EMBEDDING_DIM = 4
-- Original costs below are frozen for pre13 Chip accounting; new prices follow.
local NODES = {
    {id="boot",name="New boot",cost=1,parents={},column=2,row=0,cash=1.10,description="Cash +10%"},
    {id="tokens",name="Token craft",cost=2,parents={"boot"},column=0,row=1,cash=1.25,description="Cash +25%"},
    {id="agents",name="Agent link",cost=2,parents={"boot"},column=1,row=1,speed=1.15,description="Agent speed +15%"},
    {id="focus",name="Auto focus",cost=2,parents={"boot"},column=3,row=1,auto=5,description="Auto check / max 5"},
    {id="cache",name="Auto sell",cost=4,parents={"tokens"},column=0,row=2,autosell=true,description="Sell full context"},
    {id="swarm",name="Agent swarm",cost=4,parents={"agents"},column=1,row=2,collect=1.5,description="Fragments x1.5"},
    {id="context",name="Chip memory",cost=4,parents={"focus"},column=2,row=2,chip=.01,description="Per Chip +1% cash"},
    {id="focus10",icon="focus",name="Auto focus II",cost=8,parents={"focus"},column=3,row=2,auto=10,description="Max streak: 10"},
    {id="core",name="Ascended core",cost=8,parents={"cache","swarm","context"},column=1,row=3,cash=2,description="Cash x2"},
    {id="focus15",icon="focus",name="Auto focus III",cost=20,parents={"focus10"},column=3,row=3,auto=15,description="Max streak: 15"},
    {id="fortune",icon="tokens",name="Golden output",cost=20,parents={"core"},column=0,row=4,cash=1.5,description="Cash +50%"},
    {id="overclock",icon="agents",name="Overclock",cost=20,parents={"core"},column=1,row=4,speed=1.25,description="Agent speed +25%"},
    {id="memory",icon="context",name="Chip memory II",cost=20,parents={"core"},column=2,row=4,chip=.02,description="Per Chip +2% cash"},
    {id="focus20",icon="focus",name="Auto focus IV",cost=50,parents={"focus15"},column=3,row=4,auto=20,description="Max streak: 20"},
    {id="fortune2",icon="tokens",name="Golden output II",cost=75,parents={"fortune"},column=0,row=5,cash=2,description="Cash x2"},
    {id="swarm2",icon="swarm",name="Magnetic swarm",cost=50,parents={"overclock"},column=1,row=5,collect=2,description="Fragments x2"},
    {id="memory2",icon="context",name="Chip memory III",cost=75,parents={"memory"},column=2,row=5,chip=.04,description="Per Chip +4% cash"},
    {id="focus25",icon="focus",name="Auto focus V",cost=125,parents={"focus20"},column=3,row=5,auto=25,description="Max streak: 25"},
    {id="mastery",icon="core",name="Studio mastery",cost=250,parents={"fortune2","swarm2","memory2"},column=1,row=6,cash=2,speed=1.25,collect=3,description="Cash x2 / speed +25%"},
    {id="focus30",icon="focus",name="Auto focus VI",cost=300,parents={"focus25"},column=3,row=6,auto=30,description="Max streak: 30"},
    {id="focus35",icon="focus",name="Streak mastery I",cost=600,parents={"focus30"},column=3,row=7,auto=35,description="Max streak: 35"},
    {id="focus40",icon="focus",name="Streak mastery II",cost=1250,parents={"focus35"},column=3,row=8,auto=40,description="Max streak: 40"},
    {id="focus50",icon="focus",name="Streak mastery III",cost=2500,parents={"focus40"},column=3,row=9,auto=50,description="Max streak: 50"},
    {id="luck",icon="core",name="Lucky tokens I",cost=2,parents={"boot"},column=4,row=1,luck=2,description="Special odds x2\nNew drafts"},
    {id="luck2",icon="core",name="Lucky tokens II",cost=8,parents={"luck"},column=4,row=2,luck=3,description="Special odds x3\nNew drafts"},
    {id="luck3",icon="core",name="Lucky tokens III",cost=30,parents={"luck2"},column=4,row=3,luck=4,description="Special odds x4\nNew drafts"},
    {id="luck4",icon="core",name="Lucky tokens IV",cost=100,parents={"luck3"},column=4,row=4,luck=5,description="Special odds x5\nNew drafts"},
}
local TREE_COSTS={boot=1,tokens=3,agents=3,focus=3,cache=10,swarm=10,context=10,
    focus10=10,core=30,focus15=30,fortune=75,overclock=75,memory=75,focus20=75,
    fortune2=150,swarm2=150,memory2=150,focus25=150,mastery=400,focus30=400,
    focus35=800,focus40=1600,focus50=3200,luck=3,luck2=10,luck3=50,luck4=200}
for _,node in ipairs(NODES) do node.legacyCost=node.cost;node.cost=TREE_COSTS[node.id] end

-- New branches have no historical debit: older schemas cannot own them.
local EXPANSION={
    {id="cash1",icon="tokens",name="Token forge I",cost=5,parents={"tokens"},cash=1.15,description="Cash +15%"},
