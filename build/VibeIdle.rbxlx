setPage=function(nextPage,animate,internal)
    if onboarding:blocks() and not internal then return end
    if uiMotion:busy() and not internal then return end
    if prestigeTransition.active and not internal then return end
    if nextPage=="Tools" and not RunService:IsStudio() then return end
    if not internal and nextPage~=page and animate~=false then
        return uiMotion:begin(function() setPage(nextPage,false,true) end)
    end
    local previous=page
    finishPageEntrance()
    page=nextPage
    tickShopPress(0)
    for _,entry in ipairs(iconHovers) do entry.pointer=nil;StoreIcon.setHovered(entry.icon,false) end
    if page~="CLI" then floatingWords:clear() end
    local main=page=="CLI"
    desktop.Visible,store.Visible,guide.Visible=main,main,page=="Guide"
    featureDock.Visible,moneyHUD.Visible,footer.Visible=main,main,main
    dancers.layer.Visible=main
    content.BackgroundTransparency=main and 1 or 0
    content.BackgroundColor3=Theme.pixelColors.base
    if returnButton then returnButton.Visible=not main end
    if studioPage then studioPage.Visible=page=="Tools" end
    agentLab.frame.Visible=page=="Lab";agentLab:update(current,progression.pending~=nil,progression.message.Text)
    cardPage:setOpen(page=="Cards")
    robuxShop:setOpen(page=="Robux")
    progression.frame.Visible=page=="Prestige" or page=="Tree"
    if progression.frame.Visible then progression:setMode(page) end
    terminal:setSuspended(page~="CLI");desk:setSuspended(page~="CLI")
    skillCheck:setSuspended(page~="CLI")
    if layout then layout() end
    for _,control in ipairs({mainButton,toolsButton,guideButton}) do
        local selected=(control==mainButton and page=="CLI") or (control==guideButton and page=="Guide")
            or (control==toolsButton and page=="Tools")
        control.TextColor3=control==mainButton and c.terminal or (selected and c.accent or c.text)
        control.PanelBorder.Color=c.black
    end
    local target=page=="Guide" and motionButton or page=="Lab" and agentLab.cards[1].frame or terminal.input
    if page=="Tools" then target=studioTools and (studioTools:GetAttribute("Expanded") and studioTools.grant or studioTools.Disclosure) or toolsButton
    elseif page=="Cards" then
        target=returnButton or mainButton
        for _,card in ipairs(Balance.AGENT_CARDS) do if cardPage.inventory[card.id].frame.Selectable then target=cardPage.inventory[card.id].frame;break end end
    elseif page=="Robux" then target=robuxShop.entries.forever.buy.Selectable and robuxShop.entries.forever.buy or robuxShop.check
    elseif page=="Prestige" then target=progression.ascend.Selectable and progression.ascend or returnButton
    elseif page=="Tree" then
        target=returnButton or mainButton
        for _,node in ipairs(Balance.PRESTIGE_NODES) do
            if progression.nodes[node.id].buy.Selectable then target=progression.nodes[node.id].buy;break end
        end
    end
    focus(target)
end
uiMotion.onSettled=function()
    terminal:refreshControls()
    if page=="CLI" and not onboarding:blocks() and not terminal.blocked then terminal:focusInput() end
end
mainButton=button(footer,"Main CLI",UDim2.fromOffset(4,2),UDim2.fromOffset(128,40),function()
    if prestigeTransition.active then return end
    if not footer.Visible then return end
    audio:click("back")
    setPage("CLI");desk:focus(1);terminal:focusInput()
end)
mainButton.Name="MainCLIShortcut"
mainButton.BackgroundColor3=c.mint
mainButton.TextColor3=c.terminal
toolsButton=button(footer,"Studio tools",UDim2.fromOffset(140,2),UDim2.fromOffset(156,40),function(input)
    if not footer.Visible or not RunService:IsStudio() or not terminal:canAutomate() or desk.drag then return end
    if input and not containsPointer(footer,input) then return end
    audio:click("navigate")
    setPage(page=="Tools" and "CLI" or "Tools")
end)
toolsButton.Name="StudioToolsShortcut"
toolsButton.Visible=RunService:IsStudio()
toolsButton.Active,toolsButton.Selectable=RunService:IsStudio(),RunService:IsStudio()
guideButton=button(footer,"Guide",UDim2.fromOffset(190,2),UDim2.fromOffset(70,40),function()
    if prestigeTransition.active then return end
    if footer.Visible then audio:click("navigate");setPage("Guide") end
end)
returnButton=Theme.pixelButton(root,"&lt; MAIN CLI",UDim2.fromOffset(12,8),UDim2.fromOffset(160,40),function(input)
    if prestigeTransition.active then return end
    if not returnButton.Visible or GuiService.MenuIsOpen or not terminal.windowFocused or desk.drag then return end
    if input and not containsPointer(returnButton,input) then return end
    audio:click("back")
    setPage("CLI");desk:focus(1);terminal:focusInput()
end)
returnButton.Name="ReturnCLI";returnButton.ZIndex=16;returnButton.Visible=false
setPage("CLI",false,true)
prestigeTransition.onCovered=function()
    progression.presentationPaused=false
    cardPage.presentationPaused=false
    setPage("CLI",false,true)
    desk:focus(1)
end
prestigeTransition.onStarted=function(id,reduced) audio:startVortex(id,reduced) end
prestigeTransition.onStopped=function() audio:stopVortex() end
prestigeTransition.onFinished=function()
    audio:stopVortex()
    progression.presentationPaused=false
    cardPage.presentationPaused=false
    terminal.presentationPaused=false
    desk:setSuspended(page~="CLI");skillCheck:setSuspended(page~="CLI")
    if layout then layout() end
    terminal:refreshInput();terminal:refreshControls()
    refreshShopQuotes()
    if not terminal.blocked then terminal:focusInput() end
    focus(terminal.input)
end
progression.onConfirmed=function(reply,data,pending)
    if reply.action~="prestige" or data.prestigeCount~=pending.beforeCount+1 or data.blocked then return end
    uiMotion:cancel()
    finishPageEntrance();backgroundPointer=nil;terminal.presentationPaused=true;terminal:blur()
    progression.presentationPaused=true
    cardPage.presentationPaused=true
    GuiService.SelectedObject=nil;desk:setSuspended(true)
    if not prestigeTransition:start(pending.id,terminal.reduced) then
        terminal.presentationPaused=false;progression.presentationPaused=false;cardPage.presentationPaused=false;desk:setSuspended(page~="CLI")
    end
end
local function disconnected(message)
    uiMotion:cancel()
    connectionError=message;current=nil;terminal.blocked=true;terminal:blur()
    onboarding.error=message;onboarding:update(nil)
    prestigeTransition:finish()
    terminal.hint.Text=message;storeCaption.Text=message
    reconnectButton.Visible=true;storage.Text="OFFLINE / UI v"..Balance.BUILD_VERSION
    for _,card in pairs(cards) do card.status.Text="" end
    refreshShopQuotes()
    layoutShop()
end
local function refresh(data)
    if type(data)~="table" then disconnected("Session data unavailable. Reconnect.");return end
    if data.buildVersion~=Balance.BUILD_VERSION or data.schemaVersion~=Balance.SCHEMA_VERSION then
        disconnected(RunService:IsStudio() and "Game updated. Stop and restart Play." or "Game updated. Rejoin to reconnect.")
        return
    end
    local profile,reason=State.fromSnapshot(data,Balance)
    if not profile then
        warn("[VibeIdle] Rejected incomplete snapshot: "..tostring(reason))
        disconnected("Session data unavailable. Reconnect.");return
    end
    if type(data.snapshotSequence)~="number" or data.snapshotSequence%1~=0 or data.snapshotSequence&lt;1 or data.snapshotSequence&gt;Balance.MAX_CREDITS then
        disconnected("Session data unavailable. Reconnect.");return
    end
    if data.snapshotSequence&lt;=lastSnapshotSequence then return end
    lastSnapshotSequence=data.snapshotSequence
    current=data
    terminal.billingBusy=data.commerce and data.commerce.busy or false
    local tokenWeights=PromptSession.tokenWeights(profile,Balance)
    for index,tier in ipairs(Balance.SPECIAL_TOKENS) do
        rarityRows[index].Text=string.format("%s / %g%% per token / x%g",tier.rarity,tokenWeights[index]/100,tier.multiplier)
    end
    local sequence=data.upgradeSequence
    if type(sequence)=="number" and sequence%1==0 and sequence&gt;=0 and sequence&lt;=Balance.MAX_CREDITS then
        purchaseSequence=math.max(purchaseSequence,sequence)
    end
    if purchasePending then
        local reply=data.upgradeReply
        if (type(reply)=="table" and reply.requestId==purchasePending.requestId and reply.action==purchasePending.action
            and reply.quantity==purchasePending.quantity) or data.upgradeSyncId==purchasePending.requestId then purchasePending=nil end
    end
    moneyValue.Text=Theme.money(data.credits);moneyShadow.Text=moneyValue.Text;chipsValue.Text=Theme.number(data.chips).." Chips";fitMoney()
    if data.skillCheck then
        if skillTestControls["skill_initial"] then skillTestControls.skill_initial.Text=string.format("Initial spin / %.2f rev/s",data.skillCheck.initialRps) end
        if skillTestControls["skill_acceleration"] then skillTestControls.skill_acceleration.Text=string.format("Per hit / x%.3f",data.skillCheck.growth) end
    end
    if RunService:IsStudio() and data.studioTuning then
        for _,control in ipairs(Tuning.controls) do
            local item=skillTestControls[control.action]
            if item then item.Text=string.format("%s / %g %s +",control.label,data.studioTuning[control.key],control.unit) end
        end
        streakTimeout.Text=string.format("STREAK TIMEOUT / %g seconds (0 disables expiry). Only accepted skill checks refresh it. Sending and automatic typing do not.",data.studioTuning.streakTimeout)
        spawnChance.Text=string.format("RANDOM VISITORS / 5-10 active seconds; 24-second lifetime; maximum %g. Independent of skill checks. Legacy spawn-chance tool is retired.",data.studioTuning.spawnCapacity)
    end
    connectionError=nil
    refreshShopQuotes()
    desk:update(data)
    nextGoal.Text=data.message or "Global upgrades increase your next prompt payout."
    local saveStatus=data.persistence and data.persistence.status
    storage.Text=(data.storageMode=="MEMORY" and "SESSION ONLY" or saveStatus=="delayed" and "SAVE DELAYED" or "CLOUD ON").." / v"..data.buildVersion
    saveNote.Text=data.storageMode=="MEMORY" and "LOCAL TEST / Session-only progress. Published games use cloud saving."
        or saveStatus=="delayed" and "SAVE DELAYED / Keep this session open while cloud saving retries. If the data lease expires, progression pauses."
        or "CLOUD SAVE ON / Autosaves every 60 seconds and on exit. Money, upgrades, cards, fragments, Chips and tutorial preference persist. Unsold tokens and streak are session-only."
    terminal:update(data)
    skillCheck:update(data)
    progression:update(data,terminal.composer.draft and terminal.composer.draft.id)
    agentLab:update(data,progression.pending~=nil,progression.message.Text)
    cardPage:update(data,progression.pending~=nil)
    robuxShop:update(data,progression.pending~=nil)
    if page=="Cards" and UserInputService.GamepadEnabled then
        local selected=GuiService.SelectedObject
        if not selected or (selected:IsDescendantOf(cardPage.frame) and (not selected.Selectable or not selected.Visible)) then
            focus(cardPage.slots[1].frame.Selectable and cardPage.slots[1].frame or returnButton)
        end
    end
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(progression.frame)
        and not GuiService.SelectedObject.Selectable then focus(returnButton) end
    dancers:update(data)
    onboarding.error=nil;onboarding:update(data)
    reconnectButton.Visible=true
    storeCaption.Text=data.blocked and (data.message or "Session paused. Rejoin to reconnect.")
        or "Three upgrades: token value, agent count and context."
    layoutShop()
end
layout=function()
    if prestigeTransition.destroyed or (prestigeTransition.active and not prestigeTransition.covered) then return end
    finishPageEntrance()
    local spec=Agent.workstationLayout(root.AbsoluteSize.X,root.AbsoluteSize.Y,desk.count)
    local naturalWidth=#featureDefinitions*76-12
    local width=math.min(naturalWidth,math.max(1,spec.viewportWidth))
    moneyHUD.Size=UDim2.fromOffset(math.min(480,math.max(1,root.AbsoluteSize.X-24)),120);fitMoney()
    local separateRow=moneyHUD.AbsoluteSize.X+width+40&gt;spec.viewportWidth
    local shortcutY=root.AbsoluteSize.Y&lt;500 and 134 or 146
    featureDock.Position=UDim2.fromOffset(separateRow and math.max(0,math.floor((spec.viewportWidth-width)/2))
        or math.max(moneyHUD.AbsoluteSize.X+28,math.floor((spec.viewportWidth-width)/2)),separateRow and shortcutY or 8)
    featureDock.Size=UDim2.fromOffset(width,width&lt;naturalWidth and 70 or 64)
    featureDock.CanvasSize=UDim2.fromOffset(naturalWidth,0)
    featureDock.ScrollingEnabled=width&lt;naturalWidth;featureDock.ScrollBarThickness=width&lt;naturalWidth and 5 or 0
    local previous=featureDock.CanvasPosition or Vector2.new(0,0)
    featureDock.CanvasPosition=Vector2.new(math.max(0,math.min(previous.X,naturalWidth-width)),0)
    for index,definition in ipairs(featureDefinitions) do
        featureButtons[definition[1]].button.Position=UDim2.fromOffset((index-1)*76,0)
    end
    skillRoot.Size=UDim2.fromOffset(spec.viewportWidth,root.AbsoluteSize.Y)
    local compactHeight=root.AbsoluteSize.Y&lt;500
    local reserve=page=="CLI" and (compactHeight and 112 or 148) or 0
    terminal.bottomClearance=reserve+44
    skillCheck:layout(reserve,math.min(compactHeight and 84 or 120,math.max(1,math.floor((spec.viewportWidth-32)/3))))
    content.Position,content.Size=UDim2.fromOffset(0,0),UDim2.fromOffset(root.AbsoluteSize.X,root.AbsoluteSize.Y)
    spec.headerHeight=math.max(moneyHUD.Position.Y.Offset+moneyHUD.Size.Y.Offset,
        featureDock.Position.Y.Offset+featureDock.Size.Y.Offset)+8
    local geometry=spec.windows[1]
    geometry.height=math.max(compactHeight and 220 or 300,math.min(720,root.AbsoluteSize.Y-spec.headerHeight-(compactHeight and 112 or 148)-52))
    geometry.x,geometry.y=math.floor((spec.width-geometry.width)/2),spec.headerHeight
    desk:layout(spec)
    local fullWidth=root.AbsoluteSize.X
    agentLab.frame.Position,agentLab.frame.Size=UDim2.fromOffset(8,52),UDim2.new(1,-16,1,-60)
    agentLab:layout()
    cardPage:layout(fullWidth,root.AbsoluteSize.Y,52)
    robuxShop:layout(fullWidth,root.AbsoluteSize.Y,52)
    progression:layout(fullWidth,root.AbsoluteSize.Y,52)
    guide.Position,guide.Size=UDim2.fromOffset(8,52),UDim2.new(1,-16,1,-60)
    if studioPage then
        studioPage.Position=UDim2.fromOffset(8,52)
        studioPage.Size=UDim2.fromOffset(fullWidth-16,math.max(1,root.AbsoluteSize.Y-60))
        if studioRelayout then studioRelayout() end
    end
    local shopHeight=math.min(spec.store.height,64+24+3*(spec.store.width&lt;200 and 184 or spec.store.width&lt;240 and 168 or 152)+24+8)
    local shopTop=math.max(8,math.floor((root.AbsoluteSize.Y-44-shopHeight)/2))
    if spec.store.x&lt;moneyHUD.Position.X.Offset+moneyHUD.AbsoluteSize.X+8 then
        shopTop=math.max(shopTop,moneyHUD.Position.Y.Offset+moneyHUD.AbsoluteSize.Y+8)
    end
    shopHeight=math.min(shopHeight,math.max(1,root.AbsoluteSize.Y-44-shopTop-8))
    store.Position,store.Size=UDim2.fromOffset(spec.store.x,shopTop),UDim2.fromOffset(spec.store.width,shopHeight)
    layoutShop()
    local compact=root.AbsoluteSize.X&lt;680
    storage.Visible=not compact
    local offset=0
    local fractions=RunService:IsStudio() and {0.30,0.47,0.23} or {0.5,0,0.5}
    local desktopX=4
    for index,control in ipairs({mainButton,toolsButton,guideButton}) do
        if control.Visible then
            local controlWidth=({128,156,70})[index]
            control.Position=compact and UDim2.new(offset,4,0,2) or UDim2.fromOffset(desktopX,2)
            control.Size=compact and UDim2.new(fractions[index],-8,0,40) or UDim2.fromOffset(controlWidth,40)
            control.TextSize=control==toolsButton and 11 or (compact and 11 or control==mainButton and 12 or 14)
            offset=offset+fractions[index];desktopX=desktopX+controlWidth+8
        end
    end
end
connect(shop:GetPropertyChangedSignal("AbsoluteSize"),layoutShop)
connect(root:GetPropertyChangedSignal("AbsoluteSize"),layout)
connect(UserInputService.LastInputTypeChanged,function(inputType)
    if inputType==Enum.UserInputType.Gamepad1 and not GuiService.SelectedObject then setPage(page) end
end)
layout()
if RunService:IsStudio() then
    studioPage=create("Frame",content,{Name="StudioToolsPage",BackgroundColor3=c.panel,BorderSizePixel=0,Visible=false})
    Theme.outline(studioPage).Color=c.line
    text(studioPage,"STUDIO TOOLS",16,c.accent,UDim2.fromOffset(12,4),UDim2.new(1,-24,0,44))
    studioScroll=create("ScrollingFrame",studioPage,{Name="ToolList",BackgroundTransparency=1,BorderSizePixel=0,
        Position=UDim2.fromOffset(12,52),Size=UDim2.new(1,-24,1,-64),CanvasSize=UDim2.fromOffset(0,0),
        ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=5,ScrollBarImageColor3=c.line})
    local tools=create("Frame",studioScroll,{Name="StudioTools",BackgroundTransparency=1,Size=UDim2.new(1,-8,0,44)})
    studioTools=tools
    local expanded,controls,disclosure=true,{},nil
    local toolRows={}
    local function canUseTools(input)
        return page=="Tools" and studioPage.Visible and terminal:canAutomate() and not desk.drag
            and (not input or containsPointer(studioScroll,input))
    end
    disclosure=button(tools,"- Studio tools",UDim2.fromOffset(0,0),UDim2.new(1,0,0,44),function(input)
        if not canUseTools(input) then return end
        audio:click("select")
        expanded=not expanded
        tools:SetAttribute("Expanded",expanded)
        studioRelayout()
        disclosure.Text=expanded and "- Studio tools" or "+ Studio tools"
        for _,control in ipairs(controls) do control.Visible=expanded end
        if not expanded then focus(disclosure) end
    end)
    disclosure.Name="Disclosure"
    local devRemote=remotes:FindFirstChild("StudioCommand")
    local specs={{"grant","+$1 billion"},{"reset","Reset session"},{"tuning_reset","Restore tuning defaults"}}
    for _,control in ipairs(Tuning.controls) do specs[#specs+1]={control.action,string.format("%s / %g %s +",control.label,control.values[1],control.unit),control} end
    for index,spec in ipairs(specs) do
        local action=spec[1]
        local item=button(tools,spec[2],UDim2.fromOffset(0,index*48),UDim2.new(1,spec[3] and -48 or 0,0,44),function(input)
            if not expanded or not canUseTools(input) then return end
            devRemote=devRemote or remotes:FindFirstChild("StudioCommand")
            if devRemote then audio:click("select");devRemote:FireServer(action) end
        end)
        item.Name=action;item.TextSize=11;item.TextWrapped=true;item.Visible=true
        toolRows[index]={item=item}
        controls[#controls+1]=item;skillTestControls[action]=item
        if spec[3] then
            local previous=button(tools,"-",UDim2.new(1,-44,0,index*48),UDim2.fromOffset(44,44),function(input)
                if not expanded or not canUseTools(input) then return end
                devRemote=devRemote or remotes:FindFirstChild("StudioCommand")
                if devRemote then audio:click("select");devRemote:FireServer(action,-1) end
            end)
            previous.Name=action.."_Previous";previous.Visible=true;controls[#controls+1]=previous
            toolRows[index].previous=previous
        end
    end
    studioRelayout=function()
        local rowHeight=studioScroll.AbsoluteSize.X&lt;280 and 120 or 72
        tools.Size=UDim2.new(1,-8,0,expanded and (44+#toolRows*rowHeight) or 44)
        for index,row in ipairs(toolRows) do
            local y=44+(index-1)*rowHeight
            row.item.Position=UDim2.fromOffset(0,y)
            row.item.Size=UDim2.new(1,row.previous and -48 or 0,0,rowHeight-4)
            if row.previous then row.previous.Position=UDim2.new(1,-44,0,y+math.floor((rowHeight-44)/2)) end
        end
        studioScroll.CanvasSize=UDim2.fromOffset(0,tools.Size.Y.Offset+12)
    end
    tools:SetAttribute("Expanded",true)
    layout()
end
connect(stateUpdate.OnClientEvent,function(data)
    local ok,reason=pcall(refresh,data)
    if not ok then
        warn("[VibeIdle] Snapshot could not be rendered: "..tostring(reason))
        disconnected("Could not open session. Reconnect.")
    end
end)
for _,label in ipairs({terminal.hint,terminal.stateLabel,agentLab.message,agentLab.familyTitle,agentLab.familyTitleShadow,
    cardPage.message,cardPage.deckTitle,cardPage.deckTitleShadow,cardPage.inventoryTitle,cardPage.inventoryTitleShadow,
    progression.message,robuxShop.message,onboarding.title,onboarding.copy,onboarding.status}) do uiMotion:watchText(label) end
for _,entry in ipairs(agentLab.recipes) do uiMotion:watchText(entry.status);uiMotion:watchText(entry.statusShadow) end
for _,entry in pairs(robuxShop.entries) do uiMotion:watchText(entry.status);uiMotion:watchText(entry.price) end
for _,control in ipairs({terminal.send,mainButton,toolsButton,guideButton,returnButton,quantity,reconnectButton,replayTutorial,
    motionButton,muteButton,agentLab.openCards,cardPage.remove,progression.ascend,progression.centerButton,robuxShop.check,
    onboarding.play,onboarding.learn,onboarding.skip}) do uiMotion:watchButton(control) end
for _,definition in ipairs(featureDefinitions) do uiMotion:watchButton(featureButtons[definition[1]].button) end
for _,entry in ipairs(agentLab.recipes) do uiMotion:watchButton(entry.buy) end
for _,entry in pairs(robuxShop.entries) do uiMotion:watchButton(entry.buy) end
for _,entry in ipairs(agentLab.cards) do uiMotion:watchButton(entry.frame) end
for _,entry in ipairs(cardPage.slots) do uiMotion:watchButton(entry.frame) end
-- Retry only the initial handshake, never a possibly paid prompt.
reconnect=function()
    handshakeTime,attempt,connectionError=0,1,nil
    storeCaption.Text="Opening session..."
    command:FireServer("sync")
    progression:sync()
    if purchasePending then command:FireServer("upgrade_sync",{requestId=purchasePending.requestId}) end
end
reconnect()
terminal.onTick=function(dt)
    if current and terminal.composer.draft and os.clock()-analyticsAt&gt;=15 then
        analyticsAt=os.clock();analyticsSequence=analyticsSequence+1
        command:FireServer("analytics_pulse",{requestId=analyticsSequence,button=analyticsButton,enter=analyticsEnter,
            focused=terminal:canAutomate(),page=onboarding:blocks() and (onboarding.mode=="Start" and "Start" or "Tutorial") or page})
    end
    local focused=UserInputService:GetFocusedTextBox()
    local presenting=prestigeTransition.active
    local presentationPaused=not terminal.windowFocused or GuiService.MenuIsOpen
        or (focused and focused~=terminal.input) or terminal:hasModifier()
    uiMotion:tick(dt,presentationPaused or presenting)
    onboarding:tick(dt)
    prestigeTransition:tick(dt,presentationPaused)
    audio:vortexFrame(prestigeTransition.age or 0,prestigeTransition.reduced,prestigeTransition.active,presentationPaused)
    if presenting then
        audio:tick(dt,current and current.stats and current.stats.streak or 0,current and current.streakDivisor or Balance.STREAK_BASE_DIVISOR)
        return
    end
    tickShopPurchase(dt)
    tickShopPress(dt)
    for _,entry in ipairs(iconHovers) do refreshIconHover(entry) end
    skillCheck:tick(dt)
    progression:tick(dt)
    cardPage:setPending(progression.pending~=nil,progression.message.Text)
    robuxShop.progressionPending=progression.pending~=nil;robuxShop:tick(dt)
    agentLab:setPending(progression.pending~=nil,progression.message.Text)
    desk:tickMascots(dt*(terminal.tuning and terminal.tuning.danceScale or 1),terminal:canEdit())
    dancers:tick(dt)
    floatingWords:tick(dt)
    audio:tick(dt,current and current.stats and current.stats.streak or 0,current and current.streakDivisor or Balance.STREAK_BASE_DIVISOR)
    if current and terminal.composer.draft then return end
    handshakeTime=handshakeTime+dt
    if attempt&lt;#retryAt and handshakeTime&gt;=retryAt[attempt+1] then
        attempt=attempt+1;command:FireServer("sync")
    end
    if handshakeTime&gt;=14 then
        terminal.hint.Text=connectionError or "Prompt session unavailable. Open Guide to reconnect."
        if not current then
            storeCaption.Text=connectionError or "Server unavailable. Open Guide to reconnect."
            storage.Text="OFFLINE"
            reconnectButton.Visible=true
            for _,card in pairs(cards) do card.buy.Text="Reconnect to buy" end
        end
    end
end
gui.Destroying:Connect(function()
    uiMotion:destroy()
    onboarding:destroy();terminal.onSaleConfirmed=nil
    prestigeTransition:destroy();terminal.presentationPaused=false
    progression.presentationPaused=false
    finishPageEntrance()
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then GuiService.SelectedObject=nil end
    robuxShop:destroy();cardPage:destroy();progression:destroy();agentLab:destroy();floatingWords:destroy();dancers:destroy();audio:destroy();skillCheck:destroy();desk:destroy();terminal:destroy()
    for _,connection in ipairs(connections) do connection:Disconnect() end
    skillGui:Destroy();streakGui:Destroy();backdrop:Destroy()
end)
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000083">
          <Properties>
            <string name="Name">CardsPage</string>
            <ProtectedString name="Source">--!nonstrict
local Theme=require(script.Parent.DeskTheme)
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cards=require(Shared.AgentCards)
local c=Theme.colors
local Page={};Page.__index=Page
local CARD_W,CARD_H,STEP,ROW_H,DECK_Y,GRID_Y=192,304,208,320,128,588
local DECK_WIDTH=8*STEP
local function contains(object,point)
    local p,s=object.AbsolutePosition,object.AbsoluteSize
    return point.X&gt;=p.X and point.X&lt;p.X+s.X and point.Y&gt;=p.Y and point.Y&lt;p.Y+s.Y
end
local function lock(parent)
    local group=Theme.create("Frame",parent,{Name="PixelLock",BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,Position=UDim2.fromOffset(80,94),Size=UDim2.fromOffset(32,40)})
    for y,row in ipairs({"..####..",".##..##.",".#....#.",".#....#.","########","########","###..###","###..###","########",".######."}) do
        local x=1
        while x&lt;=#row do
            if row:sub(x,x)=="#" then
                local start=x
                repeat x=x+1 until x&gt;#row or row:sub(x,x)~="#"
                Theme.create("Frame",group,{BorderSizePixel=0,BackgroundColor3=c.muted,Active=false,Selectable=false,
                    Position=UDim2.fromOffset((start-1)*4,(y-1)*4),Size=UDim2.fromOffset((x-start)*4,4)})
            else x=x+1 end
        end
    end
    return group
end
local Visual=require(script.Parent.CollectionStyle)
local rect,panel,caption,cardView,styleCard=Visual.rect,Visual.panel,Visual.caption,Visual.cardView,Visual.styleCard
function Page.new(parent,balance,onChange)
    local self=setmetatable({balance=balance,onChange=onChange,slots={},inventory={},seenReply=0},Page)
    self.frame=Theme.create("Frame",parent,{Name="CardsPage",BackgroundColor3=Theme.pixelColors.base,BorderSizePixel=0,Active=true,Visible=false})
    Theme.pixelPanel(self.frame,"PixelPage",UDim2.fromOffset(0,0),UDim2.fromScale(1,1))
    self.backdrop=Theme.create("Frame",self.frame,{Name="CardsBackdrop",BackgroundColor3=Color3.fromRGB(25,22,30),
        BorderSizePixel=0,Active=false,Selectable=false,ClipsDescendants=true,Size=UDim2.fromScale(1,1)})
    self.stripes={}
    for _=1,256 do
        local stripe=rect(self.backdrop,"StripePixel",0,0,1,1,Color3.fromRGB(32,26,37))
        stripe.BackgroundTransparency=0.35;self.stripes[#self.stripes+1]=stripe
    end
    self.titleBadge=Theme.pixelPanel(self.frame,"CardsTab",UDim2.new(1,-180,0,8),UDim2.fromOffset(168,32),c.accent)
    self.titleBadge.ZIndex=3
    self.title=Theme.text(self.frame,"AGENT CARDS",14,c.terminal,UDim2.new(1,-180,0,8),UDim2.fromOffset(168,32))
    self.title.TextXAlignment=Enum.TextXAlignment.Center;self.title.ZIndex=4
    self.body=Theme.create("ScrollingFrame",self.frame,{Name="CardsContent",BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2,
        ClipsDescendants=true,Position=UDim2.fromOffset(8,48),Size=UDim2.new(1,-16,1,-128),
        CanvasSize=UDim2.fromOffset(0,600),ScrollingDirection=Enum.ScrollingDirection.Y,
        ScrollBarThickness=5,ScrollBarImageColor3=Theme.pixelColors.edge})
    self.deckPanel=panel(self.body,"DeckPanel",UDim2.fromOffset(0,76),UDim2.new(1,-8,0,440))
    self.inventoryPanel=panel(self.body,"InventoryPanel",UDim2.fromOffset(0,536),UDim2.new(1,-8,0,400))
    self.intro=caption(self.body,"SELECT A CARD.\nCHOOSE A FREE DECK SLOT.",14,c.ink,UDim2.fromOffset(8,0),UDim2.new(1,-16,0,64))
    self.deckTitle,self.deckTitleShadow=caption(self.body,"DECK / 1 OF 8",16,c.ink,UDim2.fromOffset(8,88),UDim2.new(1,-16,0,32))
    self.deck=Theme.create("ScrollingFrame",self.body,{Name="Deck",BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2,
        ClipsDescendants=true,Position=UDim2.fromOffset(12,DECK_Y),Size=UDim2.new(1,-24,0,320),
        CanvasSize=UDim2.fromOffset(DECK_WIDTH,0),ScrollingDirection=Enum.ScrollingDirection.X,
        ScrollBarThickness=5,ScrollBarImageColor3=c.accent})
    for index=1,balance.MAX_HIDDEN_LAYERS do
        local entry=cardView(self.deck,"Slot"..index)
        local button=entry.frame
        button.Position=UDim2.fromOffset(8+(index-1)*STEP,4)
        entry.name.Position=UDim2.fromOffset(40,8);entry.name.Size=UDim2.fromOffset(144,24);entry.name.TextSize=14
        entry.nameShadow.Position=UDim2.fromOffset(42,10);entry.nameShadow.Size=UDim2.fromOffset(144,24);entry.nameShadow.TextSize=14
        local plus=Theme.create("Frame",button,{Name="FreePosition",BackgroundTransparency=1,BorderSizePixel=0,
            Active=false,Selectable=false,Position=UDim2.fromOffset(80,100),Size=UDim2.fromOffset(32,32),ZIndex=4})
        for _,r in ipairs({{12,0,8,32},{0,12,32,8}}) do rect(plus,"PlusPixel",r[1],r[2],r[3],r[4],c.mint) end
        local number=Theme.text(button,string.format("%02d",index),14,c.muted,UDim2.fromOffset(8,8),UDim2.fromOffset(28,24))
        number.TextXAlignment=Enum.TextXAlignment.Center;number.ZIndex=4;number.Active=false;number.Selectable=false
        entry.lock,entry.plus=lock(button),plus;entry.lock.ZIndex=4
        self.slots[index]=entry
        button.Activated:Connect(function(input) self:slotPress(index,input) end)
    end
    self.remove,self.removeArt=Theme.pixelButton(self.body,"REMOVE",UDim2.fromOffset(16,464),UDim2.fromOffset(160,40),function(input)
        if not self.selectedSlot or not self:allowed(input,self.remove) then return end
        self.onChange("unequip_card",{slotIndex=self.selectedSlot})
    end)
    self.remove.Name="RemoveCard";self.remove.TextSize=14;self.remove.ZIndex=2;self.removeArt.label.TextSize=14
    self.inventoryTitle,self.inventoryTitleShadow=caption(self.body,"INVENTORY",16,c.ink,UDim2.fromOffset(8,548),UDim2.new(1,-16,0,32))
    for _,card in ipairs(balance.AGENT_CARDS) do
        local entry=cardView(self.body,card.id,card.id)
        local button=entry.frame
        entry.name.Text=card.name;entry.nameShadow.Text=card.name
        self.inventory[card.id]=entry
        button.Activated:Connect(function(input)
            if not self:allowed(input,button) or not self.data.cardOwned[card.id] or Cards.location(self.data,card.id,balance) then return end
            self.selectedCard,self.selectedSlot=card.id,nil;self.message.Text="Choose a free slot."
            if self.onSelect then self.onSelect() end
            self:render()
            for index=1,#self.data.layerSizes-2 do
                if not self.data.cardDeck[index] then
                    self.body.CanvasPosition=Vector2.new(0,math.max(0,math.min(DECK_Y,self.body.CanvasSize.Y.Offset-self.body.AbsoluteWindowSize.Y)))
                    self.deck.CanvasPosition=Vector2.new(math.max(0,math.min((index-1)*STEP,self.deck.CanvasSize.X.Offset-self.deck.AbsoluteWindowSize.X)),0)
                    if self.onFocusSlot then self.onFocusSlot(self.slots[index].frame) end
                    break
                end
            end
        end)
    end
    self.message=Theme.text(self.frame,"Select a card.",14,c.muted,UDim2.new(0,12,1,-72),UDim2.new(1,-24,0,64))
    self.message.Name="CardsMessage";self.message.ZIndex=4
    self.sizeConnection=self.body:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:layoutContent() end)
    self:render()
    return self
end
function Page:allowed(input,target,deck)
    if self.destroyed or not self.frame.Visible or not self.data or self.data.blocked or self.pending
        or (self.allowPointer and not self.allowPointer(input)) then return false end
    if input and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
        if not target.Visible or not contains(target,input.Position) or not contains(self.body,input.Position)
            or (deck and not contains(self.deck,input.Position)) then return false end
    end
    return true
end
function Page:slotPress(index,input)
    local entry=self.slots[index]
    if not self:allowed(input,entry.frame,true) then return end
    if index&gt;#self.data.layerSizes-2 then self.message.Text="Buy Agent count.";return end
    local id=self.data.cardDeck[index]
    if id then
        self.selectedCard,self.selectedSlot=nil,index;self.message.Text="REMOVE returns card."
    elseif self.selectedCard then self.onChange("equip_card",{slotIndex=index,cardId=self.selectedCard});return
    else self.message.Text="Select a card first." end
    if self.onSelect then self.onSelect() end
    self:render()
end
function Page:setOpen(value)
    self.frame.Visible=value;self.selectedCard,self.selectedSlot=nil,nil
    if value then self.message.Text="Select a card.";self:render() end
end
function Page:setPending(value,message)
    local text=value and (message and message:find("Reconnect",1,true) and "Use Reconnect to check." or "Waiting for server...") or nil
    if self.pending==value and self.pendingText==text then return end
    self.pending,self.pendingText=value,text
    if text then self.message.Text=text end
    if self.frame.Visible then self:render() end
end
function Page:update(data,pending)
    self.data=data;self.pending=pending
    if self.selectedCard and Cards.location(data,self.selectedCard,self.balance) then self.selectedCard=nil end
    if self.selectedSlot and not data.cardDeck[self.selectedSlot] then self.selectedSlot=nil end
    local reply=data.progressionReply
    if reply and reply.requestId&gt;self.seenReply and (reply.action=="equip_card" or reply.action=="unequip_card") then
        self.seenReply=reply.requestId;self.message.Text=reply.message
        if reply.ok then self.selectedCard,self.selectedSlot=nil,nil end
    elseif data.progressionSyncId and data.progressionSyncId&gt;self.seenReply and not pending then
        self.seenReply=data.progressionSyncId;self.message.Text="No change confirmed."
    end
    if self.frame.Visible then self:render() end
end
function Page:render()
    if not self.data then
        self.deckTitle.Text="DECK / --";self.inventoryTitle.Text="INVENTORY / --"
        for _,entry in ipairs(self.slots) do
            entry.frame.Active,entry.frame.Selectable=false,false
            entry.preview.frame.Visible,entry.plus.Visible,entry.lock.Visible=false,false,true
            entry.status.Text="LOCKED"
            styleCard(entry,nil,false)
        end
        for _,entry in pairs(self.inventory) do entry.frame.Visible=false;entry.frame.Active=false;entry.frame.Selectable=false end
        self.remove.Active,self.remove.Selectable=false,false
        self.deckTitleShadow.Text,self.inventoryTitleShadow.Text=self.deckTitle.Text,self.inventoryTitle.Text
        self.message.Text="Reconnect to load.";self:layoutContent();return
    end
    local count=#self.data.layerSizes-2
    self.deckTitle.Text=string.format("DECK / %d OF 8",count)
    for index,entry in ipairs(self.slots) do
        local unlocked=index&lt;=count
        local id=self.data.cardDeck[index]
        local card=id and Cards.definition(id,self.balance)
        entry.lock.Visible=not unlocked;entry.preview.frame.Visible=card and true or false
        entry.plus.Visible=unlocked and not card
        if card then entry.preview:setMascot(card.id) end
        entry.name.Text=card and card.name or ""

        entry.status.Text=not unlocked and "LOCKED" or (card and "EQUIPPED" or (self.selectedCard and "PLACE" or "EMPTY"))
        entry.border.Color=self.selectedSlot==index and c.mint or (unlocked and self.selectedCard and not card and c.accent or c.line)
        for _,edge in ipairs(entry.edges) do edge.BackgroundColor3=entry.border.Color==c.line and Color3.fromRGB(189,104,138) or entry.border.Color end
        entry.frame.Active,entry.frame.Selectable=not self.pending and not self.data.blocked,unlocked and not self.pending and not self.data.blocked
        entry.frame:SetAttribute("Locked",not unlocked);entry.frame:SetAttribute("CardId",id or "")
        entry.status.TextColor3=not unlocked and c.muted or (card and c.mint or self.selectedCard and c.mint or c.accent)
        styleCard(entry,card,unlocked)
    end
    local available=0
    for _,card in ipairs(self.balance.AGENT_CARDS) do
        local entry=self.inventory[card.id]
        local free=self.data.cardOwned[card.id] and not Cards.location(self.data,card.id,self.balance)
        entry.frame.Visible=free==true
        entry.frame.Active,entry.frame.Selectable=free==true and not self.pending and not self.data.blocked,free==true and not self.pending and not self.data.blocked
        entry.border.Color=self.selectedCard==card.id and c.mint or c.line
        for _,edge in ipairs(entry.edges) do edge.BackgroundColor3=self.selectedCard==card.id and c.mint or Color3.fromRGB(189,104,138) end
        entry.status.Text=self.selectedCard==card.id and "SELECTED" or "SELECT"
        entry.status.TextColor3=self.selectedCard==card.id and c.mint or Theme.pixelColors.gold
        styleCard(entry,card,true)
        if free then available=available+1 end
    end
    self.inventoryTitle.Text=string.format("INVENTORY / %d",available)
    self.remove.Active,self.remove.Selectable=self.selectedSlot~=nil and not self.pending and not self.data.blocked,self.selectedSlot~=nil and not self.pending and not self.data.blocked
    self.remove.BackgroundColor3=self.remove.Active and c.accent or c.paper
    self.removeArt.label.TextColor3=self.remove.Active and c.terminal or c.muted
    self.removeArt.label.Text=self.remove.Text
    for _,face in ipairs(self.removeArt.parts) do face.BackgroundColor3=self.remove.Active and c.accent or c.paper end
    self.deckTitleShadow.Text=self.deckTitle.Text;self.inventoryTitleShadow.Text=self.inventoryTitle.Text
    self:layoutContent()
end
function Page:layoutContent()
    if self.presentationPaused then return end
    local width=math.max(1,self.body.AbsoluteSize.X-16)
    self.remove.Size=UDim2.fromOffset(math.min(160,width-16),40)
    local columns=math.min(#self.balance.AGENT_CARDS,math.max(1,math.floor((width+16)/STEP)))
    local free={}
    for _,card in ipairs(self.balance.AGENT_CARDS) do if self.inventory[card.id].frame.Visible then free[#free+1]=self.inventory[card.id] end end
    for index,entry in ipairs(free) do
        local row,column=math.floor((index-1)/columns),(index-1)%columns
        local inRow=math.min(columns,#free-row*columns)
        local left=8+math.max(0,math.floor((width-(inRow*STEP-16))/8)*4)
        entry.frame.Position=UDim2.fromOffset(left+column*STEP,GRID_Y+row*ROW_H)
    end
    local rows=math.ceil(#free/columns)
    self.inventoryPanel.Size=UDim2.new(1,-8,0,64+rows*ROW_H)
    self.body.CanvasSize=UDim2.fromOffset(0,616+rows*ROW_H)
    self.deck.CanvasSize=UDim2.fromOffset(math.max(DECK_WIDTH,self.deck.AbsoluteWindowSize.X),0)
    local left=8+math.max(0,math.floor((self.deck.AbsoluteWindowSize.X-DECK_WIDTH)/8)*4)
    for index,entry in ipairs(self.slots) do entry.frame.Position=UDim2.fromOffset(left+(index-1)*STEP,4) end
    local deckPosition=self.deck.CanvasPosition or Vector2.new(0,0)
    self.deck.CanvasPosition=Vector2.new(math.max(0,math.min(deckPosition.X,self.deck.CanvasSize.X.Offset-self.deck.AbsoluteWindowSize.X)),0)
    local bodyPosition=self.body.CanvasPosition or Vector2.new(0,0)
    self.body.CanvasPosition=Vector2.new(0,math.max(0,math.min(bodyPosition.Y,self.body.CanvasSize.Y.Offset-self.body.AbsoluteWindowSize.Y)))
    local w,h=self.frame.AbsoluteSize.X,self.frame.AbsoluteSize.Y
    local stamp=w..":"..h
    if stamp~=self.backdropStamp then
        self.backdropStamp=stamp
        local unit=math.max(8,math.ceil(math.max(h/32,w/32)/4)*4)
        for index,part in ipairs(self.stripes) do
            local row,column=math.floor((index-1)/8),(index-1)%8
            part.Position=UDim2.fromOffset((column*unit*4+row*unit)%(unit*32)-unit,row*unit)
            part.Size=UDim2.fromOffset(unit,unit)
        end
    end
end
function Page:layout(width,height,header)
    self.frame.Position=UDim2.fromOffset(8,header+8)
    self.frame.Size=UDim2.fromOffset(math.max(1,width-16),math.max(96,height-header-16))
    self.title.TextSize=14
    self:layoutContent()
end
function Page:destroy()
    self.destroyed=true;self.onSelect=nil;self.sizeConnection:Disconnect()
    for _,entry in pairs(self.inventory) do entry.preview:destroy() end
    for _,entry in ipairs(self.slots) do entry.preview:destroy() end
    self.frame:Destroy()
end
return Page
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000084">
          <Properties>
            <string name="Name">CollectionStyle</string>
            <ProtectedString name="Source">--!nonstrict
-- Shared native collection artwork; passive builders own no input or tick.
local Theme=require(script.Parent.DeskTheme)
local Mascot=require(script.Parent.AgentMascot)
local Cards=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").AgentCards)
local c=Theme.colors
local CARD_W,CARD_H=192,304
local auraColors={
    ember={{237,164,94},{84,42,51},{255,212,144}},sprout={{146,214,153},{34,69,54},{211,241,162}},
    volt={{128,208,228},{39,57,90},{185,246,227}},frost={{171,207,248},{42,47,88},{220,238,255}},
    nebula={{183,141,239},{60,36,94},{221,198,255}},forge={{231,184,108},{80,47,42},{255,223,143}},
    glitch={{219,144,212},{67,35,83},{151,243,208}},coral={{237,154,145},{77,39,59},{255,218,181}},
    sage={{170,193,179},{43,54,77},{231,233,173}},
}
local function rect(parent,name,x,y,w,h,color,z)
    return Theme.create("Frame",parent,{Name=name,BorderSizePixel=0,Active=false,Selectable=false,
        Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=color,ZIndex=z or 1})
end
local function panel(parent,name,position,size)
    local root=Theme.create("Frame",parent,{Name=name,BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,Position=position,Size=size})
    Theme.create("Frame",root,{Name="PanelShadow",BorderSizePixel=0,Active=false,Selectable=false,
        BackgroundColor3=Color3.fromRGB(12,9,17),Position=UDim2.fromOffset(4,6),Size=UDim2.new(1,0,1,-2)})
    local face,edges=Theme.pixelPanel(root,"PanelFace",UDim2.fromOffset(0,0),UDim2.fromScale(1,1),Color3.fromRGB(42,31,56))
    for _,edge in ipairs(edges) do edge.BackgroundColor3=c.black end
    rect(face,"CornerLight",8,5,20,3,Color3.fromRGB(151,115,176))
    return root
end
local function caption(parent,value,size,color,position,dimensions)
    local shadow=Theme.text(parent,value,size,Color3.fromRGB(12,9,17),
        UDim2.new(position.X.Scale,position.X.Offset+2,position.Y.Scale,position.Y.Offset+2),dimensions)
    shadow.TextXAlignment=Enum.TextXAlignment.Center;shadow.Active=false;shadow.Selectable=false;shadow.ZIndex=3
    local label=Theme.text(parent,value,size,color,position,dimensions)
    label.TextXAlignment=Enum.TextXAlignment.Center;label.Active=false;label.Selectable=false;label.ZIndex=4
    return label,shadow
end
local function cardView(parent,name,id)
    local button=Theme.create("TextButton",parent,{Name=name,Text="",AutoButtonColor=false,
        BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromOffset(CARD_W,CARD_H),ZIndex=2})
    local edges=Theme.cardTrim(button)
    local border=Theme.outline(button);border.Thickness=0
    local aura=Theme.create("Frame",button,{Name="PixelMedallion",BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,Position=UDim2.fromOffset(24,40),Size=UDim2.fromOffset(144,144),ZIndex=2})
    local rim,fill,glints={},{},{}
    for y,count in ipairs({4,8,10,10,12,12,12,12,10,10,8,4}) do
        rim[#rim+1]=rect(aura,"RimPixel",(12-count)*4,(y-1)*8,count*8,8,c.line)
        if count&gt;4 then fill[#fill+1]=rect(aura,"CorePixel",(14-count)*4,(y-1)*8,(count-2)*8,8,c.paper,2) end
    end
    for _,r in ipairs({{24,8,24,8},{16,16,8,8},{72,32,8,8},{8,56,8,8},{64,80,8,8}}) do
        glints[#glints+1]=rect(aura,"GlintPixel",r[1],r[2],r[3],r[4],c.mint,3)
    end
    for _,parts in ipairs({rim,fill,glints}) do for _,part in ipairs(parts) do
        local p,s=part.Position,part.Size;part.Position=UDim2.fromOffset(p.X.Offset*1.5,p.Y.Offset*1.5);part.Size=UDim2.fromOffset(s.X.Offset*1.5,s.Y.Offset*1.5)
    end end
    local preview=Mascot.new(button,id);preview.frame.Position,preview.frame.Size=UDim2.fromOffset(48,80),UDim2.fromOffset(96,60)
    preview.frame.ZIndex=3
    local nameLabel,nameShadow=caption(button,"",14,c.ink,UDim2.fromOffset(8,8),UDim2.fromOffset(176,24))
    local rarity=Theme.text(button,"",14,c.muted,UDim2.fromOffset(8,188),UDim2.fromOffset(176,22))
    rarity.ZIndex=4;rarity.TextXAlignment=Enum.TextXAlignment.Center
    local plaque=Theme.pixelPanel(button,"BuffPlaque",UDim2.fromOffset(8,216),UDim2.fromOffset(176,52),Color3.fromRGB(22,16,31))
    plaque.ZIndex=3
    local buff,buffShadow=caption(plaque,"",14,Theme.pixelColors.gold,UDim2.fromOffset(6,6),UDim2.fromOffset(164,18))
    local speed,speedShadow=caption(plaque,"",14,c.muted,UDim2.fromOffset(6,28),UDim2.fromOffset(164,18))
    local status,statusShadow=caption(button,"SELECT",14,c.accent,UDim2.fromOffset(8,274),UDim2.fromOffset(176,22))
    return {frame=button,border=border,edges=edges,preview=preview,name=nameLabel,nameShadow=nameShadow,rarity=rarity,
        buff=buff,buffShadow=buffShadow,speed=speed,speedShadow=speedShadow,status=status,statusShadow=statusShadow,
        aura={frame=aura,rim=rim,fill=fill,glints=glints}}
end
local function styleCard(entry,card,unlocked)
    local key=(card and card.id or "empty")..tostring(unlocked)
    if entry.aura.key~=key then
        entry.aura.key=key
        local colors=card and auraColors[card.familyId or card.id] or (unlocked and {{115,141,135},{36,45,51},{145,182,161}} or {{88,77,102},{35,29,45},{110,96,124}})
        for _,part in ipairs(entry.aura.rim) do part.BackgroundColor3=Color3.fromRGB(colors[1][1],colors[1][2],colors[1][3]) end
        for _,part in ipairs(entry.aura.fill) do part.BackgroundColor3=Color3.fromRGB(colors[2][1],colors[2][2],colors[2][3]) end
        for _,part in ipairs(entry.aura.glints) do part.BackgroundColor3=Color3.fromRGB(colors[3][1],colors[3][2],colors[3][3]) end
    end
    entry.buff.Text=card and string.format("$ %+g%%",(card.value-1)*100) or ""
    entry.rarity.Text=card and string.upper(card.rarity) or ""
    entry.rarity.TextColor3=card and Theme.rarity[card.rarity] or c.muted
    entry.speed.Text=card and string.format("SPD %+g%%",(card.speed-1)*100) or ""
    entry.buff.TextColor3=card and card.value&lt;1 and c.accent or Theme.pixelColors.gold
    entry.speed.TextColor3=card and card.speed&gt;1 and c.mint or card and card.speed&lt;1 and c.accent or c.muted
    entry.frame:SetAttribute("Buffs",card and Cards.buffText(card) or "")
    for _,pair in ipairs({{entry.name,entry.nameShadow},{entry.buff,entry.buffShadow},{entry.speed,entry.speedShadow},{entry.status,entry.statusShadow}}) do
        pair[2].Text=pair[1].Text
    end
end
return {rect=rect,panel=panel,caption=caption,cardView=cardView,styleCard=styleCard}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000085">
          <Properties>
            <string name="Name">DeskTheme</string>
            <ProtectedString name="Source">--!nonstrict
-- Floating CLI desktop with the Roblox built-in pixel font.
local TextService = game:GetService("TextService")
local Theme = {}
Theme.colors = {
    black = Color3.fromRGB(8,7,10),
    desktop = Color3.fromRGB(25, 21, 64), blue = Color3.fromRGB(205, 127, 97),
    title = Color3.fromRGB(35, 36, 43), panel = Color3.fromRGB(33, 33, 38),
    paper = Color3.fromRGB(47, 45, 48), text = Color3.fromRGB(231, 228, 224),
    muted = Color3.fromRGB(170, 166, 164), terminal = Color3.fromRGB(31, 31, 35),
    terminalBar = Color3.fromRGB(34, 34, 40), ink = Color3.fromRGB(238, 235, 231),
    dim = Color3.fromRGB(170, 166, 164), mint = Color3.fromRGB(151, 196, 165),
    amber = Color3.fromRGB(221, 181, 132), line = Color3.fromRGB(80, 70, 68),
    white = Color3.fromRGB(255, 255, 255), shadow = Color3.fromRGB(112, 112, 119),
    selected = Color3.fromRGB(80, 53, 45), green = Color3.fromRGB(151, 196, 165),
    syntax = Color3.fromRGB(205, 127, 97), accent = Color3.fromRGB(205, 127, 97),
}
Theme.rarity = { Common = Theme.colors.dim, Uncommon = Theme.colors.mint,
    Rare = Color3.fromRGB(133, 198, 255), Epic = Color3.fromRGB(215, 172, 255),
    Legendary = Theme.colors.amber, Mythic = Color3.fromRGB(255, 167, 205) }
Theme.font = Font.fromName("PressStart2P")
Theme.mono = Theme.font
Theme.pixelColors={base=Color3.fromRGB(27,23,34),panel=Color3.fromRGB(42,32,52),
    edge=Color3.fromRGB(137,106,159),portrait=Color3.fromRGB(49,36,67),gold=Color3.fromRGB(240,185,83)}
-- Responsive native pixel frames shared by collection and prestige pages.
function Theme.pixelPanel(parent,name,position,size,fillColor)
    local p=Theme.pixelColors
    local frame=Theme.create("Frame",parent,{Name=name,BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,Position=position,Size=size})
    local edges={}
    for _,rect in ipairs({{4,0,-8,0},{0,4,0,-8}}) do
        edges[#edges+1]=Theme.create("Frame",frame,{Name="PixelEdge",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.colors.black,Position=UDim2.fromOffset(rect[1],rect[2]),Size=UDim2.new(1,rect[3],1,rect[4])})
    end
    local fills={}
    for _,rect in ipairs({{8,4,-16,-8},{4,8,-8,-16}}) do
        fills[#fills+1]=Theme.create("Frame",frame,{Name="PixelFill",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=fillColor or p.panel,Position=UDim2.fromOffset(rect[1],rect[2]),Size=UDim2.new(1,rect[3],1,rect[4])})
    end
    return frame,edges,fills
end
function Theme.pixelChip(parent,position,size)
    local root=Theme.create("Frame",parent,{Name="PixelChip",BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,Position=position,Size=UDim2.fromOffset(size,size)})
    for _,r in ipairs({{0.3,0.2,0.6,0.9},{0.2,0.3,0.8,0.7},{0.1,0.4,1,0.5}}) do
        Theme.create("Frame",root,{Name="ChipShadow",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Color3.fromRGB(14,10,15),BackgroundTransparency=0.1,
            Position=UDim2.fromScale(r[1],r[2]),Size=UDim2.fromScale(r[3],r[4])})
    end
    local rows={"...aaaa...","..abbbba..",".abccccba.","abccddccba","abcddddcba","abccddccba","abccddccba",".abccccba.","..abbbba..","...aaaa..."}
    local palette={a=Color3.fromRGB(131,77,36),b=Theme.pixelColors.gold,c=Color3.fromRGB(255,211,104),d=Color3.fromRGB(255,239,166)}
    for y,row in ipairs(rows) do for x=1,10 do
        local color=palette[row:sub(x,x)]
        if color then Theme.create("Frame",root,{Name="ChipPixel",ZIndex=2,BorderSizePixel=0,Active=false,Selectable=false,BackgroundColor3=color,
            Position=UDim2.fromScale((x-1)/10,(y-1)/10),Size=UDim2.fromScale(0.1,0.1)}) end
    end end
    return root
end
function Theme.cardTrim(parent)
    Theme.create("Frame",parent,{Name="CardShadow",BorderSizePixel=0,Active=false,Selectable=false,
        BackgroundColor3=Theme.colors.black,Position=UDim2.fromOffset(4,6),Size=UDim2.new(1,0,1,-2)})
    local panel=Theme.pixelPanel(parent,"CardFrame",UDim2.fromOffset(0,0),UDim2.fromScale(1,1),Color3.fromRGB(19,15,29))
    local _,edges=Theme.pixelPanel(panel,"AccentFrame",UDim2.fromOffset(4,4),UDim2.new(1,-8,1,-8),Color3.fromRGB(19,15,29))
    for _,edge in ipairs(edges) do edge.BackgroundColor3=Color3.fromRGB(189,104,138) end
    for _,y in ipairs({4,-7}) do
        Theme.create("Frame",panel,{Name="TerracottaRail",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=y&gt;0 and Color3.fromRGB(241,152,161) or Color3.fromRGB(117,58,87),
            Position=UDim2.new(0,8,y&gt;0 and 0 or 1,y),Size=UDim2.new(1,-16,0,3)})
    end
    for _,x in ipairs({0,1}) do for _,y in ipairs({0,1}) do
        local corner=Theme.create("Frame",panel,{Name="GoldCorner",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.pixelColors.gold,Position=UDim2.new(x,x==0 and 4 or -12,y,y==0 and 4 or -12),Size=UDim2.fromOffset(8,8)})
        Theme.create("Frame",corner,{Name="CornerGlint",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Color3.fromRGB(255,237,167),Position=UDim2.fromOffset(0,0),Size=UDim2.fromOffset(8,3)})
    end end
    for _,y in ipairs({0,1}) do
        Theme.create("Frame",panel,{Name="IvoryClasp",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.colors.ink,Position=UDim2.new(0.5,-3,y,y==0 and 0 or -4),Size=UDim2.fromOffset(6,4)})
    end
    return edges
end
local widths = {}
function Theme.textWidth(value, size)
    local key = size .. ":" .. value
    if not widths[key] then
        widths[key] = math.ceil(TextService:GetTextSize(value,size,Enum.Font.Arcade,Vector2.new(10000,10000)).X)
    end
    return widths[key]
end

function Theme.create(className, parent, properties)
    local item = Instance.new(className)
    for key, value in pairs(properties) do item[key] = value end
    item.Parent = parent
    return item
end

function Theme.text(parent, value, size, color, position, dimensions, font)
    return Theme.create("TextLabel", parent, { BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = value, TextSize = size or 14, TextColor3 = color or Theme.colors.text,
        TextStrokeColor3=Theme.colors.black,TextStrokeTransparency=.8,
        FontFace = font or Theme.font, TextWrapped = true, RichText = false,
        TextXAlignment = Enum.TextXAlignment.Left, Position = position, Size = dimensions })
end

function Theme.outline(item)
    return Theme.create("UIStroke", item, { Name = "PanelBorder", Color = Theme.colors.black,
        Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Theme.rule(parent, position, size, color)
    return Theme.create("Frame", parent, { Name = "Divider", BorderSizePixel = 0,
        Position = position, Size = size, BackgroundColor3 = color or Theme.colors.line })
end

function Theme.round(item, radius)
    return Theme.create("UICorner", item, { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.window(item)
    Theme.round(item, 10)
    local border = Theme.outline(item)
    border.Color = Theme.colors.black
    return border
end

function Theme.windowDots(parent)
    for index, color in ipairs({ Color3.fromRGB(216, 104, 100), Color3.fromRGB(222, 183, 103), Theme.colors.mint }) do
        local dot = Theme.create("Frame", parent, { Name = "StatusDot" .. index, BorderSizePixel = 0,
            BackgroundColor3 = color, Position = UDim2.fromOffset(14 + (index - 1) * 17, 15), Size = UDim2.fromOffset(10, 10) })
        Theme.round(dot, 5)
    end
end

function Theme.button(parent, value, position, size, callback)
    local item = Theme.create("TextButton", parent, { Text = value, FontFace = Theme.font, TextSize = 14,
        TextColor3 = Theme.colors.text, BackgroundColor3 = Theme.colors.paper,
        AutoButtonColor = false, BorderSizePixel = 0, Position = position, Size = size, TextWrapped = true })
    Theme.outline(item)
    Theme.round(item, 4)
    item.Activated:Connect(callback) -- Instance-owned; destroying the button disconnects it.
    return item
end

-- Native stepped pixels, with a passive face/shadow and one unchanged hit area.
function Theme.pixelButton(parent,value,position,size,callback)
    local item=Theme.create("TextButton",parent,{Text=value,TextTransparency=1,TextSize=14,
        FontFace=Theme.font,BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,
        Position=position,Size=size})
    local parts={}
    local width,height=size.X.Offset,size.Y.Offset
    for _,rect in ipairs({{6,4,width-12,height-4},{3,7,width-6,height-10},{0,10,width,height-16}}) do
        Theme.create("Frame",item,{Name="PixelShadow",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.colors.black,Position=UDim2.fromOffset(rect[1],rect[2]),Size=UDim2.new(1,rect[3]-width,1,rect[4]-height)})
    end
    for _,rect in ipairs({{6,0,width-12,height-6},{3,3,width-6,height-12},{0,6,width,height-18}}) do
        Theme.create("Frame",item,{Name="PixelRim",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.colors.black,Position=UDim2.fromOffset(rect[1],rect[2]),Size=UDim2.new(1,rect[3]-width,1,rect[4]-height)})
    end
    for _,rect in ipairs({{8,2,width-16,height-10},{5,5,width-10,height-16},{2,8,width-4,height-22}}) do
        parts[#parts+1]=Theme.create("Frame",item,{Name="PixelFace",BorderSizePixel=0,Active=false,Selectable=false,
            BackgroundColor3=Theme.colors.paper,Position=UDim2.fromOffset(rect[1],rect[2]),Size=UDim2.new(1,rect[3]-width,1,rect[4]-height)})
    end
    local label=Theme.text(item,value,14,Theme.colors.muted,UDim2.fromOffset(6,0),UDim2.new(1,-12,1,-6))
    label.Name,label.TextXAlignment,label.ZIndex="PixelLabel",Enum.TextXAlignment.Center,2
    label.Active,label.Selectable=false,false
    item.Activated:Connect(callback)
    return item,{parts=parts,label=label}
end

function Theme.number(value)
    if value &gt;= 1000000000000 then return string.format("%.1fT", value / 1000000000000) end
    if value &gt;= 1000000000 then return string.format("%.1fB", value / 1000000000) end
    if value &gt;= 1000000 then return string.format("%.1fM", value / 1000000) end
    if value &gt;= 1000 then return string.format("%.1fK", value / 1000) end
    return tostring(math.floor(value))
end

function Theme.money(value)
    if value &gt;= 1000 then return "$" .. Theme.number(value) end
    return string.format("$%.2f", value)
end

return Theme
</ProtectedString>
          </Properties>
        </Item>
