      <Item class="ModuleScript" referent="RBX000038">
        <Properties>
          <string name="Name">NetworkFlow</string>
          <ProtectedString name="Source">--!nonstrict
-- Client presentation only. No income, model weights, services or saved state.
local Flow = {}
Flow.MAX_PACKETS = 6
Flow.AUTO_PACKETS = 3
Flow.TOTAL_PACKETS = Flow.MAX_PACKETS + Flow.AUTO_PACKETS
Flow.PREVIEW_TOKENS = 3
Flow.DURATION = 3.4
Flow.STAGGER = 0.18
Flow.AUTO_PERIOD = 3.6

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function clamp(value, low, high)
    return math.max(low, math.min(high, value))
end

function Flow.token(word, prompt, dimensions)
    local id = prompt.tokenId(word)
    if not id then return nil end
    local vector = {}
    for dim = 1, dimensions do vector[dim] = ((id * (dim * 23 + 5) + dim * dim * 7) % 21 - 10) / 10 end
    return { word = word, id = id, vector = vector }
end

function Flow.preview(count, prompt, balance, offset)
    offset = offset or 0
    if not finite(count) or count % 1 ~= 0 or count &lt; 0 or count &gt; balance.PROMPT_MAX_TOKENS
        or not finite(offset) or offset % 1 ~= 0 or offset &lt; 0 or offset &gt;= prompt.VOCABULARY_SIZE then return nil end
    local tokens = {}
    for index = 1, math.min(count, Flow.MAX_PACKETS) do tokens[index] = Flow.token(prompt.nextWord(offset + index - 1), prompt, balance.EMBEDDING_DIM) end
    return { count = count, tokens = tokens, text = prompt.text(math.min(count, 6), balance, offset)
        .. (count &gt; 6 and " ..." or "") }
end

function Flow.new()
    return { lastReceipt = 0, active = false, elapsed = 0, clock = 0, autoTime = 0, tokens = 0, time = 0, packets = {} }
end

local function fill(state, now)
    local pending = state.pending
    if not pending then return end
    for index = 1, Flow.MAX_PACKETS do
        if not state.packets[index] then
            local start = math.max(now, pending.nextStart)
            local lastSample = pending.next == math.min(pending.tokens, Flow.MAX_PACKETS)
            local ordinal = lastSample and pending.receipt.featuredIndex
                and pending.receipt.featuredIndex &gt; Flow.MAX_PACKETS and pending.receipt.featuredIndex or pending.next
            state.packets[index] = { receiptId = pending.id, ordinal = ordinal, offset = pending.offset, start = start,
                lastSample = lastSample, output = pending.receipt.outputs and pending.receipt.outputs[ordinal] or nil,
                receipt = pending.receipt }
            pending.next, pending.nextStart = pending.next + 1, start + Flow.STAGGER
            if pending.next &gt; math.min(pending.tokens, Flow.MAX_PACKETS) then state.pending = nil;return end
        end
    end
end

function Flow.accept(state, receipt, baseline, vocabularySize)
    if type(receipt) ~= "table" or not finite(receipt.id) or receipt.id % 1 ~= 0 or receipt.id &lt;= state.lastReceipt
        or not finite(receipt.tokens) or receipt.tokens % 1 ~= 0 or receipt.tokens &lt; 1 or receipt.tokens &gt; 128 then return false end
    if receipt.startToken ~= nil and (not finite(receipt.startToken) or receipt.startToken % 1 ~= 0
        or receipt.startToken &lt; 1 or receipt.startToken &gt; (vocabularySize or math.huge)) then return false end
    state.lastReceipt, state.tokens, state.offset = receipt.id, receipt.tokens, (receipt.startToken or 1) - 1
    if baseline then
        state.active, state.elapsed, state.packets, state.pending = false, 0, {}, nil
        return false
    end
    if not state.active then state.elapsed = 0 end
    -- Coalesce only unallocated work; preserve rarer pending batches, latest wins ties.
    local oldRank = state.pending and state.pending.receipt.featured and state.pending.receipt.featured.rank or 0
    local newRank = receipt.featured and receipt.featured.rank or 0
    if not state.pending or newRank &gt;= oldRank then
        state.pending = { id = receipt.id, tokens = receipt.tokens, offset = state.offset, next = 1,
            nextStart = state.time, receipt = receipt }
    end
    fill(state, state.time)
    state.active = true
    return true
end

function Flow.reset(state)
    state.active, state.elapsed, state.tokens, state.clock = false, 0, 0, 0
    state.packets, state.pending, state.time = {}, nil, 0
    state.autoTime = 0
    -- Keep the watermark: Studio resets do not reset server receipt IDs.
end

function Flow.span(state)
    return Flow.DURATION + math.max(0, math.min(state.tokens, Flow.MAX_PACKETS) - 1) * Flow.STAGGER
end

function Flow.tick(state, dt, enabled, reduced, speed)
    if not finite(dt) or dt &lt; 0 then return false end
    if not enabled or reduced then
        local ended = state.active
        state.active, state.packets, state.pending = false, {}, nil
        return ended
    end
    state.autoTime = state.autoTime + dt * clamp(speed or 1, 0.25, 1.3)
    state.clock = state.autoTime % Flow.AUTO_PERIOD
    local wasActive, target, completed = state.active, state.time + dt, {}
    if wasActive then state.elapsed = state.elapsed + dt end
    -- Resolve completions chronologically, including long frames, before reusing free slots.
    while true do
        local nextIndex, nextEnd = nil, math.huge
        for index = 1, Flow.MAX_PACKETS do
            local packet = state.packets[index]
            if packet and packet.start + Flow.DURATION &lt; nextEnd then
                nextIndex, nextEnd = index, packet.start + Flow.DURATION
            end
        end
        if not nextIndex or nextEnd &gt; target then break end
        completed[#completed + 1] = state.packets[nextIndex]
        state.packets[nextIndex] = nil
        fill(state, nextEnd)
    end
    state.time, state.active = target, state.pending ~= nil
    for index = 1, Flow.MAX_PACKETS do if state.packets[index] then state.active = true end end
    return wasActive and not state.active, completed
end

function Flow.progress(state, index, automatic)
    if automatic then
        if index &gt; Flow.AUTO_PACKETS then return nil end
        local t = (state.clock / Flow.AUTO_PERIOD + (index - 1) / Flow.AUTO_PACKETS) % 1
        return 0.45 + t * 0.55 -- Ambient traffic stays inside the network.
    end
    local packet = state.packets[index]
    if not packet then return nil end
    local t = (state.time - packet.start) / Flow.DURATION
    if t &lt; 0 or t &gt;= 1 then return nil end
    return t
end

function Flow.route(layers, chooseInteger)
    local route = {}
    -- Full neural connectivity: decorative edge sampling must not bias destinations.
    for layer, count in ipairs(layers) do
        route[layer] = chooseInteger(1, count)
    end
    return route
end

function Flow.trip(state, index)
    return math.floor(state.autoTime / Flow.AUTO_PERIOD + (index - 1) / Flow.AUTO_PACKETS)
end

function Flow.packetRoute(owner, layers, trip, chooseInteger)
    local topology = table.concat(layers, ":")
    if not owner.route or owner.topology ~= topology or owner.trip ~= trip then
        owner.route, owner.topology, owner.trip = Flow.route(layers, chooseInteger), topology, trip
    end
    return owner.route
end

local function between(a, b, t, stage, layer)
    -- Smooth each hop without overshoot; packets stay on the displayed segment.
    local eased = t * t * (3 - 2 * t)
    return { x = a.x + (b.x - a.x) * eased, y = a.y + (b.y - a.y) * eased,
        stage = stage, layer = layer, hop = t }
end

function Flow.position(anchors, points, progress)
    local t = clamp(progress, 0, 1)
    if t &lt; 0.16 then return between(anchors[1], anchors[2], t / 0.16, 1) end
    if t &lt; 0.32 then return between(anchors[2], anchors[3], (t - 0.16) / 0.16, 2) end
    if t &lt; 0.45 then return between(anchors[3], points[1], (t - 0.32) / 0.13, 3) end
    local network = (t - 0.45) / 0.55 * (#points - 1)
    local layer = math.min(#points - 1, math.floor(network) + 1)
    return between(points[layer], points[layer + 1], math.min(1, network - layer + 1), 4, layer)
end

function Flow.layout(width, height, sidebarWidth)
    local sidebar = math.min(sidebarWidth or (width &gt;= 700 and 208 or 128), math.max(80, width - 96))
    local gap, cardHeight = 16, 104
    local cards = {}
    for index = 1, 3 do
        cards[index] = { x = 1, y = 1 + (index - 1) * (cardHeight + 12), width = sidebar - 36, height = cardHeight }
    end
    return { cards = cards, sidebarWidth = sidebar, sidebarHeight = 338, sidebarViewportHeight = height,
        rows = Flow.PREVIEW_TOKENS,
        graphX = sidebar + gap, graphY = 0, graphWidth = math.max(1, width - sidebar - gap),
        graphHeight = math.max(1, height - 58) }
end

function Flow.screenPoints(fit, route, geometry, scroll)
    local points = {}
    scroll = scroll or { x = 0, y = 0 }
    for layer, node in ipairs(route) do
        local point = fit.positions[layer][node]
        points[layer] = { x = geometry.graphX + fit.offsetX + point.x - scroll.x,
            y = geometry.graphY + fit.offsetY + point.y - scroll.y }
    end
    return points
end

function Flow.contains(point, x, y, width, height, marginX, marginY)
    return point.x &gt;= x + marginX and point.x &lt;= x + width - marginX
        and point.y &gt;= y + marginY and point.y &lt;= y + height - marginY
end

return Flow
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000039">
        <Properties>
          <string name="Name">NetworkLayout</string>
          <ProtectedString name="Source">--!nonstrict
-- Pure local graph geometry; never changes the authoritative topology or income.
local Layout = {}
Layout.MAX_EDGES = 256

function Layout.fit(layers, width, height)
    local maxCount = 1
    for _, count in ipairs(layers) do maxCount = math.max(maxCount, count) end
    local logicalWidth = math.max(320, (#layers - 1) * 100 + 56)
    local logicalHeight = math.max(240, (maxCount - 1) * 40 + 80)
    -- Grow the scroll canvas, never shrink neurons or the spacing between them.
    local canvasWidth, canvasHeight = math.max(width, logicalWidth), math.max(height, logicalHeight)
    local result = { width = logicalWidth, height = logicalHeight, scale = 1, positions = {},
        viewportWidth = width, viewportHeight = height, canvasWidth = canvasWidth, canvasHeight = canvasHeight,
        offsetX = (canvasWidth - logicalWidth) / 2, offsetY = (canvasHeight - logicalHeight) / 2 }
    for layer, count in ipairs(layers) do
        local x = 28 + (layer - 1) * (logicalWidth - 56) / (#layers - 1)
        result.positions[layer] = {}
        for neuron = 1, count do
            result.positions[layer][neuron] = { x = x, y = logicalHeight / 2 + (neuron - (count + 1) / 2) * 40 }
        end
    end
    return result
end

function Layout.scroll(fit, previous, selected, reveal)
    local maxX, maxY = fit.canvasWidth - fit.viewportWidth, fit.canvasHeight - fit.viewportHeight
    local x = previous and previous.x or maxX / 2
    local y = previous and previous.y or maxY / 2
    -- Keep the same distance from the vertical center when widths/viewport change.
    if previous and previous.maxY then y = y + (maxY - previous.maxY) / 2 end
    if reveal and selected and fit.positions[selected] then
        local target = fit.offsetX + fit.positions[selected][1].x
        if target &lt; x + 32 then x = target - 32 end
        if target &gt; x + fit.viewportWidth - 32 then x = target - fit.viewportWidth + 32 end
    end
    return { x = math.max(0, math.min(maxX, x)), y = math.max(0, math.min(maxY, y)) }
end

function Layout.edges(layers)
    local result = {}
    local perGap = math.floor(Layout.MAX_EDGES / (#layers - 1))
    for layer = 1, #layers - 1 do
        local count = math.min(layers[layer] * layers[layer + 1], perGap)
        local seen, used = {}, 0
        local function append(from, to)
            local key = from .. ":" .. to
            if used &lt; count and not seen[key] then
                seen[key], used = true, used + 1
                result[#result + 1] = { layer = layer, from = from, to = to }
            end
        end
        -- Cover all current sources/destinations before adding more sampled links.
        for sample = 0, math.min(count, math.max(layers[layer], layers[layer + 1])) - 1 do
            append(sample % layers[layer] + 1, sample % layers[layer + 1] + 1)
        end
        for offset = 0, layers[layer + 1] - 1 do
            for from = 1, layers[layer] do
                append(from, (from - 1 + offset) % layers[layer + 1] + 1)
                if used == count then break end
            end
            if used == count then break end
        end
    end
    return result
end

return Layout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000040">
        <Properties>
          <string name="Name">PremiumRules</string>
          <ProtectedString name="Source">--!nonstrict
-- Authored offers and pure benefits. No client amounts, prices, clocks or RNG.
local Premium={MAX_TIME=4102444800,MAX_CREDITS=1000000,MAX_PENDING=256}
Premium.OFFERS={
    {id="forever",name="FOREVER DUO",price=100,kind="pass",icon="prestige",featured=true,
        description="2x Money + 2x Chips\nForever. One purchase."},
    {id="money_hour",name="2x MONEY",price=10,kind="product",icon="money",duration=3600,
        description="Double confirmed sale rewards.\n1 real-time hour."},
    {id="chips_hour",name="2x CHIPS",price=15,kind="product",icon="prestige",duration=3600,
        description="Double new Chips at prestige.\n1 real-time hour."},
    {id="agent",name="EXTRA AGENT",price=20,kind="product",icon="agent",
        description="One writer for this run.\nAgent resets at prestige."},
}
function Premium.new() return {moneyUntil=0,chipsUntil=0,forever=false,agentCredits=0,bonusChips=0,receipts={}} end
function Premium.copy(value)
    local result=Premium.new()
    for _,key in ipairs({"moneyUntil","chipsUntil","forever","agentCredits","bonusChips"}) do result[key]=value[key] end
    for id,sku in pairs(value.receipts or {}) do result.receipts[id]=sku end
    return result
end
local function integer(value,lo,hi) return type(value)=="number" and value==value and value%1==0 and value&gt;=lo and value&lt;=hi end
function Premium.offer(id) for _,offer in ipairs(Premium.OFFERS) do if offer.id==id then return offer end end end
function Premium.validReceiptId(id) return type(id)=="string" and #id&gt;=1 and #id&lt;=50 and id:match("^[%w_%-]+$")~=nil end
function Premium.redeem(state,balance)
    if state.premium.agentCredits&lt;1 then return false,"No agent credits." end
    if #state.layerSizes-2&gt;=balance.MAX_HIDDEN_LAYERS then return false,"All 8 agent slots are full. Credit is saved." end
    table.insert(state.layerSizes,#state.layerSizes,state.layerSizes[2])
    state.premium.agentCredits=state.premium.agentCredits-1
    return true,"Agent joined this run."
end
function Premium.grant(state,sku,unixNow,balance)
    local offer=Premium.offer(sku);if not offer or offer.kind~="product" then return false end
    if sku=="agent" then
        if state.premium.agentCredits&gt;=Premium.MAX_CREDITS then return false end
        state.premium.agentCredits=state.premium.agentCredits+1;Premium.redeem(state,balance)
    else
        local key=sku=="money_hour" and "moneyUntil" or "chipsUntil"
        local nextTime=math.max(unixNow,state.premium[key])+offer.duration
        if not integer(nextTime,0,Premium.MAX_TIME) then return false end
        state.premium[key]=nextTime
    end
    return true
end
return Premium
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000041">
        <Properties>
          <string name="Name">PrestigeMotion</string>
          <ProtectedString name="Source">--!nonstrict
-- Presentation-only phases; no clock, services, transport or rewards.
local Motion={CLOSE=2.1,HOLD=.12,OPEN=.8,REDUCED_CLOSE=.18,REDUCED_OPEN=.18,SPECKS=144}
local function clamp(value) return math.max(0,math.min(1,value)) end
local function ease(value) return value*value*(3-2*value) end
function Motion.pose(age,reduced)
    age=math.max(0,age)
    local close=reduced and Motion.REDUCED_CLOSE or Motion.CLOSE
    local hold=reduced and 0 or Motion.HOLD
    local open=reduced and Motion.REDUCED_OPEN or Motion.OPEN
    local p=clamp(age/close)
    local eased=ease(p)
    local reveal=clamp((age-close-hold)/open)
    local covered=age&gt;=close
    return {scale=(reduced or covered) and 1 or .015+.985*(1-eased)^1.4,
        angle=(reduced or covered) and 0 or 540*eased,
        veil=covered and 1-ease(reveal) or (reduced and p or eased^3),
        hole=(not reduced and not covered) and .60*eased*eased or 0,
        progress=p,covered=covered,done=age&gt;=close+hold+open,
        spiral=not reduced and not covered,phase=not covered and "collapse" or reveal==0 and "covered" or "reveal"}
end
function Motion.spiral(age)
    local p=clamp(age/Motion.CLOSE)
    return {scale=math.max(.001,(1-ease(p))^.65),angle=360*ease(p)}
end
function Motion.speck(index,age,width,height)
    local transform=Motion.spiral(age)
    local arm=math.floor((index-1)/48)
    local u=((index-1)%48+1)/48
    local diagonal=math.sqrt(width*width+height*height)
    local radius=(.02+u)*diagonal*.58*transform.scale
    local angle=arm*math.pi*2/3+(1-u)*4.5+transform.angle*math.pi/180
    local nextRadius=(.02+u+1/48)*diagonal*.58*transform.scale
    local dx=math.cos(angle-4.5/48)*nextRadius-math.cos(angle)*radius
    local dy=math.sin(angle-4.5/48)*nextRadius-math.sin(angle)*radius
    local rotation=math.atan2 and math.atan2(dy,dx) or math.atan(dy,dx)
    return {x=width/2+math.cos(angle)*radius,y=height/2+math.sin(angle)*radius,
        size=(3+u*12)*transform.scale,
        length=math.sqrt(dx*dx+dy*dy)*.92,angle=rotation*180/math.pi,alpha=.7}
end
return Motion
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000042">
        <Properties>
          <string name="Name">PrestigeRules</string>
          <ProtectedString name="Source">--!nonstrict
-- Chips are minted only from confirmed lifetime prompt earnings, never balance,
-- idle time, purchases, skill attempts, Studio money grants or client amounts.
local Prestige={}
function Prestige.level(earned,balance)
    local level=math.min(balance.MAX_PRESTIGE_CHIPS,math.floor((earned/balance.PRESTIGE_BASE)^(1/3)))
    while level&lt;balance.MAX_PRESTIGE_CHIPS and balance.PRESTIGE_BASE*(level+1)^3&lt;=earned do level=level+1 end
    while level&gt;0 and balance.PRESTIGE_BASE*level^3&gt;earned do level=level-1 end
    return level
end
function Prestige.view(state,balance,unixNow)
    local level=Prestige.level(state.lifetimeEarned,balance)
    local effect=balance.progression(state)
    local baseClaimed=state.prestigeClaimed-(state.premium and state.premium.bonusChips or 0)
    local baseAvailable=math.max(0,level-baseClaimed)
    local available=baseAvailable*balance.premiumMultiplier(state,"chips",unixNow)
    return {available=available,baseAvailable=baseAvailable,baseLevel=level,level=state.prestigeClaimed,
        nextAt=level&lt;balance.MAX_PRESTIGE_CHIPS and balance.PRESTIGE_BASE*(level+1)^3 or nil,
        perChip=effect.perChip,bonus=effect.prestigeBonus,
        afterBonus=1+(state.prestigeClaimed+available)*effect.perChip}
end
function Prestige.ascend(state,balance,stateModule,unixNow)
    local view=Prestige.view(state,balance,unixNow);local gain=view.available
    if gain&lt;1 then return false,"Earn more lifetime money to gain a Chip." end
    local fresh=stateModule.new(balance)
    fresh.tutorialDone=state.tutorialDone
    fresh.analytics=stateModule.copyAnalytics(state.analytics)
    fresh.chips=state.chips+gain;fresh.prestigeClaimed=state.prestigeClaimed+gain
    fresh.prestigeCount=state.prestigeCount+1;fresh.lifetimeEarned=state.lifetimeEarned
    fresh.premium=stateModule.copy(state).premium
    fresh.premium.bonusChips=fresh.premium.bonusChips+gain-view.baseAvailable
    fresh.prestigeSkills={}
    for id,owned in pairs(state.prestigeSkills) do fresh.prestigeSkills[id]=owned end
    for id,owned in pairs(state.legacyPrestigeSkills or {}) do fresh.legacyPrestigeSkills[id]=owned end
    fresh.cardOwned={}
    for id,owned in pairs(state.cardOwned or {}) do fresh.cardOwned[id]=owned end
    for id,owned in pairs(state.cardCrafted or {}) do fresh.cardCrafted[id]=owned end
    for id,count in pairs(state.fragments or {}) do fresh.fragments[id]=count end
    if state.cardDeck and state.cardDeck[1] then fresh.cardDeck[1]=state.cardDeck[1] end
    -- Keep the leased profile object; reset only this game's normal run.
    for key in pairs(state) do state[key]=nil end
    for key,value in pairs(fresh) do state[key]=value end
    return true,gain
end
function Prestige.node(id,balance)
    for _,node in ipairs(balance.PRESTIGE_NODES) do if node.id==id then return node end end
end
function Prestige.quote(state,id,balance)
    local node=Prestige.node(id,balance)
    if not node then return nil,"Unknown skill." end
    if state.prestigeSkills[id] then return nil,"Already unlocked." end
    for _,parent in ipairs(node.parents) do
        if not state.prestigeSkills[parent] then return nil,"Unlock all connected parent skills first." end
    end
    return node.cost
end
function Prestige.buy(state,id,balance)
    local cost,reason=Prestige.quote(state,id,balance)
    if not cost then return false,reason end
    if state.chips&lt;cost then return false,"Not enough Chips." end
    state.chips=state.chips-cost;state.prestigeSkills[id]=true
    return true,"Permanent skill unlocked."
end
return Prestige
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000043">
        <Properties>
          <string name="Name">PromptComposer</string>
          <ProtectedString name="Source">--!nonstrict
-- Bounded manual composition. No timers that submit, reroll, retry or grant money.
local Composer = {}
Composer.TOKEN_STYLE={wordSize=18,badgeSize=15,height=33,rowHeight=35,gap=9,padding=9,badgeGap=9}
local function integer(value, maximum)
    return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= 1 and value &lt;= maximum
end
function Composer.new() return { count = 0, lastReceipt = 0 } end

-- Fixed monospace token objects wrap at native scale without a grid of buttons.
function Composer.tokenLayout(offers, count, width, measure)
    local style=Composer.TOKEN_STYLE
    width = math.max(24, width)
    local positions, x, y = {}, 0, 0
    for index = 1, count do
        local offer = offers[index]
        local multiplier=offer.multiplier*(offer.skillMultiplier or 1)
        local hasBadge=multiplier&gt;1
        local text = offer.word .. (hasBadge and (" x" .. string.format("%g",multiplier)) or "")
        local wordWidth = measure and measure(offer.word,style.wordSize) or #offer.word * style.wordSize
        local badgeText = hasBadge and ("x" .. string.format("%g",multiplier)) or ""
        local badgeWidth = measure and measure(badgeText,style.badgeSize) or #badgeText * style.badgeSize
        local size = math.min(width, wordWidth + style.padding*2 + (hasBadge and badgeWidth + style.badgeGap or 0))
        if x &gt; 0 and x + size &gt; width then x, y = 0, y + style.rowHeight end
        positions[index] = { x = x, y = y, width = size, text = text, badgeWidth = badgeWidth }
        x = x + size + style.gap
    end
    if x + style.gap &gt; width then x, y = 0, y + style.rowHeight end
    return positions, x, y, y + style.rowHeight
end

-- Keep the current window width. More token rows grow only the composer/window
-- height at native font size; the desktop scrolls when that height exceeds it.
function Composer.windowLayout(offers,count,width,height,maxWidth,_maxHeight,short,measure,rosterHeight)
    width=math.max(1,math.min(width,maxWidth))
    local minimumPanel=short and 108 or 150
    local _,_,_,tokenHeight=Composer.tokenLayout(offers,count,math.max(24,width-60),measure)
    local panelHeight=math.max(minimumPanel,tokenHeight+66)
    local windowHeight=math.max(height,panelHeight+82+(rosterHeight or 0))
    return {width=width,height=windowHeight,panelHeight=panelHeight,tokenHeight=tokenHeight}
end

function Composer.revealCount(length, elapsed, speed, reduced)
    if reduced or length==0 then return length, true end
    local duration=math.min(0.12,length/100,0.85/math.max(1,speed))
    local visible=math.min(length,math.floor(math.max(0,elapsed)/duration*length+0.000001))
    return visible,visible==length
end

function Composer.update(state, draft, balance, prompt)
    if type(draft) == "table" and type(draft.ranks) == "table" then
        if not balance or not prompt or not integer(draft.startToken, prompt.VOCABULARY_SIZE)
            or #draft.ranks &lt; 1 or #draft.ranks &gt; balance.PROMPT_MAX_TOKENS then return false end
        local expanded = { id = draft.id, startToken = draft.startToken, offers = {} }
        for key, rank in pairs(draft.ranks) do
            if not integer(key, #draft.ranks) or not integer(rank, #balance.SPECIAL_TOKENS) then return false end
        end
        for index = 1, #draft.ranks do
            local rank = draft.ranks[index]
            if not integer(rank, #balance.SPECIAL_TOKENS) then return false end
            local tier = balance.SPECIAL_TOKENS[rank]
            expanded.offers[index] = { word = prompt.nextWord((draft.startToken + index - 2) % prompt.VOCABULARY_SIZE),
                rarity = tier.rarity, rank = rank, multiplier = tier.multiplier, denominator = tier.denominator }
        end
        draft = expanded
    end
    if type(draft) ~= "table" or not integer(draft.id, 1000000000000) or type(draft.offers) ~= "table"
        or #draft.offers &lt; 1 or #draft.offers &gt; 128 then return false end
    for key, offer in pairs(draft.offers) do
        if not integer(key, #draft.offers) or type(offer) ~= "table" or type(offer.word) ~= "string"
            or #offer.word &gt; 32 or not string.match(offer.word, "^[a-z]+$")
            or not integer(offer.rank, 5) or not integer(offer.multiplier, 250) then return false end
    end
    if state.draft and draft.id &lt; state.draft.id then return false end
    local changed = not state.draft or state.draft.id ~= draft.id
    if changed then state.count, state.flight = 0, nil end
    state.draft = draft
    state.count = math.min(state.count, #draft.offers)
    return changed
end

function Composer.push(state, limit)
    if state.flight or not state.draft or state.count &gt;= math.min(limit, #state.draft.offers) then return false end
    state.count = state.count + 1
    return true
end

function Composer.pop(state)
    if state.flight or state.count == 0 then return false end
    state.count = state.count - 1;return true
end

function Composer.clear(state)
    if state.flight then return false end
    state.count = 0;return true
end

function Composer.send(state, now, limit, balance)
    if state.flight or not state.draft or not integer(state.count, math.min(limit, #state.draft.offers)) then return nil end
    local request = { draftId = state.draft.id, tokens = state.count }
    state.flight = { draftId = request.draftId, tokens = request.tokens, sentAt = now }
    return request
end

function Composer.confirm(state, receipt, baseline, now, balance)
    if type(receipt) ~= "table" or not integer(receipt.id, balance.MAX_CREDITS) or receipt.id &lt;= state.lastReceipt then return false end
    state.lastReceipt = receipt.id
    if baseline then return false end
    if state.flight and (receipt.draftId or receipt.id) == state.flight.draftId then
        state.flight, state.count = nil, 0
    end
    return true
end

function Composer.timeout(state, now, balance)
    if state.flight and now - state.flight.sentAt &gt;= (state.responseTimeout or balance.LIVE_RECEIPT_TIMEOUT) then
        state.flight = nil
        return true -- Request sync, never resend a possibly paid prompt automatically.
    end
    return false
end

return Composer
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000044">
        <Properties>
          <string name="Name">PromptDraft</string>
          <ProtectedString name="Source">--!nonstrict
-- Client-only presentation state, kept pure for receipt/draft regression tests.
local Draft = {}

function Draft.new()
    return { tokens = 0, revision = 0, lastReceipt = 0 }
end

function Draft.setCount(draft, tokens, limit)
    local nextCount = math.max(0, math.min(limit, tokens))
    if nextCount ~= draft.tokens then
        draft.tokens, draft.revision = nextCount, draft.revision + 1
    end
end

function Draft.submitted(draft)
    draft.submittedRevision = draft.revision
end

function Draft.confirm(draft, receipt, baseline)
    if type(receipt) ~= "table" or type(receipt.id) ~= "number" or receipt.id ~= receipt.id
        or receipt.id % 1 ~= 0 or receipt.id &lt;= draft.lastReceipt then return false end
    draft.lastReceipt = receipt.id
    if baseline then return false end -- First sync must not celebrate an older UI's prompt.
    if draft.submittedRevision == draft.revision then
        draft.tokens, draft.revision = 0, draft.revision + 1
    end
    draft.submittedRevision = nil
    return true
end

-- Bounded live-input transport state. No raw keystrokes, services or credit authority.
function Draft.liveNew()
    return { cursor = 0, queued = 0, offset = 0, lastReceipt = 0, nextSend = 0 }
end

function Draft.livePush(state, vocabularySize, maximum)
    if state.queued &gt;= maximum then return nil end
    local wordIndex = state.cursor
    if state.queued == 0 then state.offset = state.cursor end
    state.cursor = (state.cursor + 1) % vocabularySize
    state.queued = state.queued + 1
    return wordIndex
end

function Draft.liveNext(state, now, limit, balance, vocabularySize)
    if state.flight and now - state.flight.sentAt &gt;= balance.LIVE_RECEIPT_TIMEOUT then
        state.flight = nil -- Never retry an unconfirmed request: it may already have earned credits.
        return nil, "timeout"
    end
    if state.flight or state.queued == 0 or now &lt; state.nextSend then return nil end
    local count = math.min(limit, state.queued)
    local flight = { tokens = count, startToken = state.offset + 1, sentAt = now, baseline = state.lastReceipt }
    state.queued, state.offset = state.queued - count, (state.offset + count) % vocabularySize
    state.flight, state.nextSend = flight, now + math.max(balance.LIVE_SEND_INTERVAL, balance.MANUAL_MIN_INTERVAL)
    return flight
end

function Draft.liveConfirm(state, receipt, baseline, now, balance)
    if type(receipt) ~= "table" or type(receipt.id) ~= "number" or receipt.id ~= receipt.id
        or receipt.id % 1 ~= 0 or receipt.id &lt;= state.lastReceipt then return false end
    state.lastReceipt = receipt.id
    if baseline then return false end
    -- A delayed acknowledgement must not cause the next request to arrive inside server cooldown.
    if now and balance then state.nextSend = math.max(state.nextSend, now + balance.LIVE_SEND_INTERVAL) end
    local flight = state.flight
    if flight and receipt.id &gt; flight.baseline and receipt.tokens == flight.tokens
        and (receipt.startToken or 1) == flight.startToken then state.flight = nil end
    return true
end

function Draft.liveReset(state)
    state.cursor, state.queued, state.offset, state.nextSend, state.flight = 0, 0, 0, 0, nil
end

return Draft
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000045">
        <Properties>
          <string name="Name">PromptRules</string>
          <ProtectedString name="Source">--!nonstrict
-- Fixed authored text. Raw keyboard input never leaves the client.
local Prompt = {}
local words = {
    "build", "a", "responsive", "dashboard", "with", "dark", "mode", "and", "reusable",
    "components", "then", "verify", "tests", "before", "shipping", "clean", "production", "ready",
    "code", "signal", "neuron", "network", "repository", "commit", "patch", "refactor", "deploy",
    "release", "lint", "render", "async", "promise", "request", "response", "endpoint", "server",
    "client", "browser", "layout", "button", "theme", "application", "package", "workspace", "terminal",
    "agent", "tool", "plan", "edit", "test", "debug", "fix", "review", "document",
    "buildlog", "typescript", "stylesheet", "component", "hook", "state", "props", "reducer", "action",
    "effect", "event", "handler", "interface", "import", "export", "const", "return", "await",
    "fetch", "resolve", "reject", "assert", "mock", "suite", "fixture", "coverage", "diff",
    "staging", "origin", "main", "config", "script", "command", "shell", "git", "npm",
    "vite", "eslint", "prettier", "status", "success", "task", "worker", "cpu", "context",
    "completion", "function", "module", "method", "object", "array", "index", "table", "stack",
    "queue", "loop", "step", "frame", "screen", "display", "color", "light", "memory",
    "compute", "logic", "data", "stream", "token", "input", "output", "encode", "decode",
    "vector", "matrix", "layer",
}
Prompt.VOCABULARY_SIZE = #words
local tokenIds = {}
for index, word in ipairs(words) do tokenIds[string.lower(word)] = index end

function Prompt.tokenId(word)
    return type(word) == "string" and tokenIds[string.lower(word)] or nil
end

function Prompt.limit(state, balance)
    return math.min(balance.PROMPT_MAX_TOKENS,
        balance.PROMPT_BASE_TOKENS + state.tokenLevel * balance.PROMPT_TOKENS_PER_LEVEL)
end

function Prompt.agentTypingRate(state, balance)
    return balance.TYPING_BASE_RATE + (state.typingLevel or 0) * balance.TYPING_RATE_PER_LEVEL
end

function Prompt.nextWord(tokens)
    return words[tokens % #words + 1]
end

function Prompt.text(tokens, balance, offset)
    offset = offset or 0
    if type(tokens) ~= "number" or tokens ~= tokens or tokens % 1 ~= 0
        or tokens &lt; 0 or tokens &gt; balance.PROMPT_MAX_TOKENS
        or type(offset) ~= "number" or offset ~= offset or offset % 1 ~= 0 or offset &lt; 0 or offset &gt;= #words then return nil end
    local result = {}
    for index = 1, tokens do result[index] = words[(offset + index - 1) % #words + 1] end
    return table.concat(result, " ")
end

function Prompt.validate(text, limit, balance)
    if type(text) ~= "string" or #text &gt; balance.PROMPT_MAX_BYTES then return nil, "invalid_prompt" end
    local count = 0
    for _ in string.gmatch(text, "%S+") do
        count = count + 1
        if count &gt; limit then return nil, "prompt_too_long" end
    end
    if count == 0 then return nil, "empty_prompt" end
    local first = string.match(text, "%S+")
    local id = Prompt.tokenId(first)
    if not id or text ~= Prompt.text(count, balance, id - 1) then return nil, "invalid_prompt" end
    return count, nil, id - 1
end

function Prompt.drawOutput(balance, chooseInteger)
    if type(chooseInteger) ~= "function" then return nil end
    local total = 0
    for _, tier in ipairs(balance.OUTPUT_TOKENS) do total = total + tier.weight end
    local roll = chooseInteger(1, total)
    if type(roll) ~= "number" or roll ~= roll or roll % 1 ~= 0 or roll &lt; 1 or roll &gt; total then return nil end
    local cumulative = 0
    for rank, tier in ipairs(balance.OUTPUT_TOKENS) do
        cumulative = cumulative + tier.weight
        if roll &lt;= cumulative then
            return { word = tier.word, rarity = tier.rarity, multiplier = tier.multiplier,
                weight = tier.weight, totalWeight = total, rank = rank }
        end
    end
end

function Prompt.receiptView(receipt, includeOutputs)
    if not receipt then return nil end
    local view = {}
    for _, key in ipairs({ "id", "draftId", "tokens", "reward", "startToken", "outputToken", "outputRarity", "featured", "featuredIndex", "skillBonus" }) do
        view[key] = receipt[key]
    end
    if includeOutputs then view.outputs = receipt.outputs end
    if receipt.outputs then
        view.tokenRewards={}
        for index,output in ipairs(receipt.outputs) do view.tokenRewards[index]=output.reward end
    end
    return view
end

function Prompt.submit(state, text, now, lastManual, balance, simulation, chooseInteger)
    local count, reason, offset = Prompt.validate(text, Prompt.limit(state, balance), balance)
    if not count then return false, reason end
    if type(now) ~= "number" or now ~= now or now == math.huge or now == -math.huge
        or now - lastManual &lt; balance.MANUAL_MIN_INTERVAL then return false, "prompt_cooldown" end
    local outputs, featured, featuredIndex, reward, remaining = {}, nil, nil, 0, balance.MAX_CREDITS - state.credits
    local base = simulation.batchReward(state)
    for index = 1, count do
        local output = Prompt.drawOutput(balance, chooseInteger)
        if not output then return false, "invalid_reward_roll" end
        output.reward = math.min(remaining, base * output.multiplier)
        remaining, reward = remaining - output.reward, reward + output.reward
        outputs[index] = output
        if not featured or output.rank &gt; featured.rank then featured, featuredIndex = output, index end
    end
    state.credits = state.credits + reward
    state.batches = math.min(balance.MAX_CREDITS, state.batches + 1)
    return true, { tokens = count, reward = reward, startToken = offset + 1,
        outputToken = featured.word, outputRarity = featured.rarity, featured = featured,
        featuredIndex = featuredIndex, outputs = outputs }
end

return Prompt
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000046">
        <Properties>
          <string name="Name">PromptSession</string>
          <ProtectedString name="Source">--!nonstrict
-- Server-issued token offers. A client submits only an offer ID and prefix length.
local Session = {}
local function integer(value, low, high)
    return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= low and value &lt;= high
end

function Session.validPayload(payload, balance)
    if type(payload) ~= "table" or not integer(payload.draftId, 1, balance.MAX_CREDITS)
        or not integer(payload.tokens, 1, balance.PROMPT_MAX_TOKENS) then return false end
    local fields = 0
    for key in pairs(payload) do
        if key ~= "draftId" and key ~= "tokens" then return false end
        fields = fields + 1
    end
    return fields == 2
end

function Session.new() return { cursor = 0, sequence = 0 } end

function Session.statistics(session, now)
    local totals = session.totals or { earned = 0, prompts = 0, tokens = 0, special = 0, tiers = {0,0,0,0,0} }
    local recent, amount = session.recent or {}, 0
    for index = #recent, 1, -1 do
        if now - recent[index].time &gt;= 10 then table.remove(recent, index)
        else amount = amount + recent[index].reward end
    end
    local tiers = {};for index, count in ipairs(totals.tiers) do tiers[index] = count end
    return { earned = totals.earned, prompts = totals.prompts, tokens = totals.tokens,
        special = totals.special, tiers = tiers, moneyPerSecond = amount / 10,
        skillBonus = totals.skillBonus or 0,streak=session.streak or 0,
        bestStreak=session.bestStreak or 0,streakMultiplier=session.streakMultiplier or 1 }
end

-- Keep tier metadata/multipliers canonical; only the server's ticket weights vary.
-- denominator in SPECIAL_TOKENS remains the baseline odds, not a live chance.
function Session.tokenWeights(profile,balance)
    local boost=balance.progression(profile).rarityBoost
    local weights,special={},0
    for rank=2,#balance.SPECIAL_TOKENS do
        weights[rank]=balance.SPECIAL_TOKENS[rank].weight*boost
        special=special+weights[rank]
    end
    weights[1]=10000-special
    return weights
end

local function token(cursor, balance, prompt, choose, weights)
    if type(choose) ~= "function" then return nil end
    local roll = choose(1, 10000)
    if not integer(roll, 1, 10000) then return nil end
    local cumulative = 0
    for rank, tier in ipairs(balance.SPECIAL_TOKENS) do
        cumulative = cumulative + weights[rank]
        if roll &lt;= cumulative then
            return { word = prompt.nextWord(cursor), rarity = tier.rarity, rank = rank,
                multiplier = tier.multiplier, denominator = tier.denominator }
        end
    end
end

local function build(cursor, id, limit, balance, prompt, choose, profile, existing)
    local offers = {}
    local weights=Session.tokenWeights(profile,balance)
    for index = 1, limit do
        offers[index] = existing and existing[index] or token((cursor + index - 1) % prompt.VOCABULARY_SIZE, balance, prompt, choose, weights)
        if not offers[index] then return nil end
    end
    return { id = id, startToken = cursor + 1, offers = offers }
end

function Session.ensure(session, profile, balance, prompt, choose, now)
    local limit = prompt.limit(profile, balance)
    local draft = session.draft
    if draft and #draft.offers == limit then return draft end
    local id = draft and draft.id or session.sequence + 1
    local nextDraft = build(session.cursor, id, limit, balance, prompt, choose, profile, draft and draft.offers)
    if not nextDraft then return nil, "invalid_reward_roll" end
    session.sequence, session.draft = id, nextDraft
    return nextDraft
end

function Session.view(draft)
    if not draft then return nil end
    local view = { id = draft.id, startToken = draft.startToken, offers = {} }
    for index, offer in ipairs(draft.offers) do
        view.offers[index] = { word = offer.word, rarity = offer.rarity, rank = offer.rank,
            multiplier = offer.multiplier, denominator = offer.denominator }
    end
    return view
end

function Session.wire(draft)
    local wire = { id = draft.id, startToken = draft.startToken, ranks = {} }
    for index, offer in ipairs(draft.offers) do wire.ranks[index] = offer.rank end
    return wire -- Words and tier metadata are fixed shared data, not repeated 128 times.
end

function Session.baseReward(profile, balance, simulation,unixNow)
    local value=simulation.batchReward(profile)*balance.valueMultiplier(profile)*balance.progression(profile).money*balance.premiumMultiplier(profile,"money",unixNow)
    return math.min(balance.MAX_CREDITS,math.floor(value*100+0.5)/100)
end

function Session.submit(session, profile, payload, now, lastManual, balance, prompt, simulation, choose,unixNow)
    if not Session.validPayload(payload, balance) then return false, "invalid_prompt" end
    local draft = session.draft
    if not draft or payload.draftId ~= draft.id then return false, "stale_prompt" end
    local count = payload.tokens
    if count &gt; #draft.offers or count &gt; prompt.limit(profile, balance) then return false, "prompt_too_long" end
    if type(now) ~= "number" or now ~= now or now == math.huge or now == -math.huge
        or now-lastManual &lt; (session.skillSettings and session.skillSettings.promptCooldown or 0) then return false, "prompt_cooldown" end
    local remaining, total, outputs, best, bestIndex = balance.MAX_CREDITS - profile.credits, 0, {}, nil, 1
    local skillBonus=0
    local base = Session.baseReward(profile, balance, simulation,unixNow)
    for index = 1, count do
        local offer = draft.offers[index]
        local skill=session.skillAwards and session.skillAwards[index]
        local factor=skill and skill.multiplier or 1
        local normal=math.min(remaining,math.floor(base*offer.multiplier*100+0.5)/100)
        local amount = math.min(remaining, math.floor(base * offer.multiplier * factor * 100 + 0.5) / 100)
        skillBonus=skillBonus+amount-normal
        local output = { word = offer.word, rarity = offer.rarity, rank = offer.rank,
            multiplier = offer.multiplier, denominator = offer.denominator, reward = amount,
            skillMultiplier=factor,skillGrade=skill and skill.grade or "Normal" }
        outputs[index], remaining, total = output, remaining - amount, total + amount
        if not best or output.rank &gt; best.rank then best, bestIndex = output, index end
    end
    local cursor = (session.cursor + count) % prompt.VOCABULARY_SIZE
    local nextDraft = build(cursor, session.sequence + 1, prompt.limit(profile, balance), balance, prompt, choose, profile)
    if not nextDraft then return false, "invalid_reward_roll" end
    -- Prepare all values before the synchronous, once-only debit-free payout/advance.
    profile.credits = math.min(balance.MAX_CREDITS, profile.credits + total)
    profile.lifetimeEarned=math.min(balance.MAX_LIFETIME_EARNED,(profile.lifetimeEarned or 0)+total)
    profile.batches = math.min(balance.MAX_CREDITS, profile.batches + 1)
    session.cursor, session.sequence, session.draft = cursor, nextDraft.id, nextDraft
    session.phaseAnchor=session.skillCheck
    session.skillCheck,session.skillAwards=nil,nil
    session.lastSkillClick=nil
    if not session.totals then
        session.totals = { earned = 0, prompts = 0, tokens = 0, special = 0, tiers = {0,0,0,0,0} }
        session.recent = {}
    end
    local totals = session.totals
    totals.earned, totals.prompts, totals.tokens = totals.earned + total, totals.prompts + 1, totals.tokens + count
    totals.skillBonus=(totals.skillBonus or 0)+skillBonus
    for _, output in ipairs(outputs) do
        totals.tiers[output.rank] = totals.tiers[output.rank] + 1
        if output.rank &gt; 1 then totals.special = totals.special + 1 end
    end
    Session.statistics(session, now)
    session.recent[#session.recent + 1] = { time = now, reward = total }
    return true, { id = draft.id, draftId = draft.id, tokens = count, startToken = draft.startToken,
        reward = total, skillBonus=skillBonus, outputToken = best.word, outputRarity = best.rarity,
        featured = best, featuredIndex = bestIndex, outputs = outputs }
end

function Session.reset(session)
    session.nextAutoSkillAt=nil
    session.cursor, session.draft, session.agentPace = 0, nil, nil -- Sequence survives reset.
    session.totals, session.recent = nil, nil
    session.skillCheck,session.skillAwards,session.lastSkillClick=nil,nil,nil -- Skill sequence survives.
    session.avatarItems,session.lastAvatarCollect=nil,nil -- Avatar sequence survives reset.
    session.visitorNextAt,session.visitorLastPoll=nil,nil
    session.fragmentReceipts,session.fragmentReceiptOrder=nil,nil
    session.phaseAnchor=nil
    session.autoReceipt,session.autoSequence,session.autoTime=nil,nil,nil
    session.agentWordsPerClick=nil
    session.streak,session.bestStreak,session.streakMultiplier=0,0,1
    session.streakExpiresAt=nil
    session.lastStreakActivity=nil
end

return Session
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000047">
        <Properties>
          <string name="Name">Protocol</string>
          <ProtectedString name="Source">--!nonstrict
local Protocol = {}
-- Only three upgrades are available in live play. Historical profile fields and
-- pure economy fixtures retain their old meaning, but retired commands reject.
local actions = { avatar_poll=true,craft_card=true,auto_skill=true,upgrade_sync=true,equip_card=true,unequip_card=true,prestige=true,buy_skill=true,prestige_sync=true,submit_prompt = true, add_layer = true, upgrade_compute = true,
    upgrade_tokens = true, collect_avatar = true, avatar_sync = true, sync = true, agent_type = true, agent_sync = true, skill_click = true, skill_sync = true }

function Protocol.validate(action, layerIndex, balance)
    if action=="analytics_pulse" then
        if type(layerIndex)~="table" or type(layerIndex.focused)~="boolean" then return false,"invalid_analytics" end
        local pages={CLI=true,Guide=true,Lab=true,Cards=true,Robux=true,Prestige=true,Tree=true,Tools=true,Start=true,Tutorial=true}
        if not pages[layerIndex.page] then return false,"invalid_analytics" end
        for _,key in ipairs({"requestId","button","enter"}) do
            local n=layerIndex[key]
            if type(n)~="number" or n~=n or n%1~=0 or n&lt;(key=="requestId" and 1 or 0) or n&gt;1000000000 then return false,"invalid_analytics" end
        end
        for key in pairs(layerIndex) do if key~="requestId" and key~="button" and key~="enter" and key~="focused" and key~="page" then return false,"invalid_analytics" end end
        return true
    end
    if action=="premium_buy" then
        if type(layerIndex)~="table" or (layerIndex.sku~="money_hour" and layerIndex.sku~="chips_hour" and layerIndex.sku~="agent" and layerIndex.sku~="forever")
            or type(layerIndex.requestId)~="number" or layerIndex.requestId~=layerIndex.requestId or layerIndex.requestId%1~=0
            or layerIndex.requestId&lt;1 or layerIndex.requestId&gt;balance.MAX_CREDITS then return false,"invalid_premium" end
        for key in pairs(layerIndex) do if key~="sku" and key~="requestId" then return false,"invalid_premium" end end
        return true
    elseif action=="premium_check" or action=="premium_redeem" or action=="tutorial_complete" then
        if type(layerIndex)~="table" or type(layerIndex.requestId)~="number" or layerIndex.requestId~=layerIndex.requestId
            or layerIndex.requestId%1~=0 or layerIndex.requestId&lt;1 or layerIndex.requestId&gt;balance.MAX_CREDITS then return false,"invalid_premium" end
        for key in pairs(layerIndex) do if key~="requestId" then return false,"invalid_premium" end end
        return true
    end
    if type(action) ~= "string" or #action &gt; 32 or not actions[action] then return false, "unknown_action" end
    if action=="upgrade_sync" or ((action=="upgrade_compute" or action=="upgrade_tokens" or action=="add_layer") and layerIndex~=nil) then
        if type(layerIndex)~="table" then return false,"invalid_purchase" end
        local fields=0
        for key,value in pairs(layerIndex) do
            if key=="requestId" then
                if type(value)~="number" or value~=value or value%1~=0 or value&lt;1 or value&gt;balance.MAX_CREDITS then return false,"invalid_purchase" end
            elseif key=="quantity" and action~="upgrade_sync" then
                if value~=1 and value~=5 and value~=10 and value~=25 and value~="max" then return false,"invalid_purchase" end
            else return false,"invalid_purchase" end
            fields=fields+1
        end
        if not layerIndex.requestId or fields~=(action=="upgrade_sync" and 1 or 2) then return false,"invalid_purchase" end
    elseif action=="avatar_poll" then
        if type(layerIndex)~="table" or type(layerIndex.requestId)~="number" or layerIndex.requestId~=layerIndex.requestId
            or layerIndex.requestId%1~=0 or layerIndex.requestId&lt;1 or layerIndex.requestId&gt;balance.MAX_CREDITS then return false,"invalid_avatar" end
        for key in pairs(layerIndex) do if key~="requestId" then return false,"invalid_avatar" end end
    elseif action=="craft_card" then
        if type(layerIndex)~="table" or type(layerIndex.cardId)~="string" or #layerIndex.cardId&lt;1 or #layerIndex.cardId&gt;32
            or not layerIndex.cardId:match("^[a-z_]+$") or type(layerIndex.requestId)~="number"
            or layerIndex.requestId~=layerIndex.requestId or layerIndex.requestId%1~=0 or layerIndex.requestId&lt;1
            or layerIndex.requestId&gt;balance.MAX_CREDITS then return false,"invalid_card" end
        for key in pairs(layerIndex) do if key~="cardId" and key~="requestId" then return false,"invalid_card" end end
    elseif action=="equip_card" or action=="unequip_card" then
        if type(layerIndex)~="table" then return false,"invalid_card" end
        local fields=0
        for key,value in pairs(layerIndex) do
            if key=="requestId" or key=="slotIndex" then
                if type(value)~="number" or value~=value or value%1~=0 or value&lt;1
                    or value&gt;(key=="slotIndex" and balance.MAX_HIDDEN_LAYERS or balance.MAX_CREDITS) then return false,"invalid_card" end
            elseif key=="cardId" and action=="equip_card" then
                if type(value)~="string" or #value&lt;1 or #value&gt;32 or not value:match("^[a-z_]+$") then return false,"invalid_card" end
            else return false,"invalid_card" end
            fields=fields+1
        end
        if not layerIndex.requestId or not layerIndex.slotIndex or (action=="equip_card" and not layerIndex.cardId)
            or fields~=(action=="equip_card" and 3 or 2) then return false,"invalid_card" end
    elseif action=="prestige" or action=="buy_skill" or action=="prestige_sync" then
        if type(layerIndex)~="table" then return false,"invalid_prestige" end
        local fields=0
        for key,value in pairs(layerIndex) do
            if key=="requestId" or (key=="draftId" and action=="prestige") then
                if type(value)~="number" or value~=value or value%1~=0 or value&lt;1 or value&gt;balance.MAX_CREDITS then return false,"invalid_prestige" end
            elseif key=="nodeId" and action=="buy_skill" then
                if type(value)~="string" or #value&lt;1 or #value&gt;32 or not value:match("^[a-z][a-z_0-9]*$") then return false,"invalid_prestige" end
            else return false,"invalid_prestige" end
            fields=fields+1
        end
        if fields~=(action=="prestige_sync" and 1 or 2) or not layerIndex.requestId
            or (action=="prestige" and not layerIndex.draftId) or (action=="buy_skill" and not layerIndex.nodeId) then return false,"invalid_prestige" end
    elseif action=="collect_avatar" or action=="avatar_sync" then
        if type(layerIndex)~="table" then return false,"invalid_avatar" end
        local fields=0
        for key,value in pairs(layerIndex) do
            if key~="id" or type(value)~="number" or value~=value or value%1~=0 or value&lt;1 or value&gt;balance.MAX_CREDITS then return false,"invalid_avatar" end
            fields=fields+1
        end
        if fields~=1 then return false,"invalid_avatar" end
    elseif action == "auto_skill" or action == "skill_click" or action=="skill_sync" or action=="agent_type" or action=="agent_sync" then
        local idKey=(action=="agent_type" or action=="agent_sync") and "requestId" or "checkId"
        if type(layerIndex)~="table" then return false,"invalid_skill" end
        local fields=0
        for key,value in pairs(layerIndex) do
            if key~="draftId" and key~=idKey and key~="tokenIndex" then return false,"invalid_skill" end
            local skillAction=action=="auto_skill" or action=="skill_click" or action=="skill_sync"
            local maximum=key=="tokenIndex" and (balance.PROMPT_MAX_TOKENS+(skillAction and 1 or 0)) or balance.MAX_CREDITS
            if type(value)~="number" or value~=value or value%1~=0 or value&lt;1 or value&gt;maximum then return false,"invalid_skill" end
            fields=fields+1
        end
        if fields~=3 then return false,"invalid_skill" end
    elseif action == "submit_prompt" then
        if type(layerIndex) ~= "table" then return false, "invalid_prompt" end
        local count = 0
        for key in pairs(layerIndex) do
            if key ~= "draftId" and key ~= "tokens" then return false, "invalid_prompt" end
            count = count + 1
        end
        for key, maximum in pairs({ draftId = balance.MAX_CREDITS, tokens = balance.PROMPT_MAX_TOKENS }) do
            local value = layerIndex[key]
            if type(value) ~= "number" or value ~= value or value % 1 ~= 0 or value &lt; 1 or value &gt; maximum then return false, "invalid_prompt" end
        end
        if count ~= 2 then return false, "invalid_prompt" end
    elseif layerIndex ~= nil then
        return false, "unexpected_payload"
    end
    return true
end

return Protocol
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000048">
        <Properties>
          <string name="Name">RateLimiter</string>
          <ProtectedString name="Source">--!nonstrict
local RateLimiter = {}

function RateLimiter.new(rate, capacity, now)
    return { rate = rate, capacity = capacity, tokens = capacity, last = now }
end

function RateLimiter.allow(bucket, now)
    if type(now) ~= "number" or now ~= now or now == math.huge or now &lt; bucket.last then return false end
    bucket.tokens = math.min(bucket.capacity, bucket.tokens + (now - bucket.last) * bucket.rate)
    bucket.last = now
    if bucket.tokens &lt; 1 then return false end
    bucket.tokens = bucket.tokens - 1
    return true
end

return RateLimiter
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000049">
        <Properties>
          <string name="Name">Simulation</string>
          <ProtectedString name="Source">--!nonstrict
local Simulation = {}

function Simulation.capacity(state)
    local total = 0
    for index = 2, #state.layerSizes - 1 do total = total + state.layerSizes[index] end
    return total
end

function Simulation.rate(state, balance)
    if state.batches == 0 then return 0 end
    local neurons = Simulation.capacity(state)
    local hiddenLayers = #state.layerSizes - 2
    return neurons * balance.CREDITS_PER_NEURON_SECOND
        * (1 + (hiddenLayers - 1) * balance.DEPTH_BONUS)
        * (1 + state.computeLevel * balance.COMPUTE_BONUS)
end

function Simulation.batchReward(state)
    return 1 + math.floor(Simulation.capacity(state) / 3)
end

function Simulation.advance(state, seconds, balance)
    if type(seconds) ~= "number" or seconds ~= seconds or seconds &lt; 0
        or seconds &gt; balance.MAX_SIMULATION_STEP then
        return false, "invalid_time"
    end
    state.credits = math.min(balance.MAX_CREDITS, state.credits + Simulation.rate(state, balance) * seconds)
    return true
end

return Simulation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000050">
        <Properties>
          <string name="Name">SkillCheck</string>
          <ProtectedString name="Source">--!nonstrict
-- Server-issued circular timing challenge. No client grade, clock or money input.
local Skill={DURATION=1.0,GOOD_WIDTH=72,GREAT_WIDTH=24,GRACE=0.12,STREAK_TIMEOUT=5}
Skill.STREAK_TIERS={{at=0,multiplier=1},{at=3,multiplier=1.25},{at=5,multiplier=1.5},
    {at=10,multiplier=2},{at=20,multiplier=3},{at=35,multiplier=4}}
Skill.MAX_STREAK=9999
local function finite(value)
    return type(value)=="number" and value==value and math.abs(value)&lt;math.huge
end
function Skill.streakFactor(count)
    for index=#Skill.STREAK_TIERS,1,-1 do
        local tier=Skill.STREAK_TIERS[index]
        if count&gt;=tier.at then return tier.multiplier end
    end
    return 1
end
function Skill.nextTier(count)
    for _,tier in ipairs(Skill.STREAK_TIERS) do if count&lt;tier.at then return tier end end
    return nil
end
function Skill.difficulty(count,settings)
    local progress=math.max(0,math.min(40,count))
    local initial=settings and settings.initialRps or 1/Skill.DURATION
    local growth=settings and settings.growth or 1.045
    return math.max(settings and settings.minDuration or 0.55,1/initial/growth^progress),Skill.GOOD_WIDTH-progress*1.1,Skill.GREAT_WIDTH-progress*0.4
end
function Skill.phase(check,now)
    return ((now-check.startsAt)/check.duration*360+(check.phaseOffset or 0))%360
end
function Skill.refreshDeadline(session,now)
    local timeout=session.skillSettings and session.skillSettings.streakTimeout or Skill.STREAK_TIMEOUT
    session.lastStreakActivity=now
    session.streakExpiresAt=(session.streak or 0)&gt;0 and timeout&gt;0 and now+timeout or nil
end
function Skill.retime(session,now)
    local check=session.skillCheck
    if not check then return end
    local phase=Skill.phase(check,now)
    local delay=math.max(0,check.startsAt-now)
    local duration,good,great=Skill.difficulty(session.streak or 0,session.skillSettings)
    check.startsAt,check.phaseOffset=now+delay,(phase+delay/duration*360)%360
    check.duration,check.goodWidth,check.greatWidth=duration,good,great
    check.streak=session.streak or 0
    check.grace=session.skillSettings and session.skillSettings.grace or Skill.GRACE
end
function Skill.expireStreak(session,now)
    if not finite(now) or not session.streakExpiresAt or now&lt;session.streakExpiresAt then return false end
    session.streak,session.streakMultiplier,session.streakExpiresAt=0,1,nil
    -- Random fragment visitors survive streak loss. Historical streak pickups do not.
    for index,item in pairs(session.avatarItems or {}) do if not item.familyId then session.avatarItems[index]=nil end end
    session.lastStreakActivity=nil
    Skill.retime(session,now)
    return true
end
function Skill.grade(check,now)
    if not finite(now) or now&lt;check.startsAt then return nil end
    local delta=(Skill.phase(check,now)-check.target+180)%360-180
    local good,great=check.goodWidth or Skill.GOOD_WIDTH,check.greatWidth or Skill.GREAT_WIDTH
    local grace=math.min((check.grace or Skill.GRACE)/check.duration*360,great*0.75)
    if delta&gt;=-great/2 and delta&lt;=great/2+grace then return "Great",2 end
    if delta&gt;=-good/2 and delta&lt;=good/2+grace then return "Good",1.5 end
    return "Normal",1
end
function Skill.ensure(session,draft,now,choose,delay)
    if not finite(now) then return nil end
    if session.skillCheck and session.skillCheck.draftId==draft.id then return session.skillCheck end
    local target=choose(70,290)
    if not finite(target) or target%1~=0 or target&lt;70 or target&gt;290 then return nil end
    session.skillSequence=(session.skillSequence or 0)+1
    local duration,good,great=Skill.difficulty(session.streak or 0,session.skillSettings)
    local check={id=session.skillSequence,draftId=draft.id,startsAt=now+(delay or (session.skillSettings and session.skillSettings.initialDelay) or 0.25),
        duration=duration,goodWidth=good,greatWidth=great,target=target,streak=session.streak or 0,
        grace=session.skillSettings and session.skillSettings.grace or Skill.GRACE}
    local previous=session.phaseAnchor or session.skillCheck
    check.phaseOffset=previous and (Skill.phase(previous,now)+(check.startsAt-now)/duration*360)%360 or 0
    session.phaseAnchor=nil
    session.skillCheck=check
    return check
end
function Skill.wordsPerClick(streak,base,c)
    c=finite(c) and math.max(1,math.min(100,c)) or 5
    return math.max(1,math.min(4,base or 1))*(math.floor(math.max(0,math.min(Skill.MAX_STREAK,streak))/c)+1)
end
function Skill.click(session,draft,payload,now,_speed,choose)
    local check=session.skillCheck
    if not draft or payload.draftId~=draft.id or not check or payload.checkId~=check.id then return false,"stale_skill" end
    if type(payload.tokenIndex)~="number" or payload.tokenIndex%1~=0 or payload.tokenIndex&lt;1
        or payload.tokenIndex&gt;#draft.offers+1 then return false,"invalid_skill" end
    local full=payload.tokenIndex==#draft.offers+1
    if full then
        -- Only a completely server-awarded context can use the no-word check.
        -- Edits keep awards immutable; this never rewrites an existing word.
        for index=1,#draft.offers do
            if not (session.skillAwards and session.skillAwards[index]) then return false,"invalid_skill" end
        end
    end
    local grade,precision=Skill.grade(check,now)
    if not grade then return false,"skill_not_ready" end
    local streak=session.streak or 0
    if grade=="Normal" then streak=0
    else streak=math.min(session.streakCap or Skill.MAX_STREAK,streak+1) end
    local streakMultiplier=Skill.streakFactor(streak)
    -- Prepare the next challenge before mutating results; invalid randomness is atomic.
    local prepared={skillSequence=session.skillSequence,streak=streak,phaseAnchor=check,skillSettings=session.skillSettings}
    local nextCheck=Skill.ensure(prepared,draft,now,choose,session.skillSettings and session.skillSettings.skillCooldown or 0)
    if not nextCheck then return false,"invalid_skill" end
    -- A fresh challenge changes streak only. Agent generation owns all word
    -- awards; timing checks must never reserve or modify a token's reward.
    session.streak,session.streakMultiplier=streak,streakMultiplier
    Skill.refreshDeadline(session,now)
    session.bestStreak=math.max(session.bestStreak or 0,streak)
    session.lastSkillClick={draftId=draft.id,checkId=check.id,tokenIndex=payload.tokenIndex,
        grade=grade,multiplier=precision*streakMultiplier,streak=streak,streakMultiplier=streakMultiplier,
        reused=false,wordCount=0,
        streakBroken=grade=="Normal" and (check.streak or 0)&gt;0}
    session.skillCheck,session.skillSequence=nextCheck,prepared.skillSequence
    return true,session.lastSkillClick
end
-- Automation is a distinct server operation, never a fabricated human grade.
-- One step per two seconds, no accumulated attempts, no tokens or collectible rolls.
function Skill.auto(session,draft,payload,now,cap,interval,choose)
    local check=session.skillCheck
    if not finite(now) or not finite(cap) or cap&lt;1 then return false,"auto_locked" end
    if not draft or not check or payload.draftId~=draft.id or payload.checkId~=check.id then return false,"stale_skill" end
    if type(payload.tokenIndex)~="number" or payload.tokenIndex%1~=0 or payload.tokenIndex&lt;1
        or payload.tokenIndex&gt;#draft.offers+1 then return false,"invalid_skill" end
    if payload.tokenIndex==#draft.offers+1 then
        for index=1,#draft.offers do if not (session.skillAwards and session.skillAwards[index]) then return false,"invalid_skill" end end
    end
    if now&lt;check.startsAt or now&lt;(session.nextAutoSkillAt or 0) then return false,"skill_not_ready" end
    if (session.streak or 0)&gt;cap then return false,"auto_cap" end
    local streak=math.min(cap,(session.streak or 0)+1)
    local prepared={skillSequence=session.skillSequence,streak=streak,phaseAnchor=check,skillSettings=session.skillSettings}
    local nextCheck=Skill.ensure(prepared,draft,now,choose,0)
    if not nextCheck then return false,"invalid_skill" end
    session.streak,session.streakMultiplier=streak,Skill.streakFactor(streak)
    session.bestStreak=math.max(session.bestStreak or 0,streak)
    session.nextAutoSkillAt=now+interval
    Skill.refreshDeadline(session,now)
    session.lastSkillClick={draftId=draft.id,checkId=check.id,tokenIndex=payload.tokenIndex,
        grade="Auto",automatic=true,multiplier=session.streakMultiplier,streak=streak,
        streakMultiplier=session.streakMultiplier,reused=false,wordCount=0,streakBroken=false}
    session.skillCheck,session.skillSequence=nextCheck,prepared.skillSequence
    return true,session.lastSkillClick
end
function Skill.view(session)
    local check=session.skillCheck
    if not check then return nil end
    local copy={draftId=check.draftId,id=check.id,startsAt=check.startsAt,duration=check.duration,
        phaseOffset=check.phaseOffset,initialRps=session.skillSettings and session.skillSettings.initialRps or 1/Skill.DURATION,
        growth=session.skillSettings and session.skillSettings.growth or 1.045,target=check.target,goodWidth=check.goodWidth,greatWidth=check.greatWidth,
        streak=session.streak or 0,bestStreak=session.bestStreak or 0,nextAutoSkillAt=session.nextAutoSkillAt,streakCap=session.streakCap,
        streakMultiplier=session.streakMultiplier or 1,awards={}}
    for index=1,128 do
        local award=session.skillAwards and session.skillAwards[index]
        if award then copy.awards[#copy.awards+1]={tokenIndex=index,grade=award.grade,multiplier=award.multiplier,
            precisionMultiplier=award.precisionMultiplier,streakMultiplier=award.streakMultiplier,streak=award.streak} end
    end
    if session.lastSkillClick then
        copy.lastClick={}
        for key,value in pairs(session.lastSkillClick) do copy.lastClick[key]=value end
    end
    return copy
end
return Skill
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000051">
        <Properties>
          <string name="Name">SkillTreeLayout</string>
          <ProtectedString name="Source">--!nonstrict
-- Original radial map and passive stepped hexagon geometry. No services/timers.
local Layout={nodeWidth=240,nodeHeight=208,padding=48,columnStep=280,rowStep=240}
local positions={
    boot={5,5},tokens={4,5},agents={4,4},focus={5,4},cache={4,6},swarm={3,4},context={6,6},
    focus10={6,3},core={5,6},focus15={6,2},fortune={3,5},overclock={3,3},memory={6,7},
    focus20={7,2},fortune2={2,5},swarm2={2,4},memory2={6,8},focus25={7,1},mastery={5,7},
    focus30={8,1},focus35={8,0},focus40={9,0},focus50={10,0},luck={6,5},luck2={7,5},luck3={8,5},luck4={9,5},
    cash1={1,5},cash2={0,5},cash3={0,4},cash4={0,3},speed1={2,3},speed2={1,3},speed3={1,2},speed4={1,1},
    luck5={10,5},luck6={11,5},luck7={11,6},luck8={11,7},chip4={7,8},chip5={7,9},chip6={8,9},chip7={8,10},
    swarm3={2,6},swarm4={1,6},swarm5={1,7},swarm6={0,7},focus60={10,1},focus70={10,2},focus80={11,2},focus100={11,3},
    fusion={3,1},magnet={2,9},singularity={5,10},
}
function Layout.position(id)
    local p=assert(positions[id],"Missing skill tree position: "..tostring(id))
    return {x=Layout.padding+p[1]*Layout.columnStep,y=Layout.padding+p[2]*Layout.rowStep,
        width=Layout.nodeWidth,height=Layout.nodeHeight}
end
function Layout.bounds(nodes)
    local width,height=0,0
    for _,node in ipairs(nodes) do
        local p=Layout.position(node.id)
        width=math.max(width,p.x+p.width+Layout.padding);height=math.max(height,p.y+p.height+Layout.padding)
    end
    return {width=width,height=height}
end
function Layout.hex(inset)
    inset=inset or 0
    local width,height=Layout.nodeWidth-2*inset,Layout.nodeHeight-2*inset
    local rects={}
    for y=0,height-1,8 do
        local h=math.min(8,height-y)
        local cut=math.floor((math.abs(y+h/2-height/2)/(height/2)*width/4)/4+.5)*4
        rects[#rects+1]={x=inset+cut,y=inset+y,width=width-2*cut,height=h}
    end
    return rects
end
function Layout.link(parent,child)
    local a,b=Layout.position(parent),Layout.position(child)
    local ax,ay=a.x+a.width/2,a.y+a.height/2
    local bx,by=b.x+b.width/2,b.y+b.height/2
    local dx,dy=bx-ax,by-ay
    local angle=math.atan2 and math.atan2(dy,dx) or math.atan(dy,dx)
    return {x=math.floor((ax+bx)/2),y=math.floor((ay+by)/2),
        length=math.ceil(math.sqrt(dx*dx+dy*dy)),angle=angle*180/math.pi}
end
function Layout.family(node)
    if node.id=="boot" or node.id=="core" or node.id=="mastery" or node.id=="fusion" or node.id=="singularity" then return "core" end
    if node.luck then return "luck" end
    if node.auto then return "focus" end
    if node.chip then return "memory" end
    if node.collect then return "swarm" end
    if node.speed then return "agents" end
    return "tokens"
end
return Layout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000052">
        <Properties>
          <string name="Name">Soundtrack</string>
          <ProtectedString name="Source">--!nonstrict
-- Original mellow lounge loop and connected A-minor pentatonic click phrase.
local Music={TONE="rbxasset://sounds/volume_slider.ogg",TAP="rbxasset://sounds/action_jump_land.mp3",
    VORTEX="rbxasset://sounds/action_falling.ogg"}
local phrase={69,72,74,76,79,76,74,72}
function Music.pitch(note) return 2^((note-69)/12) end
Music.BPM=88
local chords={{60,64,67,71},{57,60,64,67},{62,65,69,72},{55,59,62,65}}
local melody={{76,79,83,79},{76,72,69,72},{77,81,84,81},{74,77,79,74}}
function Music.transport() return {step=-1,elapsed=0} end
function Music.tier(streak,c)
    c=type(c)=="number" and c==c and math.max(1,math.min(100,c)) or 5
    return math.max(0,math.min(4,math.floor((streak or 0)/c)))
end
function Music.tempo(tier) return ({88,112,132,152,176})[math.max(0,math.min(4,tier or 0))+1] end
function Music.advance(clock,dt,tier,scale)
    if dt~=dt or dt&lt;0 then return {} end
    if clock.step&lt;0 then clock.step=0;return {0} end
    clock.elapsed=clock.elapsed+math.min(0.1,dt)
    local steps={};local interval=60/Music.tempo(tier)/4/(scale or 1)
    while clock.elapsed&gt;=interval and #steps&lt;2 do
        clock.elapsed=clock.elapsed-interval;clock.step=(clock.step+1)%128
        steps[#steps+1]=clock.step
    end
    if clock.elapsed&gt;=interval then clock.elapsed=clock.elapsed%interval end
    return steps
end
function Music.rockEvents(step,tier)
    local roots={45,48,50,43};local root=roots[math.floor(step/16)%4+1]
    local beat=step%16;local notes={}
    local function tone(key,gain,duration)
        notes[#notes+1]={asset=Music.TONE,pitch=Music.pitch(key),gain=gain,duration=duration,attack=0.008}
    end
    local stride=tier==1 and 4 or tier&lt;4 and 2 or 1
    if beat%stride==0 then
        tone(root,0.055,0.28-tier*0.035);tone(root+7,0.04,0.28-tier*0.035)
        if tier&lt;4 then tone(root+12,0.025,0.24) end
    end
    if beat%4==0 then tone(root-12,0.065,0.25) end
    if beat%4==2 or (tier&gt;=3 and beat%2==1) then
        local riff={0,0,7,10,0,12,10,7}
        tone(root+24+riff[math.floor(beat/2)%8+1],0.04,0.18)
    end
    local snare=beat==4 or beat==12
    if snare or beat%4==0 or (tier&gt;=2 and beat%2==1) then
        notes[#notes+1]={asset=Music.TAP,pitch=snare and 1.5 or beat%4==0 and 0.65 or 3,
            gain=snare and 0.06 or beat%4==0 and 0.045 or 0.018,duration=0.07,attack=0.003}
    end
    return notes
end
function Music.events(step,tier)
    if tier and tier&gt;0 then return Music.rockEvents(step,tier) end
    local bar=math.floor(step/16);local beat=step%16
    local index=math.floor(bar/2)%4+1
    local chord=chords[index];local notes={}
    local function tone(key,gain,duration,attack)
        notes[#notes+1]={asset=Music.TONE,pitch=Music.pitch(key),gain=gain,duration=duration,attack=attack}
    end
    if beat==0 then for _,key in ipairs(chord) do tone(key,0.035,1.6,0.04) end end
    if beat==0 or beat==8 then tone(chord[1]-12,0.07,0.6,0.015) end
    if beat%4==2 then
        local position=math.floor(beat/4)+1
        if bar%2==1 then position=5-position end
        tone(melody[index][position],0.045,0.42,0.012)
    end
    if beat==4 or beat==12 then
        notes[#notes+1]={asset=Music.TAP,pitch=2.8,gain=0.012,duration=0.045,attack=0.005}
    end
    return notes
end
function Music.envelope(age,duration,attack)
    if age&lt;0 or age&gt;=duration then return 0 end
    local release=math.min(0.22,duration*0.55)
    return math.min(1,age/math.max(0.003,attack),(duration-age)/release)
end
local uiSounds={
    skill={asset=Music.TAP,pitches={1.15,1.4,1.7,1.3},gain=0.07,duration=0.065},
    shop={asset=Music.TAP,pitches={0.8,0.95,1.1,0.9},gain=0.065,duration=0.08},
    navigate={asset=Music.TONE,keys={72,76,79,74},gain=0.045,duration=0.095},
    back={asset=Music.TONE,keys={69,67,64,62},gain=0.04,duration=0.09},
    select={asset=Music.TAP,pitches={2.1,2.35,2.6,2.25},gain=0.045,duration=0.045},
    sell={asset=Music.TAP,pitches={0.65,0.8,0.75,0.7},gain=0.07,duration=0.09},
    collect={asset=Music.TONE,keys={81,84,88,86},gain=0.055,duration=0.12},
    confirm={asset=Music.TONE,keys={76,79,81,84},gain=0.06,duration=0.14},
}
-- Four deterministic variations per gesture; never consume the game's RNG.
function Music.uiCue(kind,variation)
    local voice=uiSounds[kind] or uiSounds.navigate
    local index=(variation-1)%4+1
    local pitch=voice.pitches and voice.pitches[index] or Music.pitch(voice.keys[index])
    local notes={{asset=voice.asset,pitch=pitch,gain=voice.gain,duration=voice.duration,attack=0.003}}
    if kind=="shop" then
        local key=({72,76,79,74})[index]
        notes[2]={asset=Music.TONE,pitch=Music.pitch(key),risePitch=Music.pitch(key+12),riseAt=0.035,
            gain=0.04,duration=0.135,attack=0.005}
    elseif kind=="confirm" then
        notes[2]={asset=Music.TONE,pitch=pitch*1.5,gain=0.025,duration=0.18,attack=0.008}
    end
    return notes
end
function Music.cue(grade,streak)
    if grade~="Good" and grade~="Great" then return {} end
    local index=(math.max(1,math.floor(streak or 1))-1)%#phrase+1
    local pitch=Music.pitch(phrase[index])
    local notes={{asset=Music.TONE,pitch=pitch,gain=0.12,duration=0.65,attack=0.012}}
    if grade=="Great" then
        notes[2]={asset=Music.TONE,pitch=pitch*2,gain=0.045,duration=0.7,attack=0.018}
    end
    return notes
end
-- Short rising coin chimes in the click phrase's A-minor palette. Higher
-- rarities have a brighter interval and a quiet harmony, never extra rewards.
function Music.coinCue(rank)
    rank=type(rank)=="number" and rank==rank and math.max(1,math.min(5,math.floor(rank))) or 1
    local low=({81,84,88,91,93})[rank]
    local high=({88,93,96,100,105})[rank]
    local notes={{asset=Music.TONE,pitch=Music.pitch(low),risePitch=Music.pitch(high),
        riseAt=0.025,gain=0.05,duration=0.09+rank*0.018,attack=0.003}}
    if rank&gt;1 then
        notes[2]={asset=Music.TONE,pitch=Music.pitch(low-12),risePitch=Music.pitch(high-12),
            riseAt=0.04,gain=0.018,duration=0.12+rank*0.02,attack=0.008}
    end
    return notes
end
-- Original suction wash from the same built-in sources; no downloaded track.
-- Three voices fit inside the existing six-voice effects pool.
function Music.vortexCue(reduced)
    local gain=(reduced and .3 or 1)*2.25
    return {
        {asset=Music.VORTEX,pitch=.55,gain=.095*gain,attack=.08,sustain=true,vortex=1},
        {asset=Music.TONE,pitch=.42,gain=.055*gain,attack=.1,sustain=true,vortex=2},
        {asset=Music.TONE,pitch=.63,gain=.025*gain,attack=.12,sustain=true,vortex=3},
    }
end
function Music.vortexMix(age,close,hold,open,channel)
    local total=close+hold+open
    local p=math.max(0,math.min(1,age/close))
    local reveal=math.max(0,math.min(1,(age-close-hold)/open))
    local attack=math.min(1,math.max(0,age)/math.min(.24,close/2))
    local tail=age&gt;=total and 0 or age&gt;close+hold and (1-reveal)^2 or 1
    local swirl=.82+.18*math.sin(age*9+(channel or 1)*2.1)
    local base=({.85,.62,.92})[channel or 1]
    return attack*tail*swirl*(.55+.45*p),base*(1-.72*p)+reveal*.9
end
return Music
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000053">
        <Properties>
          <string name="Name">State</string>
          <ProtectedString name="Source">--!nonstrict
local State = {}
State.METRIC_CAP=1000000000000000
State.METRIC_COUNTERS={"sessions","onlineSeconds","focusedSecondsReported","sellButtonReported","sellEnterReported",
    "sales","saleRejected","tokensSold","moneyEarned","skillGood","skillGreat","skillMiss","skillRejected",
    "autoChecks","visitors","fragmentsCollected","prestiges","tutorialDismissed"}
State.METRIC_MAPS={"upgradePurchases","upgradeLevels","skills","crafts","robuxPrompts","robuxDelivered","robuxCanceled","robuxUnavailable"}
function State.newAnalytics()
    local result={recent={},firstRobux=false}
    for _,key in ipairs(State.METRIC_COUNTERS) do result[key]=0 end
    for _,key in ipairs(State.METRIC_MAPS) do result[key]={} end
    return result
end
function State.copyAnalytics(source)
    local result=State.newAnalytics()
    if not source then return result end
    for _,key in ipairs(State.METRIC_COUNTERS) do result[key]=source[key] end
    for _,key in ipairs(State.METRIC_MAPS) do for id,value in pairs(source[key] or {}) do result[key][id]=value end end
    for _,entry in ipairs(source.recent or {}) do
        local copy={};for key,value in pairs(entry) do copy[key]=value end;result.recent[#result.recent+1]=copy
    end
    if source.firstRobux then result.firstRobux={};for key,value in pairs(source.firstRobux) do result.firstRobux[key]=value end end
    return result
end

function State.isFinite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function integer(value, low, high)
    return State.isFinite(value) and value % 1 == 0 and value &gt;= low and value &lt;= high
end

function State.new(balance)
    local layers = {}
    for index, count in ipairs(balance.STARTING_LAYERS) do layers[index] = count end
    layers[1] = balance.EMBEDDING_DIM
    local owned,deck,fragments={ember=true},{},{}
    for _,family in ipairs(balance.AGENT_FAMILIES) do fragments[family.id]=0 end
    for index=1,balance.MAX_HIDDEN_LAYERS do deck[index]=false end
    return { schemaVersion = balance.SCHEMA_VERSION, credits = balance.STARTING_CREDITS,
        layerSizes = layers, computeLevel = 0, tokenLevel = 0, typingLevel = 0, clickLevel = 0, divisorLevel = 0, batches = 0, milestones = {},tutorialDone=false,analytics=State.newAnalytics(),
        chips=0,prestigeClaimed=0,prestigeCount=0,lifetimeEarned=0,prestigeSkills={},legacyPrestigeSkills={},cardOwned=owned,cardDeck=deck,
        fragments=fragments,cardCrafted={},premium={moneyUntil=0,chipsUntil=0,forever=false,agentCredits=0,bonusChips=0,receipts={}} }
end

function State.copy(state,gameplayOnly)
    local result = { schemaVersion = state.schemaVersion, credits = state.credits, layerSizes = {},
        computeLevel = state.computeLevel, tokenLevel = state.tokenLevel, typingLevel = state.typingLevel, clickLevel = state.clickLevel, divisorLevel = state.divisorLevel,
        batches = state.batches, milestones = {},tutorialDone=state.tutorialDone,analytics=not gameplayOnly and State.copyAnalytics(state.analytics) or nil,chips=state.chips,prestigeClaimed=state.prestigeClaimed,
        prestigeCount=state.prestigeCount,lifetimeEarned=state.lifetimeEarned,prestigeSkills={},legacyPrestigeSkills={},cardOwned={},cardDeck={},fragments={},cardCrafted={},
        premium={moneyUntil=0,chipsUntil=0,forever=false,agentCredits=0,bonusChips=0,receipts={}} }
    for index, count in ipairs(state.layerSizes) do result.layerSizes[index] = count end
    for name, completed in pairs(state.milestones) do result.milestones[name] = completed end
    for id,owned in pairs(state.prestigeSkills or {}) do result.prestigeSkills[id]=owned end
    for id,owned in pairs(state.legacyPrestigeSkills or {}) do result.legacyPrestigeSkills[id]=owned end
    for id,owned in pairs(state.cardOwned or {}) do result.cardOwned[id]=owned end
    for index,value in ipairs(state.cardDeck or {}) do result.cardDeck[index]=value end
    for id,value in pairs(state.fragments or {}) do result.fragments[id]=value end
    for id,value in pairs(state.cardCrafted or {}) do result.cardCrafted[id]=value end
    if state.premium then
        for _,key in ipairs({"moneyUntil","chipsUntil","forever","agentCredits","bonusChips"}) do result.premium[key]=state.premium[key] end
        for id,sku in pairs(state.premium.receipts or {}) do result.premium.receipts[id]=sku end
    end
    return result
end

local function readLayers(layers, balance, inputWidth)
    if type(layers) ~= "table" then return nil, "invalid_layers" end
    local count, result = #layers, {}
    if count &lt; 3 or count &gt; balance.MAX_HIDDEN_LAYERS + 2 then return nil, "invalid_layers" end
    for key, value in pairs(layers) do
        if not integer(key, 1, count) or not integer(value, 1, balance.MAX_NEURONS_PER_LAYER) then
            return nil, "invalid_layers"
        end
    end
    for index = 1, count do
        if not integer(layers[index], 1, balance.MAX_NEURONS_PER_LAYER) then return nil, "invalid_layers" end
        result[index] = layers[index]
    end
    if result[1] ~= inputWidth
        or result[count] ~= balance.STARTING_LAYERS[#balance.STARTING_LAYERS] then return nil, "invalid_endpoints" end
    return result
end

-- Allowlist current data and explicitly migrate known historical schemas.
-- Never downgrade a schema, reset invalid data, or mutate the stored source.
function State.fromStored(data, balance)
    if type(data) ~= "table" or (data.schemaVersion ~= balance.SCHEMA_VERSION
        and data.schemaVersion ~= 1 and data.schemaVersion ~= 2 and data.schemaVersion ~= 3
        and data.schemaVersion ~= 4 and data.schemaVersion ~= 5 and data.schemaVersion ~= 6 and data.schemaVersion ~= 7 and data.schemaVersion ~= 8 and data.schemaVersion ~= 9 and data.schemaVersion ~= 10 and data.schemaVersion ~= 11 and data.schemaVersion ~= 12 and data.schemaVersion ~= 13 and data.schemaVersion ~= 14 and data.schemaVersion ~= 15 and data.schemaVersion ~= 16 and data.schemaVersion ~= 17) then return nil, "unsupported_schema" end
    if not State.isFinite(data.credits) or data.credits &lt; 0 or data.credits &gt; balance.MAX_CREDITS then
        return nil, "invalid_credits"
    end
    local layers, reason
    if data.schemaVersion == 4 then
        if not integer(data.blockCount, 1, balance.MAX_HIDDEN_LAYERS) then return nil, "invalid_blocks" end
        if not integer(data.embDim, 2, balance.MAX_NEURONS_PER_LAYER) then return nil, "invalid_emb_dim" end
        layers = { balance.STARTING_LAYERS[1] }
        for _ = 1, data.blockCount do layers[#layers + 1] = data.embDim end
        layers[#layers + 1] = balance.STARTING_LAYERS[#balance.STARTING_LAYERS]
    else
        layers, reason = readLayers(data.layerSizes, balance,
            data.schemaVersion &gt;= 6 and balance.EMBEDDING_DIM or 2)
        if not layers then return nil, reason end
    end
    layers[1] = balance.EMBEDDING_DIM
    if not integer(data.computeLevel, 0, data.schemaVersion&lt;12 and balance.LEGACY_MAX_COMPUTE_LEVEL or balance.MAX_SAFE_COMPUTE_LEVEL) then return nil, "invalid_compute" end
    local tokenLevel = data.schemaVersion == 1 and 0 or data.tokenLevel
    if not integer(tokenLevel, 0, data.schemaVersion&lt;12 and 15 or balance.MAX_TOKEN_LEVEL) then return nil, "invalid_token_level" end
    local typingLevel = data.schemaVersion &lt; 7 and 0 or data.typingLevel
    if not integer(typingLevel, 0, balance.MAX_TYPING_LEVEL) then return nil, "invalid_typing_level" end
    local clickLevel=data.schemaVersion&lt;8 and 0 or data.clickLevel
    if not integer(clickLevel,0,balance.MAX_CLICK_LEVEL) then return nil,"invalid_click_level" end
    local divisorLevel=data.schemaVersion&lt;9 and 0 or data.divisorLevel
    if not integer(divisorLevel,0,balance.MAX_DIVISOR_LEVEL) then return nil,"invalid_divisor_level" end
    local refund = 0
    if data.schemaVersion&lt;12 then
        -- Frozen 0.59 prices. Refund removed context levels once on migration.
        for level=balance.MAX_TOKEN_LEVEL,tokenLevel-1 do refund=refund+math.floor(2*1.5^(level*.25)) end
        tokenLevel=math.min(tokenLevel,balance.MAX_TOKEN_LEVEL)
    end
    if data.schemaVersion == 3 or data.schemaVersion == 4 then
        if not integer(data.attentionHeads, 1, 8) then return nil, "invalid_attention_heads" end
        -- Historical 0.4/0.5 head prices, frozen independently of future balance.
        -- Current-schema reads cannot refund again, even if obsolete fields exist.
        for level = 0, data.attentionHeads - 2 do refund = refund + math.floor(4 * 1.6 ^ (level * 0.25)) end
    end
    if not integer(data.batches, 0, balance.MAX_CREDITS) then return nil, "invalid_batches" end
    if type(data.milestones) ~= "table" then return nil, "invalid_milestones" end
    local result = State.new(balance)
    if data.schemaVersion&gt;=18 then
        local a=data.analytics
        if type(a)~="table" then return nil,"invalid_analytics" end
        local allowed={recent=true,firstRobux=true}
        for _,key in ipairs(State.METRIC_COUNTERS) do
            allowed[key]=true
            if not State.isFinite(a[key]) or a[key]&lt;0 or a[key]&gt;State.METRIC_CAP or (key~="moneyEarned" and a[key]%1~=0) then return nil,"invalid_analytics" end
        end
        local catalog={upgradePurchases={upgrade_compute=true,add_layer=true,upgrade_tokens=true},upgradeLevels={upgrade_compute=true,add_layer=true,upgrade_tokens=true},skills={},crafts={}}
        for _,node in ipairs(balance.PRESTIGE_NODES) do catalog.skills[node.id]=true end
        for _,card in ipairs(balance.AGENT_CARDS) do catalog.crafts[card.id]=true end
        for _,key in ipairs(State.METRIC_MAPS) do
            allowed[key]=true
            if type(a[key])~="table" then return nil,"invalid_analytics" end
            local ids=catalog[key] or {money_hour=true,chips_hour=true,agent=true,forever=true}
            for id,value in pairs(a[key]) do if not ids[id] or not integer(value,0,State.METRIC_CAP) then return nil,"invalid_analytics" end end
        end
        for key in pairs(a) do if not allowed[key] then return nil,"invalid_analytics" end end
        local eventNames={upgrade=true,skill_buy=true,craft=true,prestige=true,robux_prompt=true,robux_delivered=true,robux_cancel=true,robux_unavailable=true,pass_owned=true,tutorial=true,session_end=true}
        local function event(entry)
            if type(entry)~="table" or not eventNames[entry.event] or type(entry.kind)~="string" or #entry.kind&gt;80
                or not entry.kind:match("^[%w_%-]+$") or type(entry.stage)~="string" or #entry.stage&gt;64 then return false end
            local fields={event=true,kind=true,stage=true}
            for _,key in ipairs({"at","sessionSeconds","onlineSeconds","sessionNumber","agents","computeLevel","context","prestiges","money","chips","amount"}) do
                fields[key]=true
                if not State.isFinite(entry[key]) or entry[key]&lt;0 or entry[key]&gt;State.METRIC_CAP then return false end
            end
            for key in pairs(entry) do if not fields[key] then return false end end
            return true
        end
        if type(a.recent)~="table" or #a.recent&gt;24 then return nil,"invalid_analytics" end
        local count=0
        for index,entry in pairs(a.recent) do if not integer(index,1,#a.recent) or not event(entry) then return nil,"invalid_analytics" end;count=count+1 end
        if count~=#a.recent or (a.firstRobux~=false and (not event(a.firstRobux) or (a.firstRobux.event~="robux_delivered" and a.firstRobux.event~="pass_owned"))) then return nil,"invalid_analytics" end
        result.analytics=State.copyAnalytics(a)
    end
    if data.schemaVersion&gt;=17 then
        if type(data.tutorialDone)~="boolean" then return nil,"invalid_tutorial" end
        result.tutorialDone=data.tutorialDone
    end
    if data.schemaVersion&gt;=16 then
        local p=data.premium
        if type(p)~="table" or not integer(p.moneyUntil,0,4102444800) or not integer(p.chipsUntil,0,4102444800)
            or type(p.forever)~="boolean" or not integer(p.agentCredits,0,1000000) or not integer(p.bonusChips,0,balance.MAX_PRESTIGE_CHIPS)
            or type(p.receipts)~="table" then return nil,"invalid_premium" end
        local count=0
        for id,sku in pairs(p.receipts) do
            if type(id)~="string" or #id&lt;1 or #id&gt;50 or not id:match("^[%w_%-]+$")
                or (sku~="money_hour" and sku~="chips_hour" and sku~="agent") then return nil,"invalid_receipt" end
            count=count+1;if count&gt;256 then return nil,"too_many_pending_receipts" end
        end
        for key in pairs(p) do
            if key~="moneyUntil" and key~="chipsUntil" and key~="forever" and key~="agentCredits" and key~="bonusChips" and key~="receipts" then return nil,"invalid_premium" end
        end
        for _,key in ipairs({"moneyUntil","chipsUntil","forever","agentCredits","bonusChips"}) do result.premium[key]=p[key] end
        for id,sku in pairs(p.receipts) do result.premium.receipts[id]=sku end
    end
    local cardCatalog,craftedSpent={},0
    for _,card in ipairs(balance.AGENT_CARDS) do
        if data.schemaVersion&gt;=card.introducedSchema then cardCatalog[card.id]=card end
    end
    if data.schemaVersion&gt;=15 then
        if type(data.fragments)~="table" or type(data.cardCrafted)~="table" or type(data.cardOwned)~="table" then return nil,"invalid_crafting" end
        local families,entries={},0
        for _,family in ipairs(balance.AGENT_FAMILIES) do families[family.id]=true end
        for id,value in pairs(data.fragments) do
            if not families[id] or not integer(value,0,balance.MAX_FRAGMENTS) then return nil,"invalid_fragments" end
            result.fragments[id]=value;entries=entries+1
        end
        if entries~=#balance.AGENT_FAMILIES then return nil,"invalid_fragments" end
        for id,owned in pairs(data.cardCrafted) do
            local card=cardCatalog[id]
            if not card or owned~=true or data.cardOwned[id]~=true then return nil,"invalid_crafted_card" end
            result.cardCrafted[id]=true;craftedSpent=craftedSpent+balance.CRAFT_TIERS[card.rank].chips
        end
        for id,owned in pairs(data.cardOwned) do
            local card=cardCatalog[id]
            if card and card.rank&gt;1 and not result.cardCrafted[id] then return nil,"unpaid_crafted_card" end
        end
    end
    if data.schemaVersion&gt;=10 then
        local chipCap=data.schemaVersion&lt;14 and 10000 or data.schemaVersion&lt;15 and 20000 or balance.MAX_PRESTIGE_CHIPS*(data.schemaVersion&gt;=16 and 2 or 1)
        local earnedCap=data.schemaVersion&lt;14 and 1000000000000000 or data.schemaVersion&lt;15 and 8000000000000000 or balance.MAX_LIFETIME_EARNED
        if not State.isFinite(data.lifetimeEarned) or data.lifetimeEarned&lt;0 or data.lifetimeEarned&gt;earnedCap
            or not integer(data.chips,0,chipCap)
            or not integer(data.prestigeClaimed,0,chipCap)
            or not integer(data.prestigeCount,0,data.prestigeClaimed)
            or (data.prestigeClaimed&gt;0 and data.prestigeCount==0)
            or result.premium.bonusChips&gt;data.prestigeClaimed-result.premium.bonusChips
            or data.prestigeCount&gt;data.prestigeClaimed-result.premium.bonusChips
            or data.prestigeClaimed-result.premium.bonusChips&gt;balance.MAX_PRESTIGE_CHIPS
            or data.lifetimeEarned&lt;balance.PRESTIGE_BASE*(data.prestigeClaimed-result.premium.bonusChips)^3
            or type(data.prestigeSkills)~="table" then return nil,"invalid_prestige" end
        local nodes,spent={},0
        for _,node in ipairs(balance.PRESTIGE_NODES) do
            if data.schemaVersion&gt;=(node.introducedSchema or (node.icon and 12 or 10)) then nodes[node.id]=node end
        end
        if data.schemaVersion&gt;=13 then
            if type(data.legacyPrestigeSkills)~="table" then return nil,"invalid_legacy_skills" end
            for id,owned in pairs(data.legacyPrestigeSkills) do
                if not nodes[id] or not nodes[id].legacyCost or owned~=true or data.prestigeSkills[id]~=true then return nil,"invalid_legacy_skills" end
                result.legacyPrestigeSkills[id]=true
            end
        end
        for id,owned in pairs(data.prestigeSkills) do
            local node=nodes[id]
            if not node or owned~=true then return nil,"invalid_prestige_skill" end
            for _,parent in ipairs(node.parents) do if data.prestigeSkills[parent]~=true then return nil,"invalid_prestige_parent" end end
            local legacy=data.schemaVersion&lt;13 or result.legacyPrestigeSkills[id]==true
            spent=spent+(legacy and node.legacyCost or node.cost);result.prestigeSkills[id]=true
            if legacy then result.legacyPrestigeSkills[id]=true end
        end
        if data.chips+spent+craftedSpent~=data.prestigeClaimed then return nil,"invalid_chip_balance" end
        result.chips,result.prestigeClaimed,result.prestigeCount=data.chips,data.prestigeClaimed,data.prestigeCount
        result.lifetimeEarned=data.lifetimeEarned
    end
    result.credits = math.min(balance.MAX_CREDITS, data.credits + refund)
    result.layerSizes, result.computeLevel, result.tokenLevel, result.batches = layers, data.computeLevel, tokenLevel, data.batches
    result.typingLevel = typingLevel
    result.clickLevel = clickLevel
    result.divisorLevel = divisorLevel
    if data.schemaVersion&gt;=11 then
        if type(data.cardOwned)~="table" or type(data.cardDeck)~="table" then return nil,"invalid_cards" end
        local catalog,used=cardCatalog,{}
        result.cardOwned,result.cardDeck={},{}
        for id,owned in pairs(data.cardOwned) do
            if not catalog[id] or owned~=true then return nil,"invalid_owned_card" end
            result.cardOwned[id]=true
        end
        local entries=0
        for index in pairs(data.cardDeck) do
            if not integer(index,1,balance.MAX_HIDDEN_LAYERS) then return nil,"invalid_deck" end
            entries=entries+1
        end
        if entries~=balance.MAX_HIDDEN_LAYERS then return nil,"invalid_deck" end
        for index=1,balance.MAX_HIDDEN_LAYERS do
            local id=data.cardDeck[index]
            if id~=false then
                if type(id)~="string" or not result.cardOwned[id] or used[id] or index&gt;#layers-2 then return nil,"invalid_deck_card" end
                used[id]=true
            end
            result.cardDeck[index]=id
        end
    else
        -- Historical schemas1..10 received the original nine Common starters.
        for _,card in ipairs(balance.AGENT_CARDS) do if card.rank==1 then result.cardOwned[card.id]=true end end
    end
    for _, name in ipairs({ "joined", "first_batch", "first_neuron", "first_compute", "first_layer" }) do
        if data.milestones[name] == true then result.milestones[name] = true end
    end
    return result
end

-- Wire snapshots omit server-only behavior history. This is not a storage loader.
function State.fromSnapshot(data,balance)
    if type(data)~="table" then return nil,"invalid_snapshot" end
    local gameplay={};for key,value in pairs(data) do gameplay[key]=value end
    gameplay.analytics=State.newAnalytics()
    return State.fromStored(gameplay,balance)
end
return State
