        self.title.Position,self.title.Size=UDim2.fromOffset(12,8),UDim2.new(1,-120,0,34)
        self.title.TextSize=self.frame.AbsoluteSize.X&lt;400 and 16 or 22;self.title.TextXAlignment=Enum.TextXAlignment.Left;self.title.TextColor3=c.amber
